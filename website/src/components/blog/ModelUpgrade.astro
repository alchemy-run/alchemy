---
/**
 * `<ModelUpgrade />` — a deploy upgrading a Worker's deployed Domain layout
 * in place. One Durable Object class, before and after: the deploy renames it
 * after its model and tags the Worker with the new Domain version, and the
 * instances (the dots) stay where they are.
 */
---

<figure class="mu not-content" id="mu" aria-label="A deploy renaming a Durable Object class in place while its data stays">
  <div class="mu-stage">
    <div class="mu-card">
      <span class="mu-label">Worker tag</span>
      <span class="mu-diff mu-tag">
        <span class="mu-del">no Domain version</span>
        <span class="mu-add">alchemy:domain:v0</span>
      </span>
      <span class="mu-label">Durable Object class</span>
      <span class="mu-diff mu-name">
        <span class="mu-del">AccountAggregate</span>
        <span class="mu-add">Bank.AccountAggregate</span>
      </span>
      <span class="mu-dots">{Array.from({ length: 24 }, () => <i />)}</span>
      <span class="mu-note">every account stays where it is</span>
    </div>
    <span class="mu-deploy">alchemy deploy</span>
  </div>
  <figcaption class="mu-cap">
    The deploy renames the class in place and tags the Worker. The accounts never move.
  </figcaption>
</figure>

<style is:global>
  .mu {
    margin: 2rem 0;
    padding: 18px 14px 12px;
    font: 14px/1.5 var(--alc-font-sans);
    color: var(--alc-fg-1);
    background: var(--alc-bg-elev-1);
    border: 1px solid var(--alc-hairline-2);
    border-radius: 12px;
  }
  .mu-stage {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }
  .mu-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    width: min(100%, 420px);
    padding: 16px;
    border: 1px solid var(--alc-hairline-3);
    border-radius: 12px;
  }
  .mu-label {
    margin-bottom: -6px;
    font-size: 11.5px;
    color: var(--alc-fg-3);
  }
  .mu-diff {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    min-width: 0;
    font-family: var(--alc-font-mono);
  }
  .mu-tag {
    font-size: 13px;
    font-weight: 600;
  }
  .mu-name {
    font-size: 18px;
    font-weight: 700;
  }
  .mu-del,
  .mu-add {
    padding: 1px 12px 1px 28px;
    border-radius: 6px;
    position: relative;
    white-space: nowrap;
    transition:
      background 0.5s ease,
      color 0.5s ease,
      max-height 0.6s ease,
      opacity 0.6s ease,
      text-decoration-color 0.5s ease;
  }
  .mu-del::before,
  .mu-add::before {
    position: absolute;
    left: 10px;
    opacity: 0;
    transition: opacity 0.5s ease;
  }
  .mu-del::before {
    content: "-";
  }
  .mu-add::before {
    content: "+";
  }
  .mu-del {
    color: var(--alc-fg-1);
    text-decoration: line-through transparent;
  }
  .mu-add {
    margin-top: 3px;
    opacity: 0;
    color: #7fb069;
    background: color-mix(in srgb, #7fb069 16%, transparent);
  }
  .mu.after .mu-del {
    color: #e5735f;
    background: color-mix(in srgb, #e5735f 14%, transparent);
    text-decoration-color: currentColor;
  }
  .mu.after .mu-add {
    opacity: 1;
  }
  .mu.after .mu-del::before,
  .mu.after .mu-add::before {
    opacity: 1;
  }
  .mu-dots {
    display: grid;
    grid-template-columns: repeat(12, 10px);
    gap: 5px;
  }
  .mu-dots i {
    width: 10px;
    height: 10px;
    border-radius: 3px;
    background: #e3b341;
  }
  .mu.after .mu-dots i {
    animation: mukeep 1s ease;
  }
  @keyframes mukeep {
    40% {
      box-shadow: 0 0 0 3px color-mix(in srgb, #e3b341 35%, transparent);
    }
  }
  .mu-note {
    font-size: 12.5px;
    color: var(--alc-fg-3);
  }
  .mu-deploy {
    padding: 3px 10px;
    font: 600 12px var(--alc-font-mono);
    border: 1px solid var(--alc-accent);
    border-radius: 999px;
    color: var(--alc-accent-text);
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .mu.deploying .mu-deploy {
    opacity: 1;
  }
  .mu.reset * {
    transition: none !important;
    animation: none !important;
  }
  .mu-cap {
    margin-top: 12px;
    font-size: 13px;
    color: var(--alc-fg-3);
    text-align: center;
  }
</style>

<script>
  const root = document.getElementById("mu");
  if (root) {
    const reduced = () => matchMedia("(prefers-reduced-motion: reduce)").matches;
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
    root.classList.add("after");
    const play = async () => {
      if (reduced()) return;
      for (;;) {
        root.classList.add("reset");
        root.classList.remove("after", "deploying");
        void root.getBoundingClientRect();
        root.classList.remove("reset");
        await sleep(1800);
        root.classList.add("deploying");
        await sleep(900);
        root.classList.add("after");
        await sleep(1200);
        root.classList.remove("deploying");
        await sleep(3200);
      }
    };
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          void play();
        }
      },
      { threshold: 0.4 },
    );
    io.observe(root);
  }
</script>
