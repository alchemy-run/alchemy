---
/**
 * Sidebar override: identical to Starlight's default Sidebar, but rendering
 * entries through our `SidebarList` (which adds group-heading icons), with
 * the mobile product switcher on top (the tab bar is desktop-only).
 */
import MobileMenuFooter from "@astrojs/starlight/components/MobileMenuFooter.astro";
import SidebarPersister from "@astrojs/starlight/components/SidebarPersister.astro";
import MobileTabSwitcher from "./MobileTabSwitcher.astro";
import SidebarList from "./SidebarList.astro";

const { sidebar } = Astro.locals.starlightRoute;
---

<MobileTabSwitcher />

<SidebarPersister>
  <SidebarList sublist={sidebar} />
</SidebarPersister>

<div class="md:sl-hidden">
  <MobileMenuFooter />
</div>

<script>
  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;
    const link = event.target.closest<HTMLAnchorElement>("a[data-reference-group]");
    const group = link?.closest("details");
    if (!link || !group || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    event.preventDefault();
    group.open = true;
    window.location.assign(link.href);
    if (link.pathname.replace(/\/$/, "") === window.location.pathname.replace(/\/$/, "")) {
      document.getElementById("_top")?.scrollIntoView({ behavior: "instant" });
    }
  });

  function updateReferenceSelection() {
    const currentPath = window.location.pathname.replace(/\/$/, "");
    // Override persisted collapse state when arriving at a service's own page.
    for (const link of document.querySelectorAll<HTMLAnchorElement>("a[data-reference-group]")) {
      if (link.pathname.replace(/\/$/, "") === currentPath) {
        const group = link.closest("details");
        if (group) group.open = true;
      }
    }
    const links = [...document.querySelectorAll<HTMLAnchorElement>("a[data-reference-link]")];
    // Example headings extend the resource's anchor; prefer the longest match.
    const selected = links.filter((link) => {
      const target = new URL(link.href);
      return target.pathname.replace(/\/$/, "") === currentPath &&
        (target.hash === window.location.hash || window.location.hash.startsWith(`${target.hash}-`));
    }).sort((a, b) => b.hash.length - a.hash.length)[0];
    for (const link of links) {
      if (link === selected) {
        link.setAttribute("aria-current", "location");
        let parent = link.parentElement;
        while (parent) {
          if (parent instanceof HTMLDetailsElement) parent.open = true;
          parent = parent.parentElement;
        }
      } else {
        link.removeAttribute("aria-current");
      }
    }
  }
  updateReferenceSelection();
  window.addEventListener("hashchange", updateReferenceSelection);
  document.addEventListener("astro:page-load", updateReferenceSelection);
</script>
