---
import { AWS_COLOR, CF_COLOR } from "./diagrams/_colors";
import CodeBlock from "./CodeBlock.astro";
import DiagramR2 from "./diagrams/DiagramR2.astro";
import DiagramKV from "./diagrams/DiagramKV.astro";
import DiagramD1 from "./diagrams/DiagramD1.astro";
import DiagramRoom from "./diagrams/DiagramRoom.astro";
import DiagramContainer from "./diagrams/DiagramContainer.astro";
import DiagramLambdaDynamo from "./diagrams/DiagramLambdaDynamo.astro";
import DiagramLambdaS3 from "./diagrams/DiagramLambdaS3.astro";

const SRC_R2 = `import { Bucket } from "./Bucket.ts";

export default class Api extends Cloudflare.Worker<Api>()(
  "Api",
  Effect.gen(function* () {
    const bucket = yield* Cloudflare.R2Bucket.bind(Bucket);
    return { fetch: (req) => bucket.get(req.url) };
  }),
) {}
`;

const SRC_KV = `import { KV } from "./KV.ts";

export default class Api extends Cloudflare.Worker<Api>()(
  "Api",
  Effect.gen(function* () {
    const kv = yield* Cloudflare.KVNamespace.bind(KV);
    return { fetch: (req) => kv.get(req.url) };
  }),
) {}
`;

const SRC_D1 = `import { DB } from "./DB.ts";

export default class Api extends Cloudflare.Worker<Api>()(
  "Api",
  Effect.gen(function* () {
    const db = yield* Cloudflare.D1Connection.bind(DB);
    return {
      fetch: () => db.prepare("SELECT * FROM users").all(),
    };
  }),
) {}
`;

const SRC_DO = `import Room from "./Room.ts";

export default class Api extends Cloudflare.Worker<Api>()(
  "Api",
  Effect.gen(function* () {
    const rooms = yield* Room;
    return { fetch: (req) => rooms.getByName(req.url).fetch(req) };
  }),
) {}
`;

const SRC_CONTAINER = `import { Sandbox } from "./Sandbox.ts";

export default class Agent extends Cloudflare.DurableObjectNamespace<Agent>()(
  "Agents",
  Effect.gen(function* () {
    const sandbox = yield* Cloudflare.Container.bind(Sandbox);
    const container = yield* Cloudflare.start(sandbox);
    return { fetch: (req) => container.fetch(req) };
  }),
) {}
`;

const SRC_LAMBDA_DYNAMO = `import { Jobs } from "./Jobs.ts";

export default class JobFunction extends AWS.Lambda.Function<JobFunction>()(
  "JobFunction",
  Effect.gen(function* () {
    const get = yield* AWS.DynamoDB.GetItem.bind(Jobs);
    const put = yield* AWS.DynamoDB.PutItem.bind(Jobs);
    return { fetch: (req) => get({ Key: { id: { S: req.url } } }) };
  }),
) {}
`;

const SRC_LAMBDA_S3 = `import { Photos } from "./Photos.ts";

export default class ImageFn extends AWS.Lambda.Function<ImageFn>()(
  "ImageFn",
  Effect.gen(function* () {
    const get = yield* AWS.S3.GetObject.bind(Photos);
    const put = yield* AWS.S3.PutObject.bind(Photos);
    return { fetch: (req) => get({ Key: req.url }) };
  }),
) {}
`;

const tabs = [
  { k: "r2", provider: "cf" as const, label: "R2", filename: "src/Api.ts",
    caption: "Bind an R2 bucket inside a Worker — typed client, deploy-time wiring.",
    src: SRC_R2 },
  { k: "kv", provider: "cf" as const, label: "KV", filename: "src/Api.ts",
    caption: "Same .bind() shape — get and put from one typed client.",
    src: SRC_KV },
  { k: "d1", provider: "cf" as const, label: "D1", filename: "src/Api.ts",
    caption: "A serverless SQL database, prepared statements, all typed.",
    src: SRC_D1 },
  { k: "do", provider: "cf" as const, label: "Durable Object", filename: "src/Api.ts",
    caption: "Yield the Room namespace, then route by name — one DO instance per id.",
    src: SRC_DO },
  { k: "ctr", provider: "cf" as const, label: "Container", filename: "src/Agent.ts",
    caption: "Bind a Container from a Durable Object, start it, speak HTTP to its ports.",
    src: SRC_CONTAINER },
  { k: "ddb", provider: "aws" as const, label: "Lambda + DynamoDB", filename: "src/JobFunction.ts",
    caption: "Each .bind() compiles to exactly one IAM action — no policy JSON to maintain.",
    src: SRC_LAMBDA_DYNAMO },
  { k: "s3", provider: "aws" as const, label: "Lambda + S3", filename: "src/ImageFn.ts",
    caption: "Same shape, S3. Two binds, two actions, zero hand-written policy.",
    src: SRC_LAMBDA_S3 },
];

const providerColor = (p: "cf" | "aws") => (p === "aws" ? AWS_COLOR : CF_COLOR);
const tint = (hex: string, a: number) => {
  const n = parseInt(hex.slice(1), 16);
  const r = (n >> 16) & 255;
  const g = (n >> 8) & 255;
  const b = n & 255;
  return `rgba(${r},${g},${b},${a})`;
};
---

<div class="feature-tabs" data-feature-tabs>
  <div class="feature-tabs__nav" role="tablist">
    {tabs.map((t, i) => {
      const c = providerColor(t.provider);
      const prev = tabs[i - 1];
      const groupBreak = prev && prev.provider !== t.provider;
      const isFirst = i === 0;
      return (
        <>
          {groupBreak && <span aria-hidden class="feature-tabs__divider" />}
          <button
            type="button"
            class="feature-tabs__btn"
            role="tab"
            data-tab-key={t.k}
            data-active={isFirst}
            aria-selected={isFirst}
            style={`--tab-color:${c};--tab-tint:${tint(c, 0.18)};`}
          >
            <span aria-hidden class="feature-tabs__dot" style={`background:${c};`}></span>
            {t.label}
          </button>
        </>
      );
    })}
  </div>

  <div class="feature-tabs__caption" data-tab-caption>
    {tabs[0]!.caption}
  </div>

  <div class="feature-tabs__panels">
    {tabs.map((t, i) => (
      <div
        class="feature-tabs__panel feature-tab-grid"
        role="tabpanel"
        data-tab-panel={t.k}
        data-active={i === 0}
        data-caption={t.caption}
      >
        <CodeBlock filename={t.filename} code={t.src} compact />
        <div class="feature-tab-diagram">
          <div class="feature-tab-diagram__inner">
            {t.k === "r2" && <DiagramR2 />}
            {t.k === "kv" && <DiagramKV />}
            {t.k === "d1" && <DiagramD1 />}
            {t.k === "do" && <DiagramRoom />}
            {t.k === "ctr" && <DiagramContainer />}
            {t.k === "ddb" && <DiagramLambdaDynamo />}
            {t.k === "s3" && <DiagramLambdaS3 />}
          </div>
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  .feature-tabs__btn[data-active="true"] {
    border-color: var(--tab-color);
    background: var(--alc-bg-code);
    color: var(--alc-fg-invert);
    box-shadow: 0 0 0 2px var(--tab-tint);
  }
  .feature-tab-diagram__inner {
    background: var(--alc-bg-elev-1);
    border: 1px solid var(--alc-hairline);
    border-radius: 10px;
    padding: 14px 12px;
    width: 100%;
  }
</style>

<script>
  // Tiny progressive-enhancement script: toggle data-active on the matching
  // panel and button, swap the caption. No framework needed.
  for (const root of document.querySelectorAll<HTMLElement>("[data-feature-tabs]")) {
    const buttons = root.querySelectorAll<HTMLButtonElement>("[data-tab-key]");
    const panels = root.querySelectorAll<HTMLElement>("[data-tab-panel]");
    const caption = root.querySelector<HTMLElement>("[data-tab-caption]");
    for (const btn of buttons) {
      btn.addEventListener("click", () => {
        const k = btn.dataset.tabKey;
        for (const b of buttons) {
          const on = b.dataset.tabKey === k;
          b.dataset.active = String(on);
          b.setAttribute("aria-selected", String(on));
        }
        for (const p of panels) {
          const on = p.dataset.tabPanel === k;
          p.dataset.active = String(on);
          if (on && caption && p.dataset.caption) {
            caption.textContent = p.dataset.caption;
          }
        }
      });
    }
  }
</script>
