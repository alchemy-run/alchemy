---
import { CF_COLOR } from "./_colors";

interface Props {
  topLabel?: string;
  bottomLabel?: string;
  height?: number;
  color?: string;
}

const { topLabel, bottomLabel, height = 30, color = CF_COLOR } = Astro.props;
---

<div class="diag-bidir">
  {topLabel && <div class="diag-bidir__label">{topLabel}</div>}
  <svg width="28" height={height} viewBox={`0 0 28 ${height}`}>
    <path d={`M9 ${height - 1} L9 5`} stroke={color} stroke-width="1.4" />
    <path d="M6 7 L9 1 L12 7" stroke={color} stroke-width="1.4" fill="none" stroke-linecap="round" stroke-linejoin="round" />
    <path d={`M19 1 L19 ${height - 5}`} stroke={color} stroke-width="1.4" />
    <path
      d={`M16 ${height - 7} L19 ${height - 1} L22 ${height - 7}`}
      stroke={color}
      stroke-width="1.4"
      fill="none"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
  {bottomLabel && <div class="diag-bidir__label">{bottomLabel}</div>}
</div>

<style>
  .diag-bidir {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: 2px 0;
  }
  .diag-bidir__label {
    font-family: var(--alc-font-mono);
    font-size: 10px;
    color: var(--alc-fg-3);
  }
</style>
