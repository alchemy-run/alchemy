---
import { AWS_COLOR } from "./_colors";
import DiagWrap from "./DiagWrap.astro";
import DiagNode from "./DiagNode.astro";
import DiagArrow from "./DiagArrow.astro";
import DiagPolicy from "./DiagPolicy.astro";
import IconLambda from "./icons/IconLambda.astro";
import IconDynamoDB from "./icons/IconDynamoDB.astro";
---

<DiagWrap>
  <DiagNode label="JobFunction" sub="AWS.Lambda" accent color={AWS_COLOR}>
    <IconLambda slot="icon" color={AWS_COLOR} />
  </DiagNode>
  <DiagArrow label=".bind(table) ×2" color={AWS_COLOR} />
  <DiagPolicy actions={["dynamodb:GetItem", "dynamodb:PutItem"]} color={AWS_COLOR} />
  <DiagArrow color={AWS_COLOR} />
  <DiagNode label="JobsTable" sub="DynamoDB.Table">
    <IconDynamoDB slot="icon" color={AWS_COLOR} />
  </DiagNode>
</DiagWrap>
