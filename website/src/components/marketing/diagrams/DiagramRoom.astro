---
import { CF_COLOR } from "./_colors";
import DiagWrap from "./DiagWrap.astro";
import DiagFanOut from "./DiagFanOut.astro";
import DiagNode from "./DiagNode.astro";
import IconWorker from "./icons/IconWorker.astro";
import IconDO from "./icons/IconDO.astro";
---

<DiagWrap>
  <DiagFanOut count={3} label="rooms.getByName(id)" color={CF_COLOR}>
    <DiagNode slot="parent" label="Api" sub="Worker" accent color={CF_COLOR}>
      <IconWorker slot="icon" color={CF_COLOR} />
    </DiagNode>
    <div>
      <DiagNode label="Room" sub="#alpha">
        <IconDO slot="icon" color={CF_COLOR} />
      </DiagNode>
    </div>
    <div>
      <DiagNode label="Room" sub="#beta">
        <IconDO slot="icon" color={CF_COLOR} />
      </DiagNode>
    </div>
    <div>
      <DiagNode label="Room" sub="#gamma">
        <IconDO slot="icon" color={CF_COLOR} />
      </DiagNode>
    </div>
  </DiagFanOut>
</DiagWrap>
