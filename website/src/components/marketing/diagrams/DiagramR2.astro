---
import { CF_COLOR } from "./_colors";
import DiagWrap from "./DiagWrap.astro";
import DiagNode from "./DiagNode.astro";
import DiagArrow from "./DiagArrow.astro";
import IconClient from "./icons/IconClient.astro";
import IconWorker from "./icons/IconWorker.astro";
import IconR2 from "./icons/IconR2.astro";
---

<DiagWrap>
  <DiagNode label="Client" sub="HTTP" dim>
    <IconClient slot="icon" />
  </DiagNode>
  <DiagArrow label="GET /key" color={CF_COLOR} />
  <DiagNode label="Api" sub="Worker" accent color={CF_COLOR}>
    <IconWorker slot="icon" color={CF_COLOR} />
  </DiagNode>
  <DiagArrow label=".bind(Bucket)" color={CF_COLOR} />
  <DiagNode label="Bucket" sub="R2">
    <IconR2 slot="icon" color={CF_COLOR} />
  </DiagNode>
</DiagWrap>
