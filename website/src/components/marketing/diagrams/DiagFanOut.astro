---
import { CF_COLOR } from "./_colors";

interface Props {
  label?: string;
  count: number;
  color?: string;
}

const { label, count, color = CF_COLOR } = Astro.props;
const startPct = 100 / (count * 2);
---

<div class="diag-fan">
  <slot name="parent" />
  {label && <div class="diag-fan__label">{label}</div>}
  <div class="diag-fan__bus">
    <div class="diag-fan__stem" style={`border-color:${color};`}></div>
    <div
      class="diag-fan__rail"
      style={`left:${startPct}%;right:${startPct}%;border-color:${color};`}
    ></div>
    {Array.from({ length: count }).map((_, i) => {
      const x = `${startPct * (2 * i + 1)}%`;
      return (
        <>
          <div class="diag-fan__drop" style={`left:${x};border-color:${color};`}></div>
          <svg width="8" height="6" class="diag-fan__head" style={`left:${x};`}>
            <path d="M0 0 L4 6 L8 0" stroke={color} stroke-width="1.4" fill="none" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </>
      );
    })}
  </div>
  <div class="diag-fan__row" style={`grid-template-columns:repeat(${count}, 1fr);`}>
    <slot />
  </div>
</div>

<style>
  .diag-fan {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .diag-fan__label {
    margin-top: 4px;
    font-family: var(--alc-font-mono);
    font-size: 10px;
    color: var(--alc-fg-3);
  }
  .diag-fan__bus {
    position: relative;
    height: 28px;
    width: 100%;
    margin-top: 2px;
  }
  .diag-fan__stem {
    position: absolute;
    left: 50%;
    top: 0;
    height: 9px;
    width: 0;
    border-left-width: 1.4px;
    border-left-style: solid;
    transform: translateX(-0.5px);
  }
  .diag-fan__rail {
    position: absolute;
    top: 8px;
    border-top-width: 1.4px;
    border-top-style: solid;
  }
  .diag-fan__drop {
    position: absolute;
    top: 9px;
    height: 14px;
    width: 0;
    border-left-width: 1.4px;
    border-left-style: solid;
    transform: translateX(-0.5px);
  }
  .diag-fan__head {
    position: absolute;
    top: 22px;
    transform: translateX(-4px);
  }
  .diag-fan__row {
    display: grid;
    gap: 6px;
    width: 100%;
  }
  .diag-fan__row > * {
    display: flex;
    justify-content: center;
  }
</style>
