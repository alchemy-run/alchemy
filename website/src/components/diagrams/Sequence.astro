---
/**
 * `<Sequence />` — what happens, in what order, between whom. Participants
 * across the top, time running down, one arrow per message. Use it for a
 * protocol: a message received, hidden, then deleted or redelivered; a
 * certificate ordered, challenged and issued; a request passing through layers.
 *
 *   <Sequence
 *     actors={[
 *       { id: "api", label: "Api", type: "producer" },
 *       { id: "queue", label: "Jobs", type: "SQS Queue" },
 *     ]}
 *     steps={[
 *       { from: "api", to: "queue", label: "SendMessage" },
 *       { note: "hidden for 30s", over: "queue" },
 *       { divider: "if the Worker crashes" },
 *       { from: "queue", to: "queue", label: "visible again" },
 *     ]}
 *   />
 *
 * A step is a message (`from`, `to`, `label`, `dashed` for a reply or an event
 * delivered later), a `note` over one or two actors, or a `divider` across all.
 */
import "./diagram.css";

interface Actor {
  id: string;
  label: string;
  type?: string;
  tone?: "default" | "accent";
}
type Step =
  | { from: string; to: string; label?: string; dashed?: boolean; tone?: "warn" }
  | { note: string; over: string | [string, string] }
  | { divider: string };
interface Props {
  actors: Actor[];
  steps: Step[];
  caption?: string;
}

const { actors, steps, caption } = Astro.props as Props;

// Boxes widen to fit the longest label or type line, and columns keep a gap between them.
const BOX_W = Math.max(132, ...actors.map((a) => Math.max(a.label.length * 8, (a.type ?? "").length * 6.6) + 20));
const COL = BOX_W + 36;
const BOX_H = 46;
const ROW = 40;
const PAD = 16;
const col = new Map(actors.map((a, i) => [a.id, PAD + BOX_W / 2 + i * COL]));
const W = PAD * 2 + BOX_W + (actors.length - 1) * COL;

let y = PAD + BOX_H + 26;
const drawn = steps.map((s) => {
  const top = y;
  if ("divider" in s) {
    y += ROW;
    return { kind: "divider" as const, y: top + 8, text: s.divider };
  }
  if ("note" in s) {
    const ids = Array.isArray(s.over) ? s.over : [s.over, s.over];
    const xs = ids.map((id) => col.get(id)!);
    const mid = (Math.min(...xs) + Math.max(...xs)) / 2;
    const half = Math.max((Math.max(...xs) - Math.min(...xs)) / 2 + 58, (s.note.length * 6.6) / 2 + 12);
    const x0 = mid - half;
    const x1 = mid + half;
    y += ROW - 4;
    return { kind: "note" as const, x: x0, w: x1 - x0, y: top - 12, text: s.note };
  }
  const x1 = col.get(s.from)!;
  const x2 = col.get(s.to)!;
  if (x1 === x2) {
    y += ROW + 8;
    return { kind: "self" as const, x: x1, y: top, ...s };
  }
  y += ROW;
  return { kind: "msg" as const, x1, x2, y: top, ...s };
});
const H = y + 4;
// Notes and loop labels can reach past the outer lifelines; widen the view to fit them.
const extents = drawn.flatMap((d) =>
  d.kind === "note" ? [d.x, d.x + d.w] : d.kind === "self" ? [d.x + 42 + (d.label?.length ?? 0) * 6.6 + 8] : [],
);
const VX = Math.min(0, ...extents.map((x) => x - 4));
const VW = Math.max(W, ...extents.map((x) => x + 4)) - VX;
---

<figure class="alc-fig not-content" data-nosnippet>
  <svg class="alc-fig__svg" viewBox={`${VX} 0 ${VW} ${H}`} style={`max-width: ${Math.round(VW * 1.15)}px`} role="img" aria-label={caption ?? "Sequence"}>
    <defs>
      <marker id="alc-seq-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--alc-accent)" />
      </marker>
      <marker id="alc-seq-arrow-warn" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--alc-warn)" />
      </marker>
    </defs>
    {
      actors.map((a) => {
        const x = col.get(a.id)!;
        return (
          <g>
            <line x1={x} y1={PAD + BOX_H} x2={x} y2={H - 4} class="alc-fig__line alc-fig__line--muted alc-fig__line--dashed" />
            <rect x={x - BOX_W / 2} y={PAD} width={BOX_W} height={BOX_H} rx="8" class:list={["alc-fig__box", a.tone === "accent" && "alc-fig__box--accent"]} />
            <text x={x} y={PAD + (a.type ? 20 : 28)} text-anchor="middle" class="alc-fig__label">{a.label}</text>
            {a.type && <text x={x} y={PAD + 36} text-anchor="middle" class="alc-fig__type">{a.type}</text>}
          </g>
        );
      })
    }
    {
      drawn.map((d) => {
        if (d.kind === "divider")
          return (
            <g>
              <line x1={VX + PAD} y1={d.y} x2={VX + VW - PAD} y2={d.y} class="alc-fig__line alc-fig__line--muted alc-fig__line--dashed" />
              <rect x={PAD} y={d.y - 9} width={d.text.length * 6.7 + 12} height="18" rx="4" class="alc-fig__label-bg" />
              <text x={PAD + 6} y={d.y + 4} class="alc-fig__strong">{d.text}</text>
            </g>
          );
        if (d.kind === "note")
          return (
            <g>
              <rect x={d.x} y={d.y} width={d.w} height="24" rx="5" class="alc-fig__box alc-fig__box--muted" style="fill: var(--alc-bg-elev-1)" />
              <text x={d.x + d.w / 2} y={d.y + 16} text-anchor="middle" class="alc-fig__small">{d.text}</text>
            </g>
          );
        const warn = d.tone === "warn";
        const cls = ["alc-fig__line", d.dashed && "alc-fig__line--dashed", warn && "alc-fig__line--warn"];
        const marker = warn ? "url(#alc-seq-arrow-warn)" : "url(#alc-seq-arrow)";
        if (d.kind === "self")
          return (
            <g>
              <path d={`M ${d.x} ${d.y} h 34 v 22 h -28`} class:list={cls} marker-end={marker} />
              {d.label && <text x={d.x + 42} y={d.y + 15} class="alc-fig__small">{d.label}</text>}
            </g>
          );
        const dir = d.x2 > d.x1 ? 1 : -1;
        return (
          <g>
            <line x1={d.x1} y1={d.y} x2={d.x2 - dir * 6} y2={d.y} class:list={cls} marker-end={marker} />
            {d.label && (
              <>
                <rect x={(d.x1 + d.x2) / 2 - d.label.length * 3.3 - 4} y={d.y - 19} width={d.label.length * 6.6 + 8} height="15" rx="3" class="alc-fig__label-bg" />
                <text x={(d.x1 + d.x2) / 2} y={d.y - 7} text-anchor="middle" class="alc-fig__small">{d.label}</text>
              </>
            )}
          </g>
        );
      })
    }
  </svg>
  {caption && <figcaption class="alc-fig__caption">{caption}</figcaption>}
</figure>
