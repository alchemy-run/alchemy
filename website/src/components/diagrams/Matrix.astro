---
/**
 * `<Matrix />` — what each combination gives you. Rows and columns are two
 * conditions, each cell is the outcome, filled when it's a yes. Several panels
 * sit side by side for small multiples: the same matrix within one account and
 * across two.
 *
 *   <Matrix
 *     panels={[{
 *       title: "Across accounts",
 *       rowsLabel: "identity policy",
 *       colsLabel: "bucket policy",
 *       cols: ["allows", "doesn't"],
 *       rows: [
 *         { label: "allows", cells: [{ text: "allowed", yes: true }, { text: "denied" }] },
 *         { label: "doesn't", cells: [{ text: "denied" }, { text: "denied" }] },
 *       ],
 *     }]}
 *   />
 */
import "./diagram.css";

interface Panel {
  title?: string;
  rowsLabel?: string;
  colsLabel?: string;
  cols: string[];
  rows: { label: string; cells: { text: string; yes?: boolean }[] }[];
}
interface Props {
  panels: Panel[];
  caption?: string;
}

const { panels, caption } = Astro.props as Props;
---

<figure class="alc-fig not-content" data-nosnippet>
  <div class="alc-mx">
    {
      panels.map((p) => (
        <div class="alc-mx__panel">
          {p.title && <div class="alc-mx__title">{p.title}</div>}
          {p.colsLabel && <div class="alc-mx__axis alc-mx__axis--cols">{p.colsLabel} →</div>}
          <div class="alc-mx__grid" style={`grid-template-columns: max-content repeat(${p.cols.length}, minmax(5.5rem, 1fr))`}>
            <div class="alc-mx__axis">{p.rowsLabel && `${p.rowsLabel} ↓`}</div>
            {p.cols.map((c) => <div class="alc-mx__head">{c}</div>)}
            {p.rows.map((r) => (
              <>
                <div class="alc-mx__row">{r.label}</div>
                {r.cells.map((cell) => (
                  <div class:list={["alc-mx__cell", cell.yes ? "alc-mx__cell--yes" : "alc-mx__cell--no"]}>{cell.text}</div>
                ))}
              </>
            ))}
          </div>
        </div>
      ))
    }
  </div>
  {caption && <figcaption class="alc-fig__caption">{caption}</figcaption>}
</figure>

<style>
  .alc-mx {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.5rem 2.5rem;
    font-family: var(--alc-font-mono);
  }
  .alc-mx__title {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--alc-fg-1);
    margin-bottom: 0.5rem;
    text-align: center;
  }
  .alc-mx__grid {
    display: grid;
    gap: 0.375rem;
  }
  .alc-mx__axis {
    font-size: 10.5px;
    color: var(--alc-fg-3);
    align-self: end;
    padding-right: 0.5rem;
  }
  .alc-mx__axis--cols {
    text-align: right;
    margin-bottom: 0.25rem;
  }
  .alc-mx__head {
    font-size: 11px;
    font-weight: 600;
    color: var(--alc-fg-2);
    text-align: center;
  }
  .alc-mx__row {
    display: flex;
    align-items: center;
    font-size: 11px;
    font-weight: 600;
    color: var(--alc-fg-2);
    padding-right: 0.75rem;
  }
  .alc-mx__cell {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 2.25rem;
    border-radius: 0.375rem;
    font-size: 11px;
  }
  .alc-mx__cell--yes {
    background: color-mix(in srgb, var(--alc-accent) 28%, transparent);
    border: 1px solid color-mix(in srgb, var(--alc-accent) 70%, transparent);
    color: var(--alc-fg-1);
    font-weight: 600;
  }
  .alc-mx__cell--no {
    border: 1px dashed var(--alc-hairline-3);
    color: var(--alc-fg-4);
  }
</style>
