---
import "./diagrams/diagram.css";
import DomainIcon from "./domain/DomainIcon.astro";
import DomainNode from "./domain/DomainNode.astro";
import { KIND_ORDER, KINDS, type Kind } from "./domain/kinds.ts";

/**
 * `<DAG />` — server-rendered SVG of a small directed acyclic graph.
 *
 * Used in concept docs to illustrate resource dependency graphs and
 * lifecycle flows. Auto-layouts nodes left-to-right using longest-path
 * layering, then positions each node within its layer to minimize
 * crossings (centered, tie-broken by input order).
 *
 * Styled to match the brand (parchment panel, moss accents, walnut
 * text, JetBrains Mono labels).
 *
 * Usage in MDX:
 *   import DAG from "../../../components/DAG.astro";
 *   <DAG
 *     nodes={[
 *       { id: "Bucket",   label: "Bucket",   type: "Cloudflare.R2Bucket" },
 *       { id: "Sessions", label: "Sessions", type: "Cloudflare.KVNamespace" },
 *       { id: "Queue",    label: "Queue",    type: "AWS.SQS.Queue" },
 *       { id: "Worker",   label: "Worker",   type: "Cloudflare.Worker" },
 *     ]}
 *     edges={[
 *       { from: "Bucket",   to: "Queue" },
 *       { from: "Bucket",   to: "Worker" },
 *       { from: "Sessions", to: "Worker" },
 *       { from: "Queue",    to: "Worker" },
 *     ]}
 *   />
 */

export interface NodeIn {
  id: string;
  /** Visible label inside the node (defaults to `id`). */
  label?: string;
  /** Smaller subtitle below the label (e.g. resource type). */
  type?: string;
  /** Optional layer override (0-indexed left-to-right). Otherwise computed. */
  layer?: number;
  /**
   * Fixed grid placement. When every node has `col` and `row`, auto-layout is
   * skipped and edges are routed by direction: straight along a row or a
   * column, or an elbow (down, then across) between rows.
   */
  col?: number;
  row?: number;
  /** Visual tone for the node. Defaults to "default". */
  tone?: "default" | "accent" | "warn" | "danger";
  /**
   * What the node is in a domain model. Draws it with that kind's shape, icon
   * and colour (see `./domain/kinds.ts`), and adds a legend of the kinds shown.
   */
  kind?: Kind;
}

export type { Kind } from "./domain/kinds.ts";

export interface EdgeIn {
  from: string;
  to: string;
  /** Optional small label drawn near the edge midpoint. */
  label?: string;
  /** Render as a dashed line (e.g. for "later" / "deferred" edges). */
  dashed?: boolean;
  /**
   * On the grid, where an elbow leaves its source. `"bottom"` (the default)
   * leaves from the top or bottom and turns into the target's side. `"side"`
   * leaves from the source's side and turns into the target's top or bottom.
   */
  exit?: "bottom" | "side";
}

/**
 * A labelled border drawn around nodes, like an account or a region. Nest one
 * inside another with `parent`. An edge may point at a group's `id`, and ends
 * at its border, or start at one, and leave from it. An edge between two
 * groups, one above the other, joins their borders. Lay grouped diagrams out on the grid (`col`/`row`), leaving a
 * free row or column where a border needs the room.
 */
export interface GroupIn {
  id: string;
  label: string;
  /** Nodes directly inside this group. */
  nodes: string[];
  /** The group this one sits inside. */
  parent?: string;
  /** Draw the border dashed. */
  dashed?: boolean;
}

interface Props {
  nodes: NodeIn[];
  edges: EdgeIn[];
  groups?: GroupIn[];
  /** Layout direction. Defaults to "LR" (left-to-right). */
  direction?: "LR" | "TB";
  /** Optional caption rendered below the graph. */
  caption?: string;
  /**
   * Internal: render only the phone layout's SVG, the graph turned on its side
   * (grid columns become rows, left-to-right becomes top-to-bottom), when it is
   * narrower than the desktop layout at `wideWidth`.
   */
  narrow?: boolean;
  wideWidth?: number;
  /**
   * Internal: which phone layout to try. `transpose` turns the graph on its
   * side, `auto` drops the grid and lays it out by its edges top to bottom,
   * `compact` keeps the desktop direction with tighter nodes and gaps. Each
   * falls through to the next when it doesn't fit.
   */
  mode?: "transpose" | "auto" | "compact";
}

const props = Astro.props as Props;
const { narrow = false, wideWidth = Infinity } = props;
// The phone layout transposes the graph: a grid's columns become rows, and
// left-to-right becomes top-to-bottom. An elbow keeps its shape by swapping
// which side it leaves from.
const mode = props.mode ?? "transpose";
const rawNodes = !narrow || mode === "compact"
  ? props.nodes
  : mode === "auto"
    ? props.nodes.map((n) => ({ ...n, col: undefined, row: undefined }))
    : props.nodes.map((n) => ({ ...n, col: n.row, row: n.col }));
const edges = narrow && mode === "transpose"
  ? props.edges.map((e) => ({ ...e, exit: (e.exit === "side" ? "bottom" : "side") as EdgeIn["exit"] }))
  : props.edges;
const { groups = [], caption } = props;
const direction = !narrow || mode === "compact" ? (props.direction ?? "LR") : mode === "auto" ? "TB" : props.direction === "TB" ? "LR" : "TB";
// Marker ids are per figure: a page can hold several, and a hidden layout's markers don't render.
const uid = Math.random().toString(36).slice(2, 8);

// A grid starts at its first used column and row, so an unused column 0 never leaves a blank strip.
const minCol = Math.min(...rawNodes.map((n) => n.col ?? 0));
const minRow = Math.min(...rawNodes.map((n) => n.row ?? 0));
const nodes = rawNodes.map((n) => ({
  ...n,
  ...(n.col !== undefined ? { col: n.col - minCol } : {}),
  ...(n.row !== undefined ? { row: n.row - minRow } : {}),
}));

const kindsShown = KIND_ORDER.filter((k) => nodes.some((n) => n.kind === k));

// ---------- Layout ----------

// Text is monospace, so its width is about 0.6em per character: labels at 13px,
// subtitles and edge labels at 10.5px. Nodes and gaps grow to fit the widest.
const textWidth = (text: string, px: number) => text.length * px * 0.6;
// Domain nodes carry an icon beside their label, so they get a little more room.
const ICON_W = 20;
const NODE_W = Math.ceil(
  Math.max(
    narrow ? 96 : nodes.some((n) => n.kind) ? 164 : 140,
    ...nodes.map(
      (n) =>
        Math.max(
          textWidth(n.label ?? n.id, 13) + (n.kind ? ICON_W : 0),
          textWidth(n.type ?? "", 10.5),
        ) + (narrow ? 20 : 28),
    ),
  ),
);
const NODE_H = 56;
const NODE_H_TYPED = 64; // slightly taller when subtitle present
// Gaps fit the widest edge label; grouped diagrams need room for borders
// and the labels on edges crossing them.
// On a phone only edges that run across need room for their labels: labels on
// edges that run down sit beside them.
const across = (e: EdgeIn) => {
  const a = nodes.find((n) => n.id === e.from);
  const b = nodes.find((n) => n.id === e.to);
  if (!a || !b) return true;
  return a.row !== undefined && b.row !== undefined ? a.row === b.row || e.exit === "side" : direction === "LR";
};
const COL_GAP = Math.ceil(
  narrow
    ? Math.max(groups.length > 0 ? 40 : 28, ...edges.filter(across).map((e) => textWidth(e.label ?? "", 10.5) + 24))
    : Math.max(groups.length > 0 ? 116 : 80, ...edges.map((e) => textWidth(e.label ?? "", 10.5) + 28)),
);
const ROW_GAP = 28;
const PAD = narrow ? 10 : 24;

const idIndex = new Map(nodes.map((n, i) => [n.id, i]));

// Longest-path layering: layer(v) = 1 + max(layer(u)) over predecessors.
const incoming = new Map<string, string[]>();
const outgoing = new Map<string, string[]>();
for (const n of nodes) {
  incoming.set(n.id, []);
  outgoing.set(n.id, []);
}
for (const e of edges) {
  outgoing.get(e.from)?.push(e.to);
  incoming.get(e.to)?.push(e.from);
}

// Longest-path layering, cycle-safe: any predecessor edge that would
// re-enter a node currently on the recursion stack is treated as a
// back-edge and ignored for the purposes of layer assignment. This
// keeps cyclic graphs (A binds B, B binds A) layoutable side-by-side.
const layerOf = new Map<string, number>();
const visiting = new Set<string>();
const visit = (id: string): number => {
  const cached = layerOf.get(id);
  if (cached !== undefined) return cached;
  const override = nodes[idIndex.get(id)!]?.layer;
  if (override !== undefined) {
    layerOf.set(id, override);
    return override;
  }
  if (visiting.has(id)) {
    // Back-edge: caller will Math.max with our placeholder; returning
    // -1 means "don't push my dependent down a layer for this edge".
    return -1;
  }
  visiting.add(id);
  const preds = incoming.get(id) ?? [];
  const predLayers = preds.map(visit).filter((l) => l >= 0);
  const l = predLayers.length === 0 ? 0 : Math.max(...predLayers) + 1;
  visiting.delete(id);
  layerOf.set(id, l);
  return l;
};
nodes.forEach((n) => visit(n.id));

const layers: string[][] = [];
for (const n of nodes) {
  const l = layerOf.get(n.id)!;
  if (!layers[l]) layers[l] = [];
  layers[l].push(n.id);
}

// Heights — bump rows that have a subtitle.
const heightOf = (id: string): number =>
  nodes[idIndex.get(id)!]?.type ? NODE_H_TYPED : NODE_H;

// Position nodes within each layer; center on the tallest layer.
const colMaxHeight = layers.map((col) =>
  col.reduce((acc, id) => acc + heightOf(id) + ROW_GAP, -ROW_GAP),
);
const tallest = Math.max(...colMaxHeight);

const positions = new Map<string, { x: number; y: number; h: number }>();

const GRID_ROW_GAP = groups.length > 0 ? 72 : 56;
const grid = nodes.every((n) => n.col !== undefined && n.row !== undefined);

if (grid) {
  for (const n of nodes) {
    positions.set(n.id, {
      x: PAD + n.col! * (NODE_W + COL_GAP),
      y: PAD + n.row! * (NODE_H_TYPED + GRID_ROW_GAP),
      h: NODE_H_TYPED,
    });
  }
} else if (direction === "LR") {
  layers.forEach((col, ci) => {
    const colH = colMaxHeight[ci]!;
    let y = PAD + (tallest - colH) / 2;
    for (const id of col) {
      const h = heightOf(id);
      positions.set(id, {
        x: PAD + ci * (NODE_W + COL_GAP),
        y,
        h,
      });
      y += h + ROW_GAP;
    }
  });
} else {
  // TB — swap roles: each "layer" becomes a row.
  layers.forEach((row, ri) => {
    const rowW = row.length * (NODE_W + COL_GAP) - COL_GAP;
    const totalW = Math.max(
      ...layers.map((r) => r.length * (NODE_W + COL_GAP) - COL_GAP),
    );
    let x = PAD + (totalW - rowW) / 2;
    for (const id of row) {
      const h = heightOf(id);
      positions.set(id, {
        x,
        y: PAD + ri * (NODE_H_TYPED + 60),
        h,
      });
      x += NODE_W + COL_GAP;
    }
  });
}

const hasBackEdge = edges.some(
  (e) => (layerOf.get(e.to) ?? 0) <= (layerOf.get(e.from) ?? 0),
);
// Back edges arc 36 below the nodes (LR) or to their right (TB), so only that side gets the room.
const BACK_EDGE_GUTTER = edges.some((e) => e.label && (layerOf.get(e.to) ?? 0) <= (layerOf.get(e.from) ?? 0)) ? 44 : 32;

const gridCols = grid ? Math.max(...nodes.map((n) => n.col!)) + 1 : 0;
const gridRows = grid ? Math.max(...nodes.map((n) => n.row!)) + 1 : 0;

const W = grid
  ? PAD * 2 + gridCols * NODE_W + (gridCols - 1) * COL_GAP
  :
  direction === "LR"
    ? PAD * 2 +
      layers.length * NODE_W +
      (layers.length - 1) * COL_GAP
    : PAD * 2 +
      Math.max(...layers.map((r) => r.length * (NODE_W + COL_GAP) - COL_GAP)) +
      (hasBackEdge ? BACK_EDGE_GUTTER : 0);
const H = grid
  ? PAD * 2 + gridRows * NODE_H_TYPED + (gridRows - 1) * GRID_ROW_GAP
  :
  direction === "LR"
    ? PAD * 2 + tallest + (hasBackEdge ? BACK_EDGE_GUTTER : 0)
    : PAD * 2 +
      layers.length * (NODE_H_TYPED + 60) -
      60;

// ---------- Groups ----------

interface Box {
  x: number;
  y: number;
  w: number;
  h: number;
}

const GROUP_PAD = 16;
const GROUP_LABEL = 26;
const groupById = new Map(groups.map((g) => [g.id, g]));
const depthOf = (g: GroupIn): number =>
  g.parent && groupById.has(g.parent) ? 1 + depthOf(groupById.get(g.parent)!) : 0;
const boxes = new Map<string, Box>();
// Innermost first, so each border wraps the borders inside it.
for (const g of [...groups].sort((a, b) => depthOf(b) - depthOf(a))) {
  const inner: Box[] = [
    ...g.nodes.flatMap((id) => {
      const p = positions.get(id);
      return p ? [{ x: p.x, y: p.y, w: NODE_W, h: p.h }] : [];
    }),
    ...groups.filter((c) => c.parent === g.id).flatMap((c) => boxes.get(c.id) ?? []),
  ];
  if (inner.length === 0) continue;
  const x0 = Math.min(...inner.map((b) => b.x)) - GROUP_PAD;
  const y0 = Math.min(...inner.map((b) => b.y)) - GROUP_LABEL;
  // Wide enough for its label.
  const x1 = Math.max(...inner.map((b) => b.x + b.w), x0 + g.label.length * 6.8 + 24 - GROUP_PAD) + GROUP_PAD;
  const y1 = Math.max(...inner.map((b) => b.y + b.h)) + GROUP_PAD;
  boxes.set(g.id, { x: x0, y: y0, w: x1 - x0, h: y1 - y0 });
}

let width = W;
let height = H;
if (boxes.size > 0) {
  // Borders reach past the nodes, so move everything in by what they need.
  const all = [...boxes.values()];
  const dx = Math.max(0, PAD - Math.min(...all.map((b) => b.x)));
  const dy = Math.max(0, PAD - Math.min(...all.map((b) => b.y)));
  for (const p of positions.values()) {
    p.x += dx;
    p.y += dy;
  }
  for (const b of all) {
    b.x += dx;
    b.y += dy;
  }
  width = Math.max(W + dx, ...all.map((b) => b.x + b.w + PAD));
  height = Math.max(H + dy, ...all.map((b) => b.y + b.h + PAD));
}

// ---------- Edge geometry ----------

interface Edge {
  d: string;
  midX: number;
  midY: number;
  label?: string;
  dashed?: boolean;
  beside?: boolean;
}

const TIP = 6;

const gridEdge = (e: EdgeIn): Edge => {
  const a = positions.get(e.from)!;
  const b = positions.get(e.to)!;
  const done = (d: string, midX: number, midY: number): Edge => ({
    d,
    midX,
    midY,
    label: e.label,
    dashed: e.dashed,
  });
  const ay = a.y + a.h / 2;
  const by = b.y + b.h / 2;
  if (a.y === b.y) {
    // Along a row, either way.
    const [x1, x2] = b.x > a.x ? [a.x + NODE_W, b.x - TIP] : [a.x, b.x + NODE_W + TIP];
    return done(`M ${x1} ${ay} L ${x2} ${by}`, (x1 + x2) / 2, ay);
  }
  const ax = a.x + NODE_W / 2;
  if (a.x === b.x) {
    // Along a column, either way.
    const [y1, y2] = b.y > a.y ? [a.y + a.h, b.y - TIP] : [a.y, b.y + b.h + TIP];
    // Label beside the line, not across it.
    return { ...done(`M ${ax} ${y1} L ${ax} ${y2}`, ax + 8, (y1 + y2) / 2 + 2), beside: true };
  }
  if (e.exit === "side") {
    // An elbow: leave from the side, then run up or down into the target.
    const x1 = b.x > a.x ? a.x + NODE_W : a.x;
    const bx = b.x + NODE_W / 2;
    const y2 = b.y > a.y ? b.y - TIP : b.y + b.h + TIP;
    return done(`M ${x1} ${ay} L ${bx} ${ay} L ${bx} ${y2}`, (x1 + bx) / 2, ay);
  }
  // An elbow: leave from the top or bottom, then run across into the target's side.
  const y1 = b.y > a.y ? a.y + a.h : a.y;
  const x2 = b.x > a.x ? b.x - TIP : b.x + NODE_W + TIP;
  return done(`M ${ax} ${y1} L ${ax} ${by} L ${x2} ${by}`, (ax + x2) / 2, by);
};

// An edge into a group runs straight to its border: down or up from a node
// above or below it, otherwise across.
const groupEdge = (e: EdgeIn, box: Box): Edge => {
  const a = positions.get(e.from)!;
  const x = a.x + NODE_W / 2;
  if (x > box.x && x < box.x + box.w && (a.y + a.h < box.y || a.y > box.y + box.h)) {
    const [y1, y2] = box.y > a.y ? [a.y + a.h, box.y - TIP] : [a.y, box.y + box.h + TIP];
    return { d: `M ${x} ${y1} L ${x} ${y2}`, midX: x + 8, midY: (y1 + y2) / 2 + 2, label: e.label, dashed: e.dashed, beside: true };
  }
  const y = a.y + a.h / 2;
  const [x1, x2] = box.x > a.x ? [a.x + NODE_W, box.x - TIP] : [a.x, box.x + box.w + TIP];
  if (y < box.y || y > box.y + box.h) {
    // Beside the group but above or below it: an elbow down or up, then across into its side.
    const by = box.y + box.h / 2;
    const y1 = by > y ? a.y + a.h : a.y;
    return { d: `M ${x} ${y1} L ${x} ${by} L ${x2} ${by}`, midX: (x + x2) / 2, midY: by, label: e.label, dashed: e.dashed };
  }
  return { d: `M ${x1} ${y} L ${x2} ${y}`, midX: (x1 + x2) / 2, midY: y, label: e.label, dashed: e.dashed };
};

// An edge out of a group leaves its border: up or down into a node above or
// below it, otherwise across from its side.
const fromGroupEdge = (e: EdgeIn, box: Box): Edge => {
  const b = positions.get(e.to)!;
  const x = b.x + NODE_W / 2;
  if (x > box.x && x < box.x + box.w && (b.y + b.h < box.y || b.y > box.y + box.h)) {
    const [y1, y2] = b.y < box.y ? [box.y, b.y + b.h + TIP] : [box.y + box.h, b.y - TIP];
    return { d: `M ${x} ${y1} L ${x} ${y2}`, midX: x + 8, midY: (y1 + y2) / 2 + 2, label: e.label, dashed: e.dashed, beside: true };
  }
  const y = b.y + b.h / 2;
  const [x1, x2] = b.x > box.x ? [box.x + box.w, b.x - TIP] : [box.x, b.x + NODE_W + TIP];
  return { d: `M ${x1} ${y} L ${x2} ${y}`, midX: (x1 + x2) / 2, midY: y, label: e.label, dashed: e.dashed };
};

// An edge between two groups, one above the other, runs straight between
// their borders, in the middle of the span they share.
const betweenGroupsEdge = (e: EdgeIn, from: Box, to: Box): Edge => {
  const left = Math.max(from.x, to.x);
  const right = Math.min(from.x + from.w, to.x + to.w);
  const x = right > left ? (left + right) / 2 : from.x + from.w / 2;
  const [y1, y2] = to.y < from.y ? [from.y, to.y + to.h + TIP] : [from.y + from.h, to.y - TIP];
  return { d: `M ${x} ${y1} L ${x} ${y2}`, midX: x + 8, midY: (y1 + y2) / 2 + 2, label: e.label, dashed: e.dashed, beside: true };
};

const buildEdges = (): Edge[] =>
  edges.map((e) => {
    // A node wins over a group with the same id.
    const box = positions.has(e.to) ? undefined : boxes.get(e.to);
    const fromBox = positions.has(e.from) ? undefined : boxes.get(e.from);
    if (box && fromBox) return betweenGroupsEdge(e, fromBox, box);
    if (box) return groupEdge(e, box);
    if (fromBox) return fromGroupEdge(e, fromBox);
    if (grid) return gridEdge(e);
    const a = positions.get(e.from)!;
    const b = positions.get(e.to)!;
    const aLayer = layerOf.get(e.from)!;
    const bLayer = layerOf.get(e.to)!;
    const isBack =
      direction === "LR" ? bLayer <= aLayer : bLayer <= aLayer;

    if (direction === "LR") {
      if (!isBack) {
        // Forward edge — straight cubic from source.right to target.left.
        const x1 = a.x + NODE_W;
        const y1 = a.y + a.h / 2;
        const x2 = b.x - TIP;
        const y2 = b.y + b.h / 2;
        const cx = x1 + (x2 - x1) * 0.5;
        const d = `M ${x1} ${y1} C ${cx} ${y1}, ${cx} ${y2}, ${x2} ${y2}`;
        return {
          d,
          midX: (x1 + x2) / 2,
          midY: (y1 + y2) / 2,
          label: e.label,
          dashed: e.dashed,
        };
      }
      // Back-edge — arc beneath both nodes from source.bottom to target.bottom
      // so arrow remains visibly between/under the nodes (not behind them).
      const x1 = a.x + NODE_W * 0.5;
      const y1 = a.y + a.h;
      const x2 = b.x + NODE_W * 0.5;
      const y2 = b.y + b.h + TIP;
      const dropMax = 36;
      const cy = Math.max(y1, y2) + dropMax;
      const d = `M ${x1} ${y1} C ${x1} ${cy}, ${x2} ${cy}, ${x2} ${y2}`;
      return {
        d,
        midX: (x1 + x2) / 2,
        midY: cy,
        label: e.label,
        dashed: e.dashed,
      };
    }

    // TB direction.
    if (!isBack) {
      const x1 = a.x + NODE_W / 2;
      const y1 = a.y + a.h;
      const x2 = b.x + NODE_W / 2;
      const y2 = b.y - TIP;
      const cy = y1 + (y2 - y1) * 0.5;
      const d = `M ${x1} ${y1} C ${x1} ${cy}, ${x2} ${cy}, ${x2} ${y2}`;
      return {
        d,
        midX: (x1 + x2) / 2,
        midY: (y1 + y2) / 2,
        label: e.label,
        dashed: e.dashed,
      };
    }
    // TB back-edge — arc to the right.
    const x1 = a.x + NODE_W;
    const y1 = a.y + a.h / 2;
    const x2 = b.x + NODE_W + TIP;
    const y2 = b.y + b.h / 2;
    const dx = 36;
    const cx = Math.max(x1, x2) + dx;
    const d = `M ${x1} ${y1} C ${cx} ${y1}, ${cx} ${y2}, ${x2} ${y2}`;
    return {
      d,
      midX: cx,
      midY: (y1 + y2) / 2,
      label: e.label,
      dashed: e.dashed,
    };
  });

const edgeShapes = buildEdges();

// A group label sits at the start of its border, or after the first edge
// that would run through it, or at the end.
const verticals = edgeShapes.flatMap((e) => {
  const pts = [...e.d.matchAll(/(-?[\d.]+) (-?[\d.]+)/g)].map((m) => [Number(m[1]), Number(m[2])] as const);
  return pts.slice(1).flatMap(([x, y], i) => {
    const [px, py] = pts[i]!;
    return px === x ? [{ x, y0: Math.min(py, y), y1: Math.max(py, y) }] : [];
  });
});
const labelPlace = (g: GroupIn, b: Box): { x: number; anchor: "start" | "end" } => {
  const width = g.label.length * 6.8;
  const crossing = verticals
    .filter((v) => v.y0 < b.y + 22 && v.y1 > b.y + 4 && v.x > b.x && v.x < b.x + b.w)
    .map((v) => v.x);
  const clear = (x0: number) => !crossing.some((x) => x > x0 - 6 && x < x0 + width + 6);
  const start = [b.x + 12, ...crossing.map((x) => x + 10).sort((a, c) => a - c)].find(
    (x) => x + width < b.x + b.w - 12 && clear(x),
  );
  return start !== undefined ? { x: start, anchor: "start" } : { x: b.x + b.w - 12, anchor: "end" };
};
