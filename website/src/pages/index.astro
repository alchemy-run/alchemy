---
import Marketing from "../layouts/Marketing.astro";
import CodeBlock from "../components/marketing/CodeBlock.astro";
import Button from "../components/marketing/Button.astro";
import ProviderMark from "../components/marketing/ProviderMark.astro";
import HeroBgGraph from "../components/marketing/HeroBgGraph.astro";
import Yantra from "../brand/Yantra.astro";
import DevTuiTerminal from "../components/marketing-islands/DevTuiTerminal.tsx";
import HeroHosts from "../components/marketing-islands/HeroHosts.tsx";
import { HOSTS, hostSource } from "../components/marketing-islands/heroHosts";
import { installSpec } from "../../plugins/preview-install.ts";
import Terminal from "../components/Terminal.astro";
import Sentiment from "../components/marketing/Sentiment.astro";
import AlchemicalDivider from "../components/marketing/AlchemicalDivider.astro";
import TestTerminal from "../components/marketing-islands/TestTerminal.tsx";
import PRLifecycle from "../components/marketing-islands/PRLifecycle.tsx";
import PreviewComment from "../components/marketing-islands/PreviewComment.tsx";
import TypePolicy from "../components/marketing-islands/TypePolicy.tsx";
import ObservabilityDash from "../components/marketing-islands/ObservabilityDash.tsx";
import CopyForAgent from "../components/marketing-islands/CopyForAgent.tsx";

const alchemySpec = installSpec("alchemy");

// The hero terminal covers the code card's empty bottom-right corner: it
// starts below the last line that reaches TERM_COL, so no code is hidden.
// The code changes per host, so measure every host's version.
const TERM_COL = 45;
const HOST_LINES = HOSTS.map((h) => hostSource(h.values).split("\n"));
const TERM_LINE = Math.max(
  ...HOST_LINES.map(
    (lines) => lines.findLastIndex((l) => l.trimEnd().length > TERM_COL - 2) + 1,
  ),
);
const STACK_WIDTH = Math.max(...HOST_LINES.flat().map((l) => l.length));
// Cropped to the comment logic inside the Stack.
const PREVIEW_SRC = `const api = yield* Api;
const pr = yield* Config.option(Config.Int("PULL_REQUEST"));
const sha = yield* Config.String("GITHUB_SHA");

if (Option.isSome(pr)) {
  yield* GitHub.Comment("Preview", {
    owner: "acme",
    repository: "my-app",
    issueNumber: pr.value,
    body: Output.interpolate\`Preview: \${api.url} (\${sha})\`,
    allowDelete: true,
  });
}`;
// The GitHub.Comment block, highlighted in the snippet above.
const PREVIEW_COMMENT_LINES: [number, number][] = [[6, 12]];

// The vertical track beside the sections that walk the full picture.
const RAIL = [
  { label: "Declare", steps: [{ id: "loop-model", title: "the model" }] },
  { label: "Specify", steps: [{ id: "loop-stories", title: "stories" }] },
  { label: "Prove", steps: [{ id: "loop-prove", title: "invariants" }] },
  { label: "Ground", steps: [{ id: "loop-ground", title: "Layers" }] },
  { label: "Run", steps: [{ id: "loop-local", title: "on your machine" }] },
  { label: "Test", steps: [{ id: "loop-live", title: "live cloud" }] },
  { label: "Ship", steps: [{ id: "loop-pr", title: "preview per PR" }] },
  { label: "Observe", steps: [{ id: "loop-prod", title: "trace the model" }] },
];
const railKicker = (id: string) => {
  const group = RAIL.find((g) => g.steps.some((s) => s.id === id))!;
  return `${group.label} · ${group.steps.find((s) => s.id === id)!.title}`;
};

const COMMAND_SRC = `export class WithdrawMoney extends Domain.Command("WithdrawMoney", {
  target: AccountId,
  input: { amount: Schema.Int },
  events: [MoneyWithdrawn],
  rejects: [NotOpen, InsufficientFunds],
  reply: { balance: Schema.Int },
}) {}`;

const DECIDE_SRC = `decide: {
  WithdrawMoney: (account, cmd) =>
    account._tag !== "Open"
      ? new NotOpen()
      : cmd.amount > account.balance
        ? new InsufficientFunds({
            balance: account.balance,
            requested: cmd.amount,
          })
        : [
            new MoneyWithdrawn({
              amount: cmd.amount,
              balanceAfter: account.balance - cmd.amount,
            }),
          ],
},`;

const STORY_RULE_SRC = `it.effect("an overdraft is rejected with the evidence", () =>
  story(
    Story.given(
      account,
      new AccountOpened({ owner: "sam" }),
      new MoneyDeposited({ amount: 50, balanceAfter: 50 }),
    ),
    Story.when(account, new WithdrawMoney({ amount: 80 })),
    Story.rejected(
      new InsufficientFunds({ balance: 50, requested: 80 }),
    ),
  ),
);`;

const STORY_CHAIN_SRC = `it.effect("a risky withdrawal freezes the account", () =>
  story(
    Story.given(
      account,
      new AccountOpened({ owner: "sam" }),
      new MoneyDeposited({ amount: 90_000, balanceAfter: 90_000 }),
    ),
    Story.when(account, new WithdrawMoney({ amount: 60_000 })),
    Story.then(
      account,
      new MoneyWithdrawn({ amount: 60_000, balanceAfter: 30_000 }),
    ),
    // the fraud policy asks the scoring service; the story answers
    Story.call(FraudCheck.score, {
      accountId: account.id,
      amount: 60_000,
    }),
    Story.succeed(FraudCheck.score, { risk: 0.95 }),
    Story.then(
      account,
      new AccountFrozen({
        reason: "fraud risk 0.95",
        by: system("FraudReview"),
      }),
    ),
  ),
);`;

const RULES_SRC = `// rules sit on the aggregate, beside decide
invariants: {
  NeverOverdrawn: (account) =>
    account._tag !== "Open" || account.balance >= 0,
},
transitions: {
  AClosedAccountStaysClosed: ({ before, after }) =>
    before._tag !== "Closed" || after._tag === "Closed",
},

// one test verifies every rule in the model
it.effect("the bank keeps its promises", () =>
  Verify.model(Bank, { apis: [CustomerApi, SupportApi], story }),
);`;

const VERIFY_OUT = `
[b]Proved[/b][d]: for every state and every input,
after any number of commands[/d]
  [g]✓[/g] Account.NeverOverdrawn
  [g]✓[/g] Account.WithinDailyLimit
  [g]✓[/g] Account.AClosedAccountStaysClosed

[b]Checked[/b][d]: every sequence of up to 2 commands,
each event delivered twice, each saga step run
twice, every answer FraudCheck can give[/d]
[d]19,641 sequences, 10,648 states[/d]
  [g]✓[/g] Bank.TransfersLoseNoMoney
  [g]✓[/g] Bank.NoTransferLeftPending
  [g]✓[/g] Bank.EveryTransferEnds

[b]Sampled[/b][d]: 200 longer sequences, of up to
12 commands picked at random (seed 1)[/d]
  [g]✓[/g] none breaks a rule`;

// What a Layer can ground a program in, by the contract it answers.
const LAYERS = [
  {
    label: "Actors",
    items: [
      { label: "Durable Objects", href: "/domain/cloudflare" },
      { label: "Rivet", href: "/domain/rivet" },
      { label: "Effect Cluster", href: "/domain/effect-cluster" },
      { label: "In memory", href: "/domain/in-memory" },
    ],
  },
  {
    label: "Sandboxes",
    items: [
      { label: "E2B", href: "/e2b" },
      { label: "Daytona", href: "/daytona" },
      { label: "Modal", href: "/modal" },
      { label: "Boat", href: "/boat" },
      { label: "Archil", href: "/archil" },
      { label: "AWS", href: "/aws/compute/ecs-sandboxes" },
    ],
  },
  {
    label: "Compute",
    items: [
      { label: "Cloudflare", href: "/cloudflare" },
      { label: "AWS", href: "/aws" },
      { label: "GCP", href: "/gcp" },
      { label: "Fly", href: "/fly" },
      { label: "Railway", href: "/railway" },
      { label: "Hetzner", href: "/hetzner" },
      { label: "Kubernetes", href: "/kubernetes" },
      { label: "Docker", href: "/docker" },
    ],
  },
  {
    label: "Data",
    items: [
      { label: "Neon", href: "/neon" },
      { label: "PlanetScale", href: "/planetscale" },
      { label: "Turso", href: "/turso" },
      { label: "Prisma", href: "/prisma" },
    ],
  },
  { label: "Agents", items: [{ label: "harnesses, coming soon" }] },
];

const WIRING_SRC = `const BankLive = Bank.layer(BankHandlers).pipe(
  // the ledger projection writes to a D1 database
  Layer.provideMerge(D1LedgerStore),
  Layer.provide(
    Layer.mergeAll(
      // one Durable Object per aggregate
      DomainCloudflare.layerDurableObjects(),
      // Payments and FraudCheck, answered by vendors
      StripePayments,
      SiftFraudCheck,
      Cloudflare.D1.QueryDatabaseBinding,
    ),
  ),
);`;

const TRACE_OUT = `
[b]Domain.send[/b] Account.WithdrawMoney          [d]the Worker[/d]
└─ [b]Domain.decide[/b] Account.WithdrawMoney     [d]the account's Durable Object[/d]
   │   [g]event[/g] MoneyWithdrawn
   ├─ [b]Domain.view[/b] AccountSummary
   ├─ [b]Domain.view[/b] DailyOutflow
   └─ [b]Domain.policy[/b] FraudReview
      ├─ [b]Domain.external[/b] FraudCheck.score
      └─ [b]Domain.send[/b] Account.FreezeAccount
         └─ [b]Domain.decide[/b] Account.FreezeAccount`;

const TEST_SRC = `const { test, beforeAll, afterAll, deploy, destroy } = Test.make({
  providers: Cloudflare.providers(),
  dev: !!process.env.LOCAL, // emulated, or the real cloud
});

const stack = beforeAll(deploy(Stack)); // its own stage
afterAll(destroy(Stack));

test("PUT + GET round-trips through R2", Effect.gen(function* () {
  const { url } = yield* stack;
  const res = yield* HttpClient.get(\`\${url}/object/hello.txt\`);
  expect(yield* res.text).toBe("hi!");
}));`;

const VITE_SRC = `import Api from "./src/api.ts";

export default Alchemy.Stack(
  "my-app",
  { providers: Cloudflare.providers() },
  Effect.gen(function* () {
    // backend: a Cloudflare Worker, run locally in workerd
    const api = yield* Api;
    // frontend: a Vite app that calls it
    const web = yield* Cloudflare.Website.Vite("Web", {
      env: { VITE_API_URL: api.url },
    });
    return { web: web.url, api: api.url };
  }),
);`;

// Marks render monochrome (inheriting the label color) and take on the
// official brand hue only on hover. `color` values are verified against
// svgl.app's SVGs; Prisma swaps to its multi-color mark instead.
const PROVIDERS = [
  { label: "Cloudflare", icon: "Cloudflare", href: "/cloudflare", color: "#f4811f" },
  { label: "AWS", icon: "AWS", href: "/aws", color: "#ff9900" },
  { label: "Hetzner", icon: "Hetzner", href: "/hetzner", color: "#d50c2d" },
  { label: "Fly", icon: "Fly", href: "/fly", color: "#996bec" },
  { label: "Railway", icon: "Railway", href: "/railway" },
  { label: "Neon", icon: "Neon", href: "/neon", color: "#37c38f" },
  { label: "PlanetScale", icon: "PlanetScale", href: "/planetscale" },
  { label: "Prisma", icon: "Prisma", iconHover: "PrismaColor", href: "/prisma" },
  { label: "Docker", icon: "Docker", href: "/docker", color: "#008fe2" },
  { label: "Stripe", icon: "Stripe", href: "/stripe", color: "#533afd" },
  { label: "GitHub", icon: "GitHub", href: "/github" },
  { label: "Axiom", icon: "Axiom", href: "/axiom" },
];

---

<Marketing
  title="Alchemy · generate and deploy verified, production-ready software"
  description="Model your business with domain-driven design and your infrastructure as code, in one typed program. Stories and proofs verify the business logic, the type checker verifies the infrastructure, and Layers ground it in any platform."
>
  <!-- Hero + marquee fill the first screen so the marquee lands just above the fold. -->
  <div class="v2-fold">
  <!-- ───────────────── HERO ───────────────── -->
  <section class="alc-hero v2-hero" style="padding:20px 32px 16px;">
    <HeroBgGraph />
    <button type="button" class="v2-motion-toggle" id="motion-toggle" aria-pressed="false">
      <span class="v2-motion-toggle__label">Pause motion</span>
    </button>
    <div class="v2-hero__grid">
      <div class="v2-hero__copy">
        <div class="alc-hero__inner">
          <Yantra class="alc-hero__mark v2-hero__mark" size={42} />
          <h1
            data-copy
            class="alc-hero__title"
            id="hero-h1"
            style="font-size:clamp(38px,3.65vw,52px);"
          >
            Generate and deploy verified, production-ready software
          </h1>
          <p
            data-copy
            class="alc-hero__subtitle"
            id="hero-sub"
            style="font-size:clamp(17px,2.2vw,22px);max-width:560px;"
          >
            Model your business with domain-driven design and your infrastructure as code, in one typed program. Stories and proofs verify the business logic, the type checker verifies the infrastructure, and Layers ground it in any platform.
          </p>
          <div class="alc-hero__cta">
            <Button variant="primary" icon="arrow" href="/getting-started">
              <span data-copy>Start your project</span>
            </Button>
            <Button variant="secondary" href="#agent-prompt">
              <span data-copy>Build it with your agent</span>
              <span class="v2-hero__cta-arrow" aria-hidden="true">&darr;</span>
            </Button>
          </div>
        </div>
      </div>
      <div
        class="v2-hero__visual"
        aria-hidden="true"
        style={`--term-line:${TERM_LINE};--term-col:${TERM_COL}ch;--code-cols:${STACK_WIDTH + 1}ch`}
      >
        <HeroHosts client:load />
      </div>
    </div>
  </section>

  <!-- ───────────────── PROVIDER MARQUEE ───────────────── -->
  <div class="v2-marquee" aria-label="Supported cloud providers">
    <div class="v2-marquee__track">
      {
        /* Four copies so the -50% loop shift always lands on an identical
           frame with content still covering viewports up to ~2 copies wide.
           Two copies leave a blank tail on screens wider than one copy. */
        [0, 1, 2, 3].map((dup) => (
          <ul class="v2-marquee__group" aria-hidden={dup > 0}>
            {PROVIDERS.map((p) => (
              <li>
                <a
                  class="v2-marquee__item"
                  href={p.href}
                  tabindex={dup > 0 ? -1 : undefined}
                  style={"color" in p ? `--brand:${p.color}` : undefined}
                >
                  <span
                    class:list={[
                      "v2-marquee__mark",
                      "iconHover" in p && "v2-marquee__mark--swap",
                    ]}
                  >
                    <ProviderMark name={p.icon} size={17} />
                  </span>
                  {"iconHover" in p && (
                    <span class="v2-marquee__mark v2-marquee__mark--hover">
                      <ProviderMark name={p.iconHover} size={17} />
                    </span>
                  )}
                  {p.label}
                </a>
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
  </div>

  <script>
    // WCAG 2.2.2: the hero rings and the provider marquee move on their
    // own, so offer a way to stop them. Remembered across visits.
    const KEY = "alc-motion-paused";
    const btn = document.getElementById("motion-toggle")!;
    const label = btn.querySelector(".v2-motion-toggle__label")!;
    const apply = (paused: boolean) => {
      document.documentElement.classList.toggle("alc-motion-paused", paused);
      btn.setAttribute("aria-pressed", String(paused));
      label.textContent = paused ? "Play motion" : "Pause motion";
      window.dispatchEvent(new Event("alc-motion-change"));
    };
    apply(localStorage.getItem(KEY) === "1");
    btn.addEventListener("click", () => {
      const paused = !document.documentElement.classList.contains("alc-motion-paused");
      localStorage.setItem(KEY, paused ? "1" : "0");
      apply(paused);
    });
  </script>

  <div class="v2-scroll-hint" id="scroll-hint" aria-hidden="true">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg>
  </div>
  <script>
    // Only while scrolled to the top, and only when the hero + marquee fit
    // on screen (the chevron sits in the gap below the marquee).
    const hint = document.getElementById("scroll-hint")!;
    const fold = document.querySelector<HTMLElement>(".v2-fold")!;
    const sync = () =>
      hint.classList.toggle(
        "is-hidden",
        scrollY > 4 || fold.getBoundingClientRect().bottom > innerHeight + 1,
      );
    addEventListener("scroll", sync, { passive: true });
    addEventListener("resize", sync);
    sync();
  </script>

  <!-- ───────────────── THE FULL PICTURE ───────────────── -->
  <AlchemicalDivider variant="dot" class="v2-divider" />
  <section class="v2-section v2-pat-1 v2-overview">
    <div class="v2-container">
      <h2 class="v2-h2" data-copy>One program, from the business rule to the cloud resource</h2>
      <p class="v2-lede" data-copy>
        You or your agent declare the software against contracts: the business as a model, its behavior as stories and rules, and everything it needs from outside. Layers ground each contract in a real platform. Every step then proves the program works before the next one starts: types, stories and proofs answer in milliseconds, emulated tests in seconds, and the real cloud in about 20 seconds. CI deploys a preview, tests it, and ships it on merge.
      </p>
      <p class="v2-overview__source">
        <a
          href="https://github.com/alchemy-run/alchemy/tree/main/examples/cloudflare-preview-benchmark"
          target="_blank"
          rel="noopener"
        >
          <span data-copy>See the example app and benchmark on GitHub</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </p>
      <PRLifecycle client:visible />
    </div>
  </section>

  <nav class="v2-rail" aria-label="From a declaration to production">
    <span class="v2-rail__track" aria-hidden="true"><span class="v2-rail__fill"></span></span>
    {RAIL.map((group) => (
      <div class="v2-rail__group">
        <span class="v2-rail__label">{group.label}</span>
        <ol class="v2-rail__steps">
          {group.steps.map((step) => (
            <li>
              <a class="v2-rail__step" href={`#${step.id}`} data-rail={step.id}>
                <span class="v2-rail__dot" aria-hidden="true"></span>
                {step.title}
              </a>
            </li>
          ))}
        </ol>
      </div>
    ))}
  </nav>
  <script>
    // Light the rail's step for the section in the middle of the viewport,
    // fill the track up to it, and show the rail only while those sections
    // are on screen.
    const rail = document.querySelector<HTMLElement>(".v2-rail")!;
    const sections = [
      ...document.querySelectorAll<HTMLElement>("[data-rail-section]"),
    ];
    const links = new Map(
      [...rail.querySelectorAll<HTMLAnchorElement>("[data-rail]")].map((a) => [
        a.dataset.rail!,
        a,
      ]),
    );
    const syncRail = () => {
      const mid = innerHeight * 0.45;
      const start = sections[0]!.getBoundingClientRect();
      const end = sections[sections.length - 1]!.getBoundingClientRect();
      rail.classList.toggle("is-shown", start.top < mid && end.bottom > mid);
      const current =
        sections.findLast((el) => el.getBoundingClientRect().top < mid) ??
        sections[0]!;
      let reached = true;
      for (const [id, a] of links) {
        a.classList.toggle("is-current", id === current.id);
        a.classList.toggle("is-done", reached && id !== current.id);
        if (id === current.id) reached = false;
      }
      // One track from the first dot to the last, filled to the current one.
      const dots = [...rail.querySelectorAll<HTMLElement>(".v2-rail__dot")];
      const top = rail.getBoundingClientRect().top;
      const center = (el: HTMLElement) => {
        const r = el.getBoundingClientRect();
        return r.top + r.height / 2 - top;
      };
      const first = center(dots[0]!);
      const track = rail.querySelector<HTMLElement>(".v2-rail__track")!;
      track.style.top = `${first}px`;
      track.style.height = `${center(dots[dots.length - 1]!) - first}px`;
      const at = links.get(current.id)!.querySelector<HTMLElement>(".v2-rail__dot")!;
      track.style.setProperty("--fill", `${center(at) - first}px`);
    };
    addEventListener("scroll", syncRail, { passive: true });
    addEventListener("resize", syncRail);
    syncRail();
  </script>


  <!-- ───────────────── DECLARE ───────────────── -->
  <AlchemicalDivider variant="line" class="v2-divider" />
  <section class="v2-section v2-pat-2 v2-feature" id="loop-model" data-rail-section>
    <div class="v2-container">
      <p class="v2-kicker">{railKicker("loop-model")}</p>
      <h2 class="v2-h2" data-copy>Declare the whole system in its own language</h2>
      <p class="v2-lede" data-copy>
        <a href="/domain">Alchemy Domain</a> gives the words your business already uses a place in the code. A command declares what it asks for and every way it can end, an aggregate decides it in a pure function, and an event records what happened. What the model needs from outside, a payment provider or a database, it declares as a contract and nothing more. You, your agent and the type checker all read the same program.
      </p>
      <div class="v2-split">
        <CodeBlock filename="src/WithdrawMoney.command.ts" code={COMMAND_SRC} compact />
        <CodeBlock filename="src/Account.aggregate.ts" code={DECIDE_SRC} compact />
      </div>
    </div>
  </section>

  <!-- ───────────────── SPECIFY ───────────────── -->
  <AlchemicalDivider variant="triangle" class="v2-divider" />
  <section class="v2-section v2-pat-3 v2-feature" id="loop-stories" data-rail-section>
    <div class="v2-container">
      <p class="v2-kicker">{railKicker("loop-stories")}</p>
      <h2 class="v2-h2" data-copy>Specify behavior as stories, in the words of the business</h2>
      <p class="v2-lede" data-copy>
        A <a href="/domain/story">story</a> is a test written in the model's own terms: given this history, when this command, then these events. It reads like the requirement it came from, so the person who asked for the behavior can check it. It runs the real model in memory in milliseconds, policies and sagas included, and fails if anything happens that it doesn't account for. Write the story first, and let your agent change the model until it passes.
      </p>
      <div class="v2-split">
        <CodeBlock filename="test/Account.test.ts" code={STORY_RULE_SRC} compact />
        <CodeBlock filename="test/Fraud.test.ts" code={STORY_CHAIN_SRC} compact />
      </div>
    </div>
  </section>

  <!-- ───────────────── PROVE ───────────────── -->
  <AlchemicalDivider variant="square" class="v2-divider" />
  <section class="v2-section v2-pat-4 v2-feature" id="loop-prove" data-rail-section>
    <div class="v2-container">
      <p class="v2-kicker">{railKicker("loop-prove")}</p>
      <h2 class="v2-h2" data-copy>State an invariant and have it proved</h2>
      <p class="v2-lede" data-copy>
        A story tests the cases you thought of. An invariant is a predicate that must hold in every case, and nobody writes a case for it. One test proves each aggregate's invariants for every state and every input, then explores every short sequence of commands across the model for one that breaks a rule. A broken invariant fails with the shortest sequence that breaks it, written as a story.
      </p>
      <div class="v2-split">
        <CodeBlock filename="src/Account.aggregate.ts" code={RULES_SRC} compact />
        <Terminal title="pnpm test" content={VERIFY_OUT} />
      </div>
    </div>
  </section>

  <!-- ───────────────── GROUND ───────────────── -->
  <AlchemicalDivider variant="pentagon" class="v2-divider" />
  <section class="v2-section v2-pat-5 v2-feature" id="loop-ground" data-rail-section>
    <div class="v2-container">
      <p class="v2-kicker">{railKicker("loop-ground")}</p>
      <h2 class="v2-h2" data-copy>A Layer grounds it in a real platform</h2>
      <p class="v2-lede" data-copy>
        A specified and proved model still knows nothing about the cloud. A Layer answers each contract with a real platform, and owns the resources and the access that takes: Durable Objects for the aggregates, a database for the ledger, a vendor for payments. Swap a Layer and the same program runs in memory, on your machine, or on another platform.
      </p>
      <dl class="v2-layers">
        {LAYERS.map((family) => (
          <div class="v2-layers__row">
            <dt>{family.label}</dt>
            <dd>
              {family.items.map((item) =>
                "href" in item ? (
