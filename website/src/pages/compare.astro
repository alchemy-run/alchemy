<script>
    // SVG (SMIL) animations don't follow CSS, so reduced motion has to stop
    // them here: every diagram freezes on its first frame. Also re-applied
    // if the setting changes while the page is open.
    const motion = matchMedia("(prefers-reduced-motion: reduce)");
    const syncSvgMotion = () => {
        for (const svg of document.querySelectorAll<SVGSVGElement>("svg")) {
            if (!svg.querySelector("animate, animateMotion, animateTransform")) continue;
            if (motion.matches) {
                svg.pauseAnimations();
                svg.setCurrentTime(0);
            } else {
                svg.unpauseAnimations();
            }
        }
    };
    syncSvgMotion();
    motion.addEventListener("change", syncSvgMotion);
</script>

<script>
    // Alchemy's dev-mode picker in "Emulated, not proxied". On a switch the
    // boxes glide to their new spots and the dotted route bends with them
    // (redrawn every frame from the live box positions); boxes a mode doesn't
    // use shrink into the line. Then the new route, crossings, and dot land.
    type Slot = {
        x: number;
        y: number;
        w: number;
        label: string;
        shown: boolean;
        bar: string | null;
    };
    type ModeData = {
        headline: string;
        sub: string;
        local: boolean;
        aria: string;
        path: string;
        segs: number[][];
        crossings: { x: number; y: number }[];
        motion: { dur: string; keyPoints: string; keyTimes: string };
        slots: Slot[];
    };
    const MOVE_MS = 520;
    const ease = (t: number) => 1 - Math.pow(1 - t, 3);
    const draw = (segs: number[][]) =>
        segs
            .map(
                ([x0, y0, ax, ay, bx, by, x1, y1]) =>
                    `M ${x0} ${y0} C ${ax} ${ay}, ${bx} ${by}, ${x1} ${y1}`,
            )
            .join(" ");

    for (const fig of document.querySelectorAll<HTMLElement>(
        "figure[data-modes]",
    )) {
        const modes = JSON.parse(fig.dataset.modes!) as ModeData[];
        const svg = fig.querySelector("svg")!;
        const path = svg.querySelector<SVGPathElement>(".dg-trace__path")!;
        const crosses = svg.querySelector<SVGGElement>("[data-crosses]")!;
        const dotAnim = svg.querySelector<SVGAnimationElement>(
            "[data-dot] animateMotion",
        )!;
        const barAnim = svg.querySelector<SVGAnimationElement>("[data-bar]");
        const done = svg.querySelector<SVGTextElement>("[data-done]");
        const headline = fig.querySelector<HTMLElement>("[data-headline]")!;
        const sub = fig.querySelector<HTMLElement>("[data-sub]")!;
        const boxes = [...svg.querySelectorAll<SVGGElement>("[data-hop]")];
        // Cloned so new crossings keep the page's scoped styles.
        const crossTemplate = svg.querySelector<SVGCircleElement>(
            "[data-cross-template]",
        )!;
        const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
        let current = modes[0]!;
        let frame = 0;

        const place = (g: SVGGElement, s: Slot, x = s.x, y = s.y) => {
            g.style.transform = `translate(${x}px, ${y}px)`;
            const rect = g.querySelector("rect")!;
            rect.setAttribute("x", String(-s.w / 2));
            rect.setAttribute("width", String(s.w));
        };

        const land = (m: ModeData) => {
            path.setAttribute("d", m.path);
            crosses.replaceChildren(
                ...m.crossings.map((c) => {
                    const el = crossTemplate.cloneNode() as SVGCircleElement;
                    el.removeAttribute("data-cross-template");
                    el.removeAttribute("hidden");
                    el.setAttribute("cx", String(c.x));
                    el.setAttribute("cy", String(c.y));
                    return el;
                }),
            );
            dotAnim.setAttribute("dur", m.motion.dur);
            dotAnim.setAttribute("keyPoints", m.motion.keyPoints);
            dotAnim.setAttribute("keyTimes", m.motion.keyTimes);
            const bar = m.slots.find((s) => s.bar)?.bar;
            if (barAnim && bar) {
                barAnim.setAttribute("dur", m.motion.dur);
                barAnim.setAttribute("keyTimes", bar);
            }
            dotAnim.beginElement();
            barAnim?.beginElement();
            fig.classList.remove("is-switching");
        };

        fig.addEventListener("change", (e) => {
            const next = modes[Number((e.target as HTMLInputElement).value)];
            if (!next || next === current) return;
            const from = current;
            current = next;
            cancelAnimationFrame(frame);
            fig.classList.add("is-switching");
            headline.textContent = next.headline;
            sub.textContent = next.sub;
            done?.classList.toggle("is-hidden", !next.local);
            svg.setAttribute("aria-label", next.aria);
            boxes.forEach((g, i) => {
                const s = next.slots[i]!;
                g.classList.toggle("is-ghost", !s.shown);
                if (s.label) g.querySelector("text")!.textContent = s.label;
                const rect = g.querySelector("rect")!;
                rect.setAttribute("x", String(-s.w / 2));
                rect.setAttribute("width", String(s.w));
            });
            if (reduced) {
                boxes.forEach((g, i) => place(g, next.slots[i]!));
                land(next);
                return;
            }
            // Glide: interpolate every slot and every route control point, so the
            // line bends with the boxes and lands exactly on the new route.
            const t0 = performance.now();
            const tick = (now: number) => {
                const k = ease(Math.min(1, (now - t0) / MOVE_MS));
                const at = next.slots.map((s, i) => {
                    const f = from.slots[i]!;
                    return [f.x + (s.x - f.x) * k, f.y + (s.y - f.y) * k] as [
                        number,
                        number,
                    ];
                });
                boxes.forEach((g, i) =>
                    place(g, next.slots[i]!, at[i]![0], at[i]![1]),
                );
                path.setAttribute(
                    "d",
                    draw(
                        from.segs.map((seg, si) =>
                            seg.map(
                                (n, ni) => n + (next.segs[si]![ni]! - n) * k,
                            ),
                        ),
                    ),
                );
                if (k < 1) frame = requestAnimationFrame(tick);
                else land(next);
            };
            frame = requestAnimationFrame(tick);
        });
    }
</script>

