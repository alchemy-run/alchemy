{
  "extends": "../../tsconfig.base.json",
  "include": [
    "alchemy.run.ts",
    "vite.config.ts",
    "src/**/*.ts",
    "test/**/*.ts",
    "ui/**/*.ts",
    "ui/**/*.tsx"
  ],
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "target": "ESNext",
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./ui/*"
      ]
    }
  },
  "references": [
    {
      "path": "../../packages/alchemy/tsconfig.json"
    }
  ]
}