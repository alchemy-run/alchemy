{
  "cloud": "Fly",
  "namespace": "Fly",
  "path": "packages/alchemy/src/Fly",
  "layout": "flat",
  "distilledPackage": "@distilled.cloud/fly-io",
  "distilledService": "machines",
  "distilledRepo": "/Users/samgoodwin/workspaces/alchemy-effect-3/distilled",
  "locked": true,
  "implemented": false,
  "auth": {
    "env": ["FLY_API_TOKEN"],
    "optionalEnv": ["FLY_API_HOSTNAME"],
    "distilledCredentials": { "apiKey": "FLY_API_TOKEN", "apiBaseUrl": "FLY_API_HOSTNAME or https://api.machines.dev/v1" },
    "note": "Do not use distilled CredentialsFromEnv FLY_IO_API_KEY in Alchemy. Map in Fly/Credentials.ts."
  },
  "defaults": {
    "region": "iad",
    "guest": { "cpuKind": "shared", "cpus": 1, "memoryMb": 256, "size": "shared-cpu-1x" },
    "machineTestImage": "nginx:alpine",
    "appName": {
      "createPhysicalName": { "lowercase": true, "maxLength": 30 },
      "leadingLetter": "prefix f if needed",
      "globallyUnique": true
    }
  },
  "dx": {
    "parent": "Fly.App",
    "rawVm": "Fly.Machine",
    "platform": "Fly.Service",
    "servicesPerApp": "N Services per App, each Service is one Machine, not systemd-on-a-box",
    "volumeAttach": "MountVolume only; no VolumeAttachment",
    "moduleScope": "const Site = Fly.App(...); class Api extends Fly.Service<Api>()('Api', { app: Site, main: import.meta.url, region: 'iad' }, Effect.gen(...))"
  },
  "conventions": {
    "ref": "local unexported type Ref<T> = T | Effect.Effect<T, never, Providers>; do not export Ref",
    "props": "never Input<T>; never Output of a resource; primitive attrs stay Input<string> via engine wrap",
    "reconciler": "one observe-ensure-sync flow; do not branch on output === undefined",
    "wait": "machinesWait started|stopped|destroyed; timeout 8s; retry times <= 6; total backoff < 60s",
    "races": "catch typed Conflict and NotFound; patch distilled if missing from the union",
    "ownership": "App has no labels. Stamp alchemy.stack/stage/id onto Machine config.metadata and Volume/Secret/SecretKey names.",
    "list": "required on every resource. App.list uses appsList(org_slug from currentTokenShow) filtered to alchemy-owned names/metadata. Child list() scoped to owned Apps. Never machinesOrgList/volumesOrgList.",
    "errors": "UnknownFlyIoError or status-only handling is a distilled OpenAPI patch, never an alchemy catch"
  },
  "patches": {
    "target": "OpenAPI document via convert.ts",
    "keep": [
      "patches/bad-request-errors.patch.json",
      "patches/forbidden-errors.patch.json",
      "patches/not-found-errors.patch.json"
    ],
    "perOpDir": "patches/machines/{op}.patch.json",
    "opName": "camelCase generated operation, e.g. appsCreate.patch.json",
    "doNotNumber": true,
    "convertTs": "apply BOTH flat patches/*.patch.json AND patches/machines/*.patch.json; existing flat files must keep working",
    "regenerate": "cd distilled/packages/fly-io && bun scripts/convert.ts && bun scripts/generate.ts --resource machines && pnpm exec oxfmt src/services/machines.ts"
  },
  "resources": [
    {
      "name": "App",
      "type": "Fly.App",
      "file": "packages/alchemy/src/Fly/App.ts",
      "status": "missing",
      "priority": 1,
      "testability": "yes",
      "scope": "org",
      "parent": null,
      "replaces": ["name", "orgSlug", "network"],
      "ops": {
        "observe": "appsShow",
        "ensure": "appsCreate",
        "sync": null,
        "delete": "appsDelete",
        "list": "currentTokenShow + appsList(org_slug) filtered"
      }
    },
    {
      "name": "Machine",
      "type": "Fly.Machine",
      "file": "packages/alchemy/src/Fly/Machine.ts",
      "status": "missing",
      "priority": 1,
      "testability": "yes",
      "scope": "app",
      "parent": "Fly.App",
      "replaces": ["app", "name", "region"],
      "updates": ["image", "guest", "env", "services", "metadata", "restart", "mounts via MountVolume"],
      "ops": {
        "observe": "machinesShow",
        "ensure": "machinesCreate",
        "sync": "machinesUpdate",
        "wait": "machinesWait",
        "delete": "machinesDelete + machinesWait destroyed",
        "list": "machinesList on owned Apps, metadata alchemy.stack + alchemy.type=Fly.Machine"
      }
    },
    {
      "name": "Volume",
      "type": "Fly.Volume",
      "file": "packages/alchemy/src/Fly/Volume.ts",
      "status": "missing",
      "priority": 2,
      "testability": "yes",
      "scope": "app",
      "parent": "Fly.App",
      "replaces": ["app", "name", "region", "encrypted", "fstype", "snapshotId", "sourceVolumeId", "sizeGb shrink"],
      "updates": ["sizeGb grow via volumesExtend", "autoBackupEnabled", "snapshotRetention"],
      "ops": {
        "observe": "volumesGetById",
        "ensure": "volumesCreate",
        "sync": "volumesExtend + volumesUpdate",
        "delete": "volumeDelete",
        "list": "volumesList on owned Apps, alchemy name stamp"
      },
      "notes": "No VolumeAttachment. Attach only via MountVolume mounts on Machine/Service."
    },
    {
      "name": "VolumeSnapshot",
      "type": "Fly.VolumeSnapshot",
      "file": "packages/alchemy/src/Fly/VolumeSnapshot.ts",
      "status": "missing",
      "priority": 3,
      "testability": "limited",
      "scope": "volume",
      "parent": "Fly.Volume",
      "replaces": ["app", "volume"],
      "ops": {
        "observe": "volumesListSnapshots",
        "ensure": "createVolumeSnapshot",
        "sync": null,
        "delete": "no-op (no API); nuke.skip",
        "list": "volumesListSnapshots on owned Volumes"
      }
    },
    {
      "name": "Certificate",
      "type": "Fly.Certificate",
      "file": "packages/alchemy/src/Fly/Certificate.ts",
      "status": "missing",
      "priority": 3,
      "testability": "limited",
      "scope": "app",
      "parent": "Fly.App",
      "replaces": ["app", "hostname", "kind"],
      "skipIf": "FLY_TEST_DOMAIN",
      "ops": {
        "observe": "appCertificatesShow",
        "ensure": "appCertificatesAcmeCreate | appCertificatesCustomCreate",
        "sync": "appCertificatesCheck (acme)",
        "delete": "appCertificatesDelete | appCertificatesAcmeDelete | appCertificatesCustomDelete",
        "list": "appCertificatesList on owned Apps"
      }
    },
    {
      "name": "IpAssignment",
      "type": "Fly.IpAssignment",
      "file": "packages/alchemy/src/Fly/IpAssignment.ts",
      "status": "missing",
      "priority": 3,
      "testability": "yes",
      "scope": "app",
      "parent": "Fly.App",
      "replaces": ["app", "type", "region", "network", "serviceName"],
      "notes": "Default tests: v6 or shared_v4 only. No dedicated IPv4.",
      "ops": {
        "observe": "appIPAssignmentsList",
        "ensure": "appIPAssignmentsCreate",
        "sync": null,
        "delete": "appIPAssignmentsDelete",
        "list": "appIPAssignmentsList on owned Apps"
      }
    },
    {
      "name": "Secret",
      "type": "Fly.Secret",
      "file": "packages/alchemy/src/Fly/Secret.ts",
      "status": "missing",
      "priority": 2,
      "testability": "yes",
      "scope": "app",
      "parent": "Fly.App",
      "replaces": ["app", "name"],
      "updates": ["value"],
      "ops": {
        "observe": "secretGet",
        "ensure": "secretCreate",
        "sync": "secretCreate",
        "delete": "secretDelete",
        "list": "secretsList on owned Apps"
      },
      "notes": "Never persist value in state. Attrs: digest only."
    },
    {
      "name": "SecretKey",
      "type": "Fly.SecretKey",
      "file": "packages/alchemy/src/Fly/SecretKey.ts",
      "status": "missing",
      "priority": 3,
      "testability": "yes",
      "scope": "app",
      "parent": "Fly.App",
      "replaces": ["app", "name", "type"],
      "ops": {
        "observe": "secretkeyGet",
        "ensure": "secretkeyGenerate | secretkeySet",
        "sync": "secretkeySet when value changes",
        "delete": "secretkeyDelete",
        "list": "secretkeysList on owned Apps"
      }
    },
    {
      "name": "Service",
      "type": "Fly.Service",
      "file": "packages/alchemy/src/Fly/Service.ts",
      "status": "missing",
      "priority": 2,
      "testability": "yes",
      "scope": "app",
      "parent": "Fly.App",
      "kind": "Platform",
      "replaces": ["app", "name", "region"],
      "updates": ["main hash → rebuild/push/machinesUpdate", "guest", "env", "port", "services", "mounts"],
      "ops": {
        "observe": "machinesShow",
        "ensure": "bundle + docker build + appCreateDeployToken + push registry.fly.io + machinesCreate",
        "sync": "machinesUpdate",
        "wait": "machinesWait",
        "delete": "machinesDelete + machinesWait destroyed",
        "list": "machinesList on owned Apps, metadata alchemy.type=Fly.Service"
      },
      "notes": "Requires Docker at deploy time. Raw Machine tests must not."
    }
  ],
  "bindings": [
    {
      "name": "MountVolume",
      "type": "Fly.MountVolume",
      "file": "packages/alchemy/src/Fly/MountVolume.ts",
      "status": "missing",
      "hosts": ["Fly.Machine", "Fly.Service"],
      "contract": { "mounts": [{ "volume": "string", "path": "string" }] },
      "call": "yield* Fly.MountVolume(volume, { path })"
    },
    {
      "name": "SecretRead",
      "type": "Fly.SecretRead",
      "bindAlias": "ReadSecret",
      "file": "packages/alchemy/src/Fly/SecretRead.ts",
      "layer": "packages/alchemy/src/Fly/SecretReadHttp.ts",
      "status": "missing",
      "impl": "HTTP",
      "ops": ["secretGet"]
    },
    {
      "name": "SecretWrite",
      "type": "Fly.SecretWrite",
      "bindAlias": "WriteSecret",
      "file": "packages/alchemy/src/Fly/SecretWrite.ts",
      "layer": "packages/alchemy/src/Fly/SecretWriteHttp.ts",
      "status": "missing",
      "impl": "HTTP",
      "ops": ["secretCreate", "secretDelete"]
    },
    {
      "name": "SecretReadWrite",
      "type": "Fly.SecretReadWrite",
      "bindAlias": "ReadWriteSecret",
      "file": "packages/alchemy/src/Fly/SecretReadWrite.ts",
      "layer": "packages/alchemy/src/Fly/SecretReadWriteHttp.ts",
      "status": "missing",
      "impl": "HTTP",
      "ops": ["secretGet", "secretCreate", "secretDelete"],
      "notes": "Client extends Read + Write. SecretHttp.ts is shared scaffolding and is NOT exported from index."
    }
  ],
  "outOfScope": [
    { "id": "leases", "ops": ["machinesCreateLease", "machinesShowLease", "machinesReleaseLease"], "why": "orchestration locks, not desired-state IaC" },
    { "id": "metadata-as-resource", "ops": ["machinesDeleteMetadata"], "why": "metadata is stamped on Machine config, not a resource" },
    { "id": "exec-signal-cordon", "ops": ["machinesExec", "machinesSignal", "machinesCordon", "machinesUncordon"], "why": "runtime process/proxy control, not IaC" },
    { "id": "suspend-memory", "ops": ["machinesSuspend", "machinesGetMemory", "machinesSetMemoryLimit", "machinesReclaimMemory"], "why": "runtime machine internals" },
    { "id": "observability", "ops": ["machinesListEvents", "machinesListProcesses", "machinesListVersions"], "why": "not desired state" },
    { "id": "org-unfiltered-list", "ops": ["machinesOrgList", "volumesOrgList"], "why": "unfiltered org dumps; forbidden for list()/nuke" },
    { "id": "tokens-auth-oidc", "ops": ["tokensAuthenticate", "tokensAuthorize", "tokensRequestKms", "tokensRequestOIDC"], "why": "authenticate/authorize/OIDC/KMS, not resources" },
    { "id": "platform-helpers", "ops": ["platformPlacementsPost", "platformRegionsGet"], "why": "capacity helpers, not resources" },
    { "id": "secretkey-crypto", "ops": ["secretkeyEncrypt", "secretkeyDecrypt", "secretkeySign", "secretkeyVerify"], "why": "runtime crypto; not v1 bindings" },
    { "id": "graphql-managed-data", "ops": [], "why": "GraphQL-only Postgres/Redis/Consul (fly postgres etc.) are not in distilled Machines API" },
    { "id": "machinesUpdateMetadata2", "ops": ["machinesUpdateMetadata2"], "why": "duplicate of machinesUpdateMetadata; do not call" }
  ],
  "helpersNotResources": [
    "currentTokenShow",
    "machinesWait",
    "machinesStart",
    "machinesStop",
    "machinesRestart",
    "machinesShowMetadata",
    "machinesUpsertMetadata",
    "machinesUpdateMetadata",
    "machinesGetMetadataKey",
    "appCreateDeployToken",
    "secretsUpdate"
  ],
  "sharedFiles": {
    "insertions": [
      "packages/alchemy/src/Fly/Providers.ts",
      "packages/alchemy/src/Fly/index.ts"
    ],
    "coordinatorOwned": [
      "packages/alchemy/package.json exports ./Fly",
      "packages/alchemy dependency @distilled.cloud/fly-io"
    ]
  },
  "nukeDependsOn": {
    "Fly.Machine": ["Fly.App"],
    "Fly.Service": ["Fly.App"],
    "Fly.Volume": ["Fly.Machine", "Fly.Service"],
    "Fly.VolumeSnapshot": ["Fly.Volume"],
    "Fly.Certificate": ["Fly.App"],
    "Fly.IpAssignment": ["Fly.App"],
    "Fly.Secret": ["Fly.App"],
    "Fly.SecretKey": ["Fly.App"]
  },
  "test": {
    "command": "timeout 240 doppler run --project alchemy-v2 --config dev -- pnpm test test/Fly/<Resource>.test.ts --profile testing --retry 0",
    "perTestTimeoutMs": [90000, 120000],
    "require": [
      "test.provider",
      "stack.destroy() at start and end",
      "deterministic names",
      "out-of-band distilled verify",
      "typed wait-until-gone",
      "replacement where applicable"
    ]
  }
}
