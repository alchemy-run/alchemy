{
  "extends": "../../tsconfig.base.json",
  "include": ["alchemy.run.ts", "vite.config.ts", "src/**/*.ts", "test/**/*.ts"],
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["bun", "vite/client"]
  },
  "references": [
    {
      "path": "../../packages/alchemy/tsconfig.json"
    },
    { "path": "../../packages/azure/tsconfig.json" }
  ]
}
