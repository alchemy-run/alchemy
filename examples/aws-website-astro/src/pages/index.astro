---
// Tailwind is wired through astro.config.ts (@tailwindcss/vite) — Alchemy
// loads the project's own config natively, so the utilities below compile.
import "../styles/global.css";

// Server-rendered on every request inside the AWS Lambda function.
// Environment values declared in alchemy.run.ts are available on
// `process.env`.
const now = new Date().toISOString();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Astro on AWS</title>
  </head>
  <body class="bg-slate-50 p-8 text-slate-900">
    <h1 class="text-3xl font-bold">Astro on AWS</h1>
    <p class="mt-4 text-slate-600">
      This page is server-rendered in an AWS Lambda at {now}.
    </p>
    <p class="mt-2 text-slate-600">
      You are visitor <span id="visits">…</span> — counted by the Effect
      program's <code>/api/visits</code> route (DynamoDB, same Lambda).
    </p>
    <p class="mt-2">
      <a href="/about/" class="text-blue-600 underline">A prerendered page</a>
    </p>
    <script>
      // The effect fetch owns /api/* — this hits the DynamoDB-backed
      // handler declared in src/backend.ts.
      const res = await fetch("/api/visits");
      const { count } = await res.json();
      document.querySelector("#visits")!.textContent = String(count);
    </script>
  </body>
</html>
