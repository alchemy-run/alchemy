---
// Tailwind is wired through astro.config.ts (@tailwindcss/vite) — Alchemy
// loads the project's own config natively, so the utilities below compile.
import "../styles/global.css";

// SSR seam: VALUE import + `createClient(Backend)` — the backend method
// dispatches directly in-process (no HTTP hop) inside the AWS Lambda on
// every request (and in `astro dev` alike).
import { createClient } from "alchemy/client";
import Backend from "../backend.ts";

const backend = createClient(Backend);
const count = await backend.visit();
const now = new Date().toISOString();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Astro on AWS</title>
  </head>
  <body class="bg-slate-50 p-8 text-slate-900">
    <main class="mx-auto max-w-2xl rounded-xl border border-slate-200 bg-white p-8 shadow-sm">
      <h1 class="text-3xl font-bold">Astro on AWS</h1>
      <p class="mt-4 text-slate-600">
        This page is server-rendered in an AWS Lambda at {now}.
      </p>
      <p class="mt-2 text-slate-600">
        You are visitor <span id="visits" class="font-semibold">{count}</span> —
        counted in DynamoDB by the backend's <code>visit</code> method (called
        in-process during SSR).
      </p>
      <button
        id="again"
        class="mt-4 rounded border border-slate-300 px-3 py-1 hover:bg-slate-100"
      >
        Visit again
      </button>
      <p class="mt-4">
        <a href="/about/" class="text-blue-600 underline">A prerendered page</a>
      </p>
    </main>
    <script>
      // Browser side: TYPE-ONLY import + type-only form — zero backend
      // bytes in the client bundle. Each call POSTs the wire protocol
      // (`/api/__rpc/visit`) to the same Lambda.
      import { createClient } from "alchemy/client";
      import type Backend from "../backend.ts";

      const backend = createClient<typeof Backend>();
      document.querySelector("#again")!.addEventListener("click", async () => {
        const count = await backend.visit();
        document.querySelector("#visits")!.textContent = String(count);
      });
    </script>
  </body>
</html>
