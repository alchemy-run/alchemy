---
// Tailwind is wired through astro.config.ts (@tailwindcss/vite) — Alchemy
// loads the project's own config natively, so the utilities below compile.
import "../styles/global.css";

// SSR seam: VALUE import + `createClient(Backend)` — the backend methods
// dispatch directly in-process (no HTTP hop) inside the AWS Lambda on
// every request (and in `astro dev` alike). Browser interactivity lives
// in the React island, which talks to the same backend through Astro
// Actions (src/actions/index.ts).
import { createClient } from "alchemy/Client";
import Backend from "../backend.ts";
import VisitsCard from "../components/VisitsCard";

const backend = createClient(Backend, { headers: Astro.request.headers });
const visits = await backend.visits();
const processed = await backend.processed();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Astro on AWS</title>
  </head>
  <body class="bg-slate-50 p-8 text-slate-900">
    <main class="mx-auto max-w-2xl">
      <h1 class="text-3xl font-bold">Astro on AWS</h1>
      <VisitsCard
        client:load
        initialVisits={visits}
        initialProcessed={processed}
      />
      <p class="mt-6">
        <a href="/about/" class="text-blue-600 underline">A prerendered page</a>
      </p>
    </main>
  </body>
</html>
