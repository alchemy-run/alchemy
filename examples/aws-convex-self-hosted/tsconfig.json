{
  "extends": "../../tsconfig.base.json",
  "include": ["alchemy.run.ts", "stacks", "convex", "src", "vite.config.ts"],
  "exclude": ["convex/_generated"],
  "compilerOptions": {
    "rootDir": ".",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["bun", "vite/client", "node"]
  },
  "references": [
    { "path": "../../packages/alchemy/tsconfig.json" },
    { "path": "../../packages/aws/tsconfig.json" },
    { "path": "../../packages/convex/tsconfig.json" }
  ]
}
