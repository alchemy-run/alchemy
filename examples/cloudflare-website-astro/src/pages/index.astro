---
// Tailwind is wired through astro.config.ts (@tailwindcss/vite) — Alchemy
// loads the project's own config natively, so the utilities below compile.
import "../styles/global.css";
import { createClient } from "alchemy/client";
import Backend from "../backend";

// Server-rendered on every request inside the Cloudflare Worker. The VALUE
// form dispatches the backend method in-process — no HTTP hop.
const backend = createClient(Backend, { headers: Astro.request.headers });
const visits = await backend.visits();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Astro on Cloudflare</title>
  </head>
  <body class="bg-slate-50 p-8 text-slate-900">
    <main class="mx-auto max-w-2xl">
      <h1 class="text-3xl font-bold">Astro on Cloudflare Workers</h1>
      <div class="mt-6 max-w-md rounded-xl border border-slate-300 bg-white p-6 shadow-sm">
        <p class="m-0 text-sm text-gray-500">
          Server-rendered visits: <span data-testid="count">{visits}</span>
        </p>
        <button
          id="bump"
          class="mt-4 cursor-pointer rounded-lg border-none bg-slate-900 px-4 py-2 text-white"
        >
          Bump visits
        </button>
        <p id="bumped" class="mt-4 hidden text-sm" data-testid="bumped"></p>
      </div>
      <p class="mt-6">
        <a href="/about/" class="text-blue-600 underline">A prerendered page</a>
      </p>
    </main>
    <script>
      // The TYPE-ONLY form: zero backend bytes in the browser bundle —
      // methods POST to /api/__rpc/<method> on this same Worker.
      import { createClient } from "alchemy/client";
      import type Backend from "../backend";

      const backend = createClient<typeof Backend>();
      const bumped = document.getElementById("bumped");
      document.getElementById("bump")?.addEventListener("click", async () => {
        const value = await backend.bump();
        if (bumped) {
          bumped.textContent = `Client bump → ${value}`;
          bumped.classList.remove("hidden");
        }
      });
    </script>
  </body>
</html>
