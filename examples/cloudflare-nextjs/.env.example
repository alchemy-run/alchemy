# Required for `bun run deploy`. Create a Cloudflare API token with at
# least the following scopes:
#
#   - Workers Scripts:    Edit
#   - Workers Routes:     Edit
#   - Account Settings:   Read
#   - User Details:       Read
#   - Zone:               Read   (only if you bind a custom domain)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
