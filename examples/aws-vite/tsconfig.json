{
  "extends": "../../tsconfig.base.json",
  "include": [
    "alchemy.run.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    "vite.config.ts"
  ],
  "compilerOptions": {
    "noEmit": true,
    // TODO(sam): remove this once we have a proper implementation
    "noCheck": true,
    "rootDir": ".",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "target": "ESNext",
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vite/client"]
  },
  "references": [
    {
      "path": "../../packages/alchemy/tsconfig.json"
    }
  ]
}
