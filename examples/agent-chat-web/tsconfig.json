{
  "extends": "../../tsconfig.base.json",
  "include": ["server.ts", "vite.config.ts", "src/**/*.ts", "src/**/*.tsx"],
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "target": "ESNext",
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2023"]
  }
}
