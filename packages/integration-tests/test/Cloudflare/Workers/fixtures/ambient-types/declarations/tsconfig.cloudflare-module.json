{
  // Checks the emitted `lib/*.d.ts` of alchemy and @alchemy.run/cloudflare,
  // the files the published packages serve to TypeScript, not their `src`
  // (#3119). Loads no workerd globals, so `raw` falls back to the module
  // export.
  "extends": "../../../../../../../../tsconfig.base.json",
  "include": ["cloudflare-module.ts"],
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "target": "ESNext",
    "lib": ["ES2023", "DOM"],
    "types": [],
    "paths": {
      "alchemy/*": ["../../../../../../../alchemy/lib/*.d.ts"],
      "@alchemy.run/cloudflare": ["../../../../../../../cloudflare/lib/index.d.ts"]
    }
  },
  "references": [
    { "path": "../../../../../../../alchemy/tsconfig.json" },
    { "path": "../../../../../../../cloudflare/tsconfig.json" }
  ]
}
