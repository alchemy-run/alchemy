{
  "name": "@alchemy.run/archil",
  "version": "2.0.0-beta.87",
  "description": "Archil disks, sandboxes, images and mounts for Alchemy.",
  "keywords": [
    "alchemy",
    "archil",
    "effect",
    "filesystem",
    "infrastructure-as-code",
    "sandbox"
  ],
  "homepage": "https://alchemy.run",
  "bugs": {
    "url": "https://github.com/alchemy-run/alchemy/issues"
  },
  "license": "Apache-2.0",
  "author": "Sam Goodwin <sam@alchemy.run>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alchemy-run/alchemy.git",
    "directory": "packages/archil"
  },
  "files": [
    "lib",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./Bootstrap": "./src/Bootstrap.ts",
    "./AWS": "./src/AWS/index.ts",
    "./*": "./src/*.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "bun": "./src/index.ts",
        "worker": "./src/index.ts",
        "default": "./lib/index.js"
      },
      "./Bootstrap": {
        "types": "./src/Bootstrap.ts",
        "bun": "./src/Bootstrap.ts",
        "default": "./src/Bootstrap.ts"
      },
      "./AWS": {
        "types": "./lib/AWS/index.d.ts",
        "bun": "./src/AWS/index.ts",
        "worker": "./src/AWS/index.ts",
        "default": "./lib/AWS/index.js"
      },
      "./internal/*": null,
      "./*": {
        "types": "./lib/*.d.ts",
        "bun": "./src/*.ts",
        "worker": "./src/*.ts",
        "default": "./lib/*.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "pnpm -r --filter \"{.}...\" run build:package",
    "build:package": "node scripts/build.ts"
  },
  "dependencies": {
    "@alchemy.run/docker": "workspace:*",
    "@distilled.cloud/archil": "workspace:*",
    "@distilled.cloud/core": "workspace:*",
    "rolldown": "catalog:"
  },
  "devDependencies": {
    "@alchemy.run/aws": "workspace:*",
    "@effect/platform-node": "catalog:",
    "@types/bun": "catalog:",
    "alchemy": "workspace:*",
    "effect": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@alchemy.run/aws": "workspace:*",
    "@effect/platform-node": "catalog:",
    "alchemy": "workspace:*",
    "effect": "catalog:"
  },
  "peerDependenciesMeta": {
    "@alchemy.run/aws": {
      "optional": true
    },
    "@effect/platform-node": {
      "optional": true
    }
  },
  "alchemy": {
    "contributes": [
      "@alchemy.run/archil/Contributions"
    ]
  }
}
