{
  "tag": "AWS.CloudTrail",
  "module": "cloudtrail",
  "resources": {
    "EventDataStore": {
      "file": "EventDataStore.ts"
    }
  },
  "builder": "makeCloudTrailEventDataStoreHttpBinding",
  "builders": {
    "makeCloudTrailAccountHttpBinding": {
      "grants": "*",
      "arns": true
    },
    "makeCloudTrailEventDataStoreHttpBinding": {
      "grants": "resource"
    }
  },
  "bindings": {
    "CancelQuery": {
      "operation": "cancelQuery",
      "resource": "EventDataStore",
      "param": "store",
      "request": {
        "mode": "required",
        "omit": ["EventDataStore"],
        "inline": true
      },
      "actions": ["cloudtrail:CancelQuery"]
    },
    "DescribeQuery": {
      "operation": "describeQuery",
      "resource": "EventDataStore",
      "param": "store",
      "request": {
        "mode": "required",
        "omit": ["EventDataStore"],
        "inline": true
      },
      "actions": ["cloudtrail:DescribeQuery"]
    },
    "GenerateQuery": {
      "operation": "generateQuery",
      "resource": "EventDataStore",
      "param": "store",
      "request": {
        "mode": "required",
        "omit": ["EventDataStores"],
        "inline": true
      },
      "actions": ["cloudtrail:GenerateQuery"],
      "with": {
        "injectEventDataStores": true
      }
    },
    "GetQueryResults": {
      "operation": "getQueryResults",
      "resource": "EventDataStore",
      "param": "store",
      "request": {
        "mode": "required",
        "omit": ["EventDataStore"],
        "inline": true
      },
      "actions": ["cloudtrail:GetQueryResults"]
    },
    "ListInsightsData": {
      "operation": "listInsightsData",
      "request": {
        "mode": "required"
      },
      "builder": "makeCloudTrailAccountHttpBinding",
      "actions": ["cloudtrail:ListInsightsData"],
      "arns": ["arn:${Partition}:cloudtrail:${Region}:${Account}:trail/*"]
    },
    "ListInsightsMetricData": {
      "operation": "listInsightsMetricData",
      "request": {
        "mode": "required"
      },
      "builder": "makeCloudTrailAccountHttpBinding",
      "actions": ["cloudtrail:ListInsightsMetricData"],
      "reviewed": {
        "cloudtrail:ListInsightsMetricData": "Not in AWS's reference, but the call is authorized live with it (CloudTrail Bindings suite).",
        "cloudtrail:ListInsightsData": "AWS lists it for the operation, but the CloudTrail Bindings suite calls it successfully without it.",
        "cloudtrail:LookupEvents": "AWS lists it for the operation, but the CloudTrail Bindings suite calls it successfully without it."
      }
    },
    "ListPublicKeys": {
      "operation": "listPublicKeys",
      "builder": "makeCloudTrailAccountHttpBinding",
      "actions": ["cloudtrail:ListPublicKeys"]
    },
    "ListQueries": {
      "operation": "listQueries",
      "resource": "EventDataStore",
      "param": "store",
      "request": {
        "mode": "optional",
        "omit": ["EventDataStore"],
        "inline": true
      },
      "actions": ["cloudtrail:ListQueries"],
      "with": {
        "injectEventDataStore": true
      }
    },
    "LookupEvents": {
      "operation": "lookupEvents",
      "builder": "makeCloudTrailAccountHttpBinding",
      "actions": ["cloudtrail:LookupEvents"]
    }
  }
}
