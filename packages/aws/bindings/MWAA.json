{
  "tag": "AWS.MWAA",
  "module": "mwaa",
  "resources": {
    "Environment": {
      "file": "Environment.ts"
    }
  },
  "builder": "makeMWAAEnvironmentHttpBinding",
  "builders": {
    "makeMWAAEnvironmentHttpBinding": {
      "grants": "resource"
    }
  },
  "bindings": {
    "CreateCliToken": {
      "operation": "createCliToken",
      "resource": "Environment",
      "request": {
        "mode": "none"
      }
    },
    "GetEnvironment": {
      "operation": "getEnvironment",
      "resource": "Environment",
      "request": {
        "mode": "none"
      }
    }
  }
}
