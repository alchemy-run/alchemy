{
  "tag": "AWS.ACM",
  "module": "acm",
  "resources": {
    "Certificate": {
      "file": "Certificate.ts"
    }
  },
  "builder": "makeAcmCertificateHttpBinding",
  "builders": {
    "makeAcmAccountHttpBinding": {
      "options": {
        "capability": "name",
        "iamActions": "actions",
        "operation": "operation"
      },
      "grants": "*"
    },
    "makeAcmCertificateHttpBinding": {
      "options": {
        "capability": "name",
        "iamActions": "actions",
        "operation": "operation"
      }
    }
  },
  "bindings": {
    "DescribeCertificate": {
      "operation": "describeCertificate",
      "resource": "Certificate",
      "request": {
        "mode": "none"
      }
    },
    "ExportCertificate": {
      "operation": "exportCertificate",
      "resource": "Certificate",
      "request": {
        "mode": "required",
        "interface": "ExportCertificateRequest",
        "omit": ["CertificateArn"]
      }
    },
    "GetCertificate": {
      "operation": "getCertificate",
      "resource": "Certificate",
      "request": {
        "mode": "none"
      }
    },
    "ImportCertificate": {
      "operation": "importCertificate",
      "request": {
        "mode": "required",
        "interface": "ImportCertificateRequest",
        "omit": []
      },
      "builder": "makeAcmAccountHttpBinding",
      "note": "Importing with `Tags` additionally requires `acm:AddTagsToCertificate`, which ACM checks alongside the import itself."
    },
    "ListCertificates": {
      "operation": "listCertificates",
      "request": {
        "mode": "optional",
        "interface": "ListCertificatesRequest",
        "omit": []
      },
      "builder": "makeAcmAccountHttpBinding"
    },
    "RenewCertificate": {
      "operation": "renewCertificate",
      "resource": "Certificate",
      "request": {
        "mode": "none"
      }
    },
    "ResendValidationEmail": {
      "operation": "resendValidationEmail",
      "resource": "Certificate",
      "request": {
        "mode": "required",
        "interface": "ResendValidationEmailRequest",
        "omit": ["CertificateArn"]
      }
    },
    "RevokeCertificate": {
      "operation": "revokeCertificate",
      "resource": "Certificate",
      "request": {
        "mode": "required",
        "interface": "RevokeCertificateRequest",
        "omit": ["CertificateArn"]
      }
    },
    "SearchCertificates": {
      "operation": "searchCertificates",
      "request": {
        "mode": "optional",
        "interface": "SearchCertificatesRequest",
        "omit": []
      },
      "builder": "makeAcmAccountHttpBinding"
    }
  }
}
