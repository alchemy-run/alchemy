{
  "tag": "AWS.Translate",
  "module": "translate",
  "resources": {},
  "builder": "makeTranslateHttpBinding",
  "builders": {
    "makeTranslateHttpBinding": {
      "grants": "*"
    }
  },
  "bindings": {
    "DescribeTextTranslationJob": {
      "operation": "describeTextTranslationJob",
      "request": {
        "mode": "required"
      },
      "actions": ["translate:DescribeTextTranslationJob"]
    },
    "GetParallelData": {
      "operation": "getParallelData",
      "request": {
        "mode": "required"
      },
      "actions": ["translate:GetParallelData"]
    },
    "GetTerminology": {
      "operation": "getTerminology",
      "request": {
        "mode": "required"
      },
      "actions": ["translate:GetTerminology"]
    },
    "ListLanguages": {
      "operation": "listLanguages",
      "actions": ["translate:ListLanguages"]
    },
    "ListParallelData": {
      "operation": "listParallelData",
      "actions": ["translate:ListParallelData"]
    },
    "ListTerminologies": {
      "operation": "listTerminologies",
      "actions": ["translate:ListTerminologies"]
    },
    "ListTextTranslationJobs": {
      "operation": "listTextTranslationJobs",
      "actions": ["translate:ListTextTranslationJobs"]
    },
    "StopTextTranslationJob": {
      "operation": "stopTextTranslationJob",
      "request": {
        "mode": "required"
      },
      "actions": ["translate:StopTextTranslationJob"]
    },
    "TranslateDocument": {
      "operation": "translateDocument",
      "request": {
        "mode": "required"
      },
      "actions": ["translate:TranslateDocument"]
    },
    "TranslateText": {
      "operation": "translateText",
      "request": {
        "mode": "required"
      },
      "actions": ["translate:TranslateText"]
    }
  }
}
