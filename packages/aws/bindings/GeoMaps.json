{
  "tag": "AWS.GeoMaps",
  "module": "geo-maps",
  "alias": "geoMaps",
  "resources": {},
  "builder": "makeGeoMapsHttpBinding",
  "builders": {
    "makeGeoMapsHttpBinding": {
      "options": {
        "capability": "name",
        "iamActions": "actions",
        "operation": "operation"
      },
      "grants": "*",
      "arns": true
    }
  },
  "bindings": {
    "GetGlyphs": {
      "operation": "getGlyphs",
      "request": {
        "mode": "required"
      },
      "actions": ["geo-maps:GetGlyphs"]
    },
    "GetSprites": {
      "operation": "getSprites",
      "request": {
        "mode": "required"
      },
      "actions": ["geo-maps:GetSprites"]
    },
    "GetStaticMap": {
      "operation": "getStaticMap",
      "request": {
        "mode": "required"
      },
      "actions": ["geo-maps:GetStaticMap"],
      "arns": ["arn:${Partition}:geo-maps:${Region}::provider/default"]
    },
    "GetStyleDescriptor": {
      "operation": "getStyleDescriptor",
      "request": {
        "mode": "required"
      },
      "actions": ["geo-maps:GetStyleDescriptor"]
    },
    "GetTile": {
      "operation": "getTile",
      "request": {
        "mode": "required"
      },
      "actions": ["geo-maps:GetTile"],
      "arns": ["arn:${Partition}:geo-maps:${Region}::provider/default"]
    }
  }
}
