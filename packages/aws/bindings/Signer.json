{
  "tag": "AWS.Signer",
  "module": "signer",
  "resources": {
    "SigningProfile": {
      "file": "SigningProfile.ts"
    }
  },
  "builder": "makeSignerHttpBinding",
  "builders": {
    "makeSignerHttpBinding": {
      "grants": "*",
      "arns": true
    },
    "makeSignerProfileHttpBinding": {
      "grants": "resource"
    }
  },
  "bindings": {
    "DescribeSigningJob": {
      "operation": "describeSigningJob",
      "request": {
        "mode": "required"
      },
      "actions": ["signer:DescribeSigningJob"],
      "arns": ["arn:${Partition}:signer:${Region}:${Account}:/signing-jobs/*"]
    },
    "GetRevocationStatus": {
      "operation": "getRevocationStatus",
      "request": {
        "mode": "required"
      },
      "actions": ["signer:GetRevocationStatus"],
      "arns": [
        "arn:${Partition}:signer:${Region}:${Account}:/signing-jobs/*",
        "arn:${Partition}:signer:${Region}:${Account}:/signing-profiles/*"
      ]
    },
    "GetSigningPlatform": {
      "operation": "getSigningPlatform",
      "request": {
        "mode": "required"
      },
      "actions": ["signer:GetSigningPlatform"]
    },
    "ListSigningJobs": {
      "operation": "listSigningJobs",
      "actions": ["signer:ListSigningJobs"]
    },
    "ListSigningPlatforms": {
      "operation": "listSigningPlatforms",
      "actions": ["signer:ListSigningPlatforms"]
    },
    "RevokeSignature": {
      "operation": "revokeSignature",
      "request": {
        "mode": "required"
      },
      "actions": ["signer:RevokeSignature"],
      "arns": ["arn:${Partition}:signer:${Region}:${Account}:/signing-jobs/*"]
    },
    "RevokeSigningProfile": {
      "operation": "revokeSigningProfile",
      "resource": "SigningProfile",
      "param": "profile",
      "request": {
        "mode": "required",
        "omit": ["profileName"],
        "inline": true
      },
      "builder": "makeSignerProfileHttpBinding",
      "actions": ["signer:RevokeSigningProfile"]
    },
    "SignPayload": {
      "operation": "signPayload",
      "resource": "SigningProfile",
      "param": "profile",
      "request": {
        "mode": "required",
        "omit": ["profileName"],
        "inline": true
      },
      "builder": "makeSignerProfileHttpBinding",
      "actions": ["signer:SignPayload"]
    },
    "StartSigningJob": {
      "operation": "startSigningJob",
      "resource": "SigningProfile",
      "param": "profile",
      "request": {
        "mode": "required",
        "omit": ["profileName"],
        "inline": true
      },
      "builder": "makeSignerProfileHttpBinding",
      "actions": ["signer:StartSigningJob"]
    }
  }
}
