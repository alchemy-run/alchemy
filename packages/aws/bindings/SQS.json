{
  "tag": "AWS.SQS",
  "module": "sqs",
  "resources": {
    "Queue": {
      "file": "Queue.ts"
    }
  },
  "builder": "makeQueueUrlHttpBinding",
  "builders": {
    "makeQueueArnHttpBinding": {},
    "makeQueueGrantHttpBinding": {},
    "makeQueueUrlHttpBinding": {}
  },
  "bindings": {
    "CancelMessageMoveTask": {
      "operation": "cancelMessageMoveTask",
      "resource": "Queue",
      "request": {
        "mode": "required",
        "interface": "CancelMessageMoveTaskRequest",
        "omit": []
      },
      "builder": "makeQueueGrantHttpBinding",
      "note": "The request identifies the task by `TaskHandle` only; the bound queue exists purely to scope the IAM grant to the redrive source."
    },
    "ChangeMessageVisibility": {
      "operation": "changeMessageVisibility",
      "resource": "Queue",
      "request": {
        "mode": "required",
        "interface": "ChangeMessageVisibilityRequest",
        "omit": ["QueueUrl"]
      }
    },
    "ChangeMessageVisibilityBatch": {
      "operation": "changeMessageVisibilityBatch",
      "resource": "Queue",
      "request": {
        "mode": "required",
        "interface": "ChangeMessageVisibilityBatchRequest",
        "omit": ["QueueUrl"]
      },
      "note": "Batch entries are authorized by the singular action."
    },
    "DeleteMessage": {
      "operation": "deleteMessage",
      "resource": "Queue",
      "request": {
        "mode": "required",
        "interface": "DeleteMessageRequest",
        "omit": ["QueueUrl"]
      }
    },
    "DeleteMessageBatch": {
      "operation": "deleteMessageBatch",
      "resource": "Queue",
      "request": {
        "mode": "required",
        "interface": "DeleteMessageBatchRequest",
        "omit": ["QueueUrl"]
      },
      "note": "Batch entries are authorized by the singular action."
    },
    "GetQueueAttributes": {
      "operation": "getQueueAttributes",
      "resource": "Queue",
      "request": {
        "mode": "optional",
        "interface": "GetQueueAttributesRequest",
        "omit": ["QueueUrl"]
      }
    },
    "ListDeadLetterSourceQueues": {
      "operation": "listDeadLetterSourceQueues",
      "resource": "Queue",
      "request": {
        "mode": "optional",
        "interface": "ListDeadLetterSourceQueuesRequest",
        "omit": ["QueueUrl"]
      }
    },
    "ListMessageMoveTasks": {
      "operation": "listMessageMoveTasks",
      "resource": "Queue",
      "request": {
        "mode": "optional",
        "interface": "ListMessageMoveTasksRequest",
        "omit": ["SourceArn"]
      },
      "builder": "makeQueueArnHttpBinding"
    },
    "PurgeQueue": {
      "operation": "purgeQueue",
      "resource": "Queue",
      "request": {
        "mode": "none"
      }
    },
    "ReceiveMessage": {
      "operation": "receiveMessage",
      "resource": "Queue",
      "request": {
        "mode": "required",
        "interface": "ReceiveMessageRequest",
        "omit": ["QueueUrl"]
      }
    },
    "SendMessage": {
      "operation": "sendMessage",
      "resource": "Queue",
      "request": {
        "mode": "required",
        "interface": "SendMessageRequest",
        "omit": ["QueueUrl"]
      }
    },
    "SendMessageBatch": {
      "operation": "sendMessageBatch",
      "resource": "Queue",
      "request": {
        "mode": "required",
        "interface": "SendMessageBatchRequest",
        "omit": ["QueueUrl"]
      },
      "note": "Batch entries are authorized by the singular action."
    }
  }
}
