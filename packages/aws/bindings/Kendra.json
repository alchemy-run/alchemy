{
  "tag": "AWS.Kendra",
  "module": "kendra",
  "resources": {
    "DataSource": {
      "file": "DataSource.ts"
    },
    "Index": {
      "file": "SearchIndex.ts"
    }
  },
  "builder": "makeKendraIndexHttpBinding",
  "builders": {
    "makeKendraDataSourceHttpBinding": {
      "grants": "resource"
    },
    "makeKendraIndexHttpBinding": {
      "grants": "resource"
    }
  },
  "bindings": {
    "BatchDeleteDocument": {
      "operation": "batchDeleteDocument",
      "resource": "Index",
      "request": {
        "mode": "required",
        "interface": "BatchDeleteDocumentRequest",
        "omit": ["IndexId"]
      }
    },
    "BatchGetDocumentStatus": {
      "operation": "batchGetDocumentStatus",
      "resource": "Index",
      "request": {
        "mode": "required",
        "interface": "BatchGetDocumentStatusRequest",
        "omit": ["IndexId"]
      }
    },
    "BatchPutDocument": {
      "operation": "batchPutDocument",
      "resource": "Index",
      "request": {
        "mode": "required",
        "interface": "BatchPutDocumentRequest",
        "omit": ["IndexId"]
      }
    },
    "ClearQuerySuggestions": {
      "operation": "clearQuerySuggestions",
      "resource": "Index",
      "request": {
        "mode": "none"
      }
    },
    "CreateAccessControlConfiguration": {
      "operation": "createAccessControlConfiguration",
      "resource": "Index",
      "request": {
        "mode": "required",
        "interface": "CreateAccessControlConfigurationRequest",
        "omit": ["IndexId"]
      },
      "with": {
        "subResources": ["access-control-configuration/*"]
      }
    },
    "DeleteAccessControlConfiguration": {
      "operation": "deleteAccessControlConfiguration",
      "resource": "Index",
      "request": {
        "mode": "required",
        "interface": "DeleteAccessControlConfigurationRequest",
        "omit": ["IndexId"]
      },
      "with": {
        "subResources": ["access-control-configuration/*"]
      }
    },
    "DeletePrincipalMapping": {
      "operation": "deletePrincipalMapping",
      "resource": "Index",
      "request": {
        "mode": "required",
        "interface": "DeletePrincipalMappingRequest",
        "omit": ["IndexId"]
      },
      "with": {
        "subResources": ["data-source/*"]
      }
    },
    "DescribeAccessControlConfiguration": {
      "operation": "describeAccessControlConfiguration",
      "resource": "Index",
      "request": {
        "mode": "required",
        "interface": "DescribeAccessControlConfigurationRequest",
        "omit": ["IndexId"]
      },
      "with": {
        "subResources": ["access-control-configuration/*"]
      }
    },
    "DescribePrincipalMapping": {
      "operation": "describePrincipalMapping",
      "resource": "Index",
      "request": {
        "mode": "required",
        "interface": "DescribePrincipalMappingRequest",
        "omit": ["IndexId"]
      },
      "with": {
        "subResources": ["data-source/*"]
      }
    },
    "DescribeQuerySuggestionsConfig": {
      "operation": "describeQuerySuggestionsConfig",
      "resource": "Index",
      "request": {
        "mode": "none"
      }
    },
    "GetQuerySuggestions": {
      "operation": "getQuerySuggestions",
      "resource": "Index",
      "request": {
        "mode": "required",
        "interface": "GetQuerySuggestionsRequest",
        "omit": ["IndexId"]
      }
    },
    "GetSnapshots": {
      "operation": "getSnapshots",
      "resource": "Index",
      "request": {
        "mode": "required",
        "interface": "GetSnapshotsRequest",
        "omit": ["IndexId"]
      }
    },
    "ListAccessControlConfigurations": {
      "operation": "listAccessControlConfigurations",
      "resource": "Index",
      "request": {
        "mode": "optional",
        "interface": "ListAccessControlConfigurationsRequest",
        "omit": ["IndexId"]
      }
    },
    "ListDataSourceSyncJobs": {
      "operation": "listDataSourceSyncJobs",
      "resource": "DataSource",
      "request": {
        "mode": "optional",
        "interface": "ListDataSourceSyncJobsRequest",
        "omit": ["Id", "IndexId"]
      },
      "builder": "makeKendraDataSourceHttpBinding"
    },
    "ListGroupsOlderThanOrderingId": {
      "operation": "listGroupsOlderThanOrderingId",
      "resource": "Index",
      "request": {
        "mode": "required",
        "interface": "ListGroupsOlderThanOrderingIdRequest",
        "omit": ["IndexId"]
      },
      "with": {
        "subResources": ["data-source/*"]
      }
    },
    "PutPrincipalMapping": {
      "operation": "putPrincipalMapping",
      "resource": "Index",
      "request": {
        "mode": "required",
        "interface": "PutPrincipalMappingRequest",
        "omit": ["IndexId"]
      },
      "with": {
        "subResources": ["data-source/*"]
      }
    },
    "Query": {
      "operation": "query",
      "resource": "Index",
      "request": {
        "mode": "optional",
        "interface": "QueryRequest",
        "omit": ["IndexId"]
      }
    },
    "Retrieve": {
      "operation": "retrieve",
      "resource": "Index",
      "request": {
        "mode": "required",
        "interface": "RetrieveRequest",
        "omit": ["IndexId"]
      }
    },
    "StartDataSourceSyncJob": {
      "operation": "startDataSourceSyncJob",
      "resource": "DataSource",
      "request": {
        "mode": "none"
      },
      "builder": "makeKendraDataSourceHttpBinding"
    },
    "StopDataSourceSyncJob": {
      "operation": "stopDataSourceSyncJob",
      "resource": "DataSource",
      "request": {
        "mode": "none"
      },
      "builder": "makeKendraDataSourceHttpBinding"
    },
    "SubmitFeedback": {
      "operation": "submitFeedback",
      "resource": "Index",
      "request": {
        "mode": "required",
        "interface": "SubmitFeedbackRequest",
        "omit": ["IndexId"]
      }
    },
    "UpdateAccessControlConfiguration": {
      "operation": "updateAccessControlConfiguration",
      "resource": "Index",
      "request": {
        "mode": "required",
        "interface": "UpdateAccessControlConfigurationRequest",
        "omit": ["IndexId"]
      },
      "with": {
        "subResources": ["access-control-configuration/*"]
      }
    }
  }
}
