{
  "tag": "AWS.DataExchange",
  "module": "dataexchange",
  "resources": {
    "DataSet": {
      "file": "DataSet.ts"
    },
    "Revision": {
      "file": "Revision.ts"
    }
  },
  "builder": "makeDataExchangeAccountHttpBinding",
  "builders": {
    "makeDataExchangeAccountHttpBinding": {
      "grants": "*",
      "arns": true
    },
    "makeDataSetHttpBinding": {
      "grants": "resource"
    },
    "makeRevisionHttpBinding": {
      "grants": "resource"
    }
  },
  "bindings": {
    "AcceptDataGrant": {
      "operation": "acceptDataGrant",
      "request": {
        "mode": "required"
      },
      "actions": ["dataexchange:AcceptDataGrant"],
      "reviewed": {
        "aws-marketplace:Subscribe": "Authorized for the data-grant flows that publish or subscribe; not granted unless asked."
      }
    },
    "CancelJob": {
      "operation": "cancelJob",
      "request": {
        "mode": "required"
      },
      "actions": ["dataexchange:CancelJob"]
    },
    "CreateDataGrant": {
      "operation": "createDataGrant",
      "request": {
        "mode": "required"
      },
      "actions": ["dataexchange:CreateDataGrant"],
      "reviewed": {
        "dataexchange:TagResource": "Needed only when the request sets tags; not granted, since tagging can change tag-based access.",
        "dataexchange:CreateJob": "Authorized for the data-grant flows that publish or subscribe; not granted unless asked.",
        "dataexchange:PublishDataSet": "Authorized for the data-grant flows that publish or subscribe; not granted unless asked.",
        "dataexchange:PublishToDataGrant": "Authorized for the data-grant flows that publish or subscribe; not granted unless asked.",
        "dataexchange:StartJob": "Authorized for the data-grant flows that publish or subscribe; not granted unless asked."
      }
    },
    "CreateJob": {
      "operation": "createJob",
      "request": {
        "mode": "required"
      },
      "actions": ["dataexchange:CreateJob"],
      "unscoped": "Narrowed to AWS's ARN formats (arn:${Partition}:dataexchange:${Region}:${Account}:jobs/*), the call was denied live in the DataExchange Bindings suite; the grant stays on *.",
      "reviewed": {
        "iam:PassRole": "Needed only for job types that pass a role; not granted, so a role is never passed unasked."
      }
    },
    "DeleteAsset": {
      "operation": "deleteAsset",
      "resource": "Revision",
      "request": {
        "mode": "required",
        "omit": ["DataSetId", "RevisionId"],
        "inline": true
      },
      "builder": "makeRevisionHttpBinding",
      "actions": ["dataexchange:DeleteAsset"],
      "withTs": {
        "resources": "revisionAssetArns"
      },
      "imports": {
        "./BindingHttp.ts": ["revisionAssetArns"]
      }
    },
    "DeleteDataGrant": {
      "operation": "deleteDataGrant",
      "request": {
        "mode": "required"
      },
      "actions": ["dataexchange:DeleteDataGrant"],
      "reviewed": {
        "dataexchange:CreateJob": "Authorized for the data-grant flows that publish or subscribe; not granted unless asked.",
        "dataexchange:DeleteDataSet": "Authorized for the data-grant flows that publish or subscribe; not granted unless asked.",
        "dataexchange:StartJob": "Authorized for the data-grant flows that publish or subscribe; not granted unless asked."
      }
    },
    "GetAsset": {
      "operation": "getAsset",
      "resource": "Revision",
      "request": {
        "mode": "required",
        "omit": ["DataSetId", "RevisionId"],
        "inline": true
      },
      "builder": "makeRevisionHttpBinding",
      "actions": ["dataexchange:GetAsset"],
      "withTs": {
        "resources": "revisionAssetArns"
      },
      "imports": {
        "./BindingHttp.ts": ["revisionAssetArns"]
      }
    },
    "GetDataGrant": {
      "operation": "getDataGrant",
      "request": {
        "mode": "required"
      },
      "actions": ["dataexchange:GetDataGrant"],
      "reviewed": {
        "dataexchange:GetDataSet": "Authorized for the data-grant flows that publish or subscribe; not granted unless asked."
      }
    },
    "GetDataSet": {
      "operation": "getDataSet",
      "resource": "DataSet",
      "request": {
        "mode": "none"
      },
      "builder": "makeDataSetHttpBinding",
      "actions": ["dataexchange:GetDataSet"]
    },
    "GetJob": {
      "operation": "getJob",
      "request": {
        "mode": "required"
      },
      "actions": ["dataexchange:GetJob"],
      "unscoped": "Narrowed to AWS's ARN formats (arn:${Partition}:dataexchange:${Region}:${Account}:jobs/*), the call was denied live in the DataExchange Bindings suite; the grant stays on *."
    },
    "GetReceivedDataGrant": {
      "operation": "getReceivedDataGrant",
      "request": {
        "mode": "required"
      },
      "actions": ["dataexchange:GetReceivedDataGrant"],
      "reviewed": {
        "dataexchange:GetDataSet": "Authorized for the data-grant flows that publish or subscribe; not granted unless asked."
      }
    },
    "GetRevision": {
      "operation": "getRevision",
      "resource": "Revision",
      "request": {
        "mode": "none"
      },
      "builder": "makeRevisionHttpBinding",
      "actions": ["dataexchange:GetRevision"]
    },
    "ListDataGrants": {
      "operation": "listDataGrants",
      "actions": ["dataexchange:ListDataGrants"],
      "reviewed": {
        "dataexchange:ListDataSets": "AWS lists it for the operation, but the DataExchange Bindings suite calls it successfully without it."
      }
    },
    "ListDataSetRevisions": {
      "operation": "listDataSetRevisions",
      "resource": "DataSet",
      "request": {
        "mode": "optional",
        "omit": ["DataSetId"],
        "inline": true
      },
      "builder": "makeDataSetHttpBinding",
      "actions": ["dataexchange:ListDataSetRevisions"]
    },
    "ListDataSets": {
      "operation": "listDataSets",
      "actions": ["dataexchange:ListDataSets"]
    },
    "ListEventActions": {
      "operation": "listEventActions",
      "actions": ["dataexchange:ListEventActions"]
    },
    "ListJobs": {
      "operation": "listJobs",
      "actions": ["dataexchange:ListJobs"]
    },
    "ListReceivedDataGrants": {
      "operation": "listReceivedDataGrants",
      "actions": ["dataexchange:ListReceivedDataGrants"],
      "reviewed": {
        "dataexchange:ListDataSets": "AWS lists it for the operation, but the DataExchange Bindings suite calls it successfully without it."
      }
    },
    "ListRevisionAssets": {
      "operation": "listRevisionAssets",
      "resource": "Revision",
      "request": {
        "mode": "optional",
        "omit": ["DataSetId", "RevisionId"],
        "inline": true
      },
      "builder": "makeRevisionHttpBinding",
      "actions": ["dataexchange:ListRevisionAssets"]
    },
    "RevokeRevision": {
      "operation": "revokeRevision",
      "resource": "Revision",
      "request": {
        "mode": "required",
        "omit": ["DataSetId", "RevisionId"],
        "inline": true
      },
      "builder": "makeRevisionHttpBinding",
      "actions": ["dataexchange:RevokeRevision"]
    },
    "SendApiAsset": {
      "operation": "sendApiAsset",
      "resource": "DataSet",
      "request": {
        "mode": "required",
        "omit": ["DataSetId"],
        "inline": true
      },
      "builder": "makeDataSetHttpBinding",
      "actions": ["dataexchange:SendApiAsset"],
      "withTs": {
        "resources": "dataSetAssetArns"
      },
      "imports": {
        "./BindingHttp.ts": ["dataSetAssetArns"]
      }
    },
    "SendDataSetNotification": {
      "operation": "sendDataSetNotification",
      "resource": "DataSet",
      "request": {
        "mode": "required",
        "omit": ["DataSetId"],
        "inline": true
      },
      "builder": "makeDataSetHttpBinding",
      "actions": ["dataexchange:SendDataSetNotification"]
    },
    "UpdateAsset": {
      "operation": "updateAsset",
      "resource": "Revision",
      "request": {
        "mode": "required",
        "omit": ["DataSetId", "RevisionId"],
        "inline": true
      },
      "builder": "makeRevisionHttpBinding",
      "actions": ["dataexchange:UpdateAsset"],
      "withTs": {
        "resources": "revisionAssetArns"
      },
      "imports": {
        "./BindingHttp.ts": ["revisionAssetArns"]
      }
    }
  }
}
