{
  "tag": "AWS.S3Tables",
  "module": "s3tables",
  "resources": {
    "Table": {
      "file": "Table.ts"
    },
    "TableBucket": {
      "file": "TableBucket.ts"
    }
  },
  "builder": "makeS3TablesTableHttpBinding",
  "builders": {
    "makeS3TablesTableBucketHttpBinding": {
      "grants": "resource"
    },
    "makeS3TablesTableHttpBinding": {
      "grants": "resource"
    }
  },
  "bindings": {
    "GetTable": {
      "operation": "getTable",
      "resource": "Table",
      "request": {
        "mode": "none"
      },
      "actions": ["s3tables:GetTable"]
    },
    "GetTableMaintenanceJobStatus": {
      "operation": "getTableMaintenanceJobStatus",
      "resource": "Table",
      "request": {
        "mode": "none"
      },
      "actions": ["s3tables:GetTableMaintenanceJobStatus"]
    },
    "GetTableMetadataLocation": {
      "operation": "getTableMetadataLocation",
      "resource": "Table",
      "request": {
        "mode": "none"
      },
      "actions": ["s3tables:GetTableMetadataLocation"]
    },
    "ListNamespaces": {
      "operation": "listNamespaces",
      "resource": "TableBucket",
      "request": {
        "mode": "optional",
        "interface": "ListNamespacesRequest",
        "omit": ["tableBucketARN"]
      },
      "builder": "makeS3TablesTableBucketHttpBinding",
      "actions": ["s3tables:ListNamespaces"]
    },
    "ListTables": {
      "operation": "listTables",
      "resource": "TableBucket",
      "request": {
        "mode": "optional",
        "interface": "ListTablesRequest",
        "omit": ["tableBucketARN"]
      },
      "builder": "makeS3TablesTableBucketHttpBinding",
      "actions": ["s3tables:ListTables"]
    },
    "UpdateTableMetadataLocation": {
      "operation": "updateTableMetadataLocation",
      "resource": "Table",
      "request": {
        "mode": "required",
        "interface": "UpdateTableMetadataLocationRequest",
        "omit": ["tableBucketARN", "namespace", "name"]
      },
      "actions": ["s3tables:UpdateTableMetadataLocation"]
    }
  }
}
