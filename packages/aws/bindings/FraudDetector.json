        "omit": ["eventTypeName"]
      },
      "actions": ["frauddetector:DeleteEvent"]
    },
    "DeleteEventsByEventType": {
      "operation": "deleteEventsByEventType",
      "resource": "EventType",
      "request": {
        "mode": "required",
        "interface": "DeleteEventsByEventTypeRequest",
        "omit": ["eventTypeName"]
      },
      "actions": ["frauddetector:DeleteEventsByEventType"]
    },
    "GetDeleteEventsByEventTypeStatus": {
      "operation": "getDeleteEventsByEventTypeStatus",
      "resource": "EventType",
      "request": {
        "mode": "required",
        "interface": "GetDeleteEventsByEventTypeStatusRequest",
        "omit": ["eventTypeName"]
      },
      "actions": ["frauddetector:GetDeleteEventsByEventTypeStatus"]
    },
    "GetEvent": {
      "operation": "getEvent",
      "resource": "EventType",
      "request": {
        "mode": "required",
        "interface": "GetEventRequest",
