{
  "tag": "AWS.FraudDetector",
  "module": "frauddetector",
  "resources": {
    "Detector": {
      "file": "Detector.ts"
    },
    "EventType": {
      "file": "EventType.ts"
    },
    "List": {
      "file": "List.ts"
    }
  },
  "builder": "makeFraudDetectorEventTypeHttpBinding",
