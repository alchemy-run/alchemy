{
  "tag": "AWS.BackupSearch",
  "module": "backupsearch",
  "resources": {
    "SearchJob": {
      "file": "SearchJob.ts"
    }
  },
  "builder": "makeSearchJobScopedHttpBinding",
  "builders": {
    "makeSearchJobScopedHttpBinding": {
      "grants": "resource"
    }
  },
  "bindings": {
    "GetSearchJob": {
      "operation": "getSearchJob",
      "resource": "SearchJob",
      "request": {
        "mode": "none"
      }
    },
    "ListSearchJobBackups": {
      "operation": "listSearchJobBackups",
      "resource": "SearchJob",
      "request": {
        "mode": "optional",
        "interface": "ListSearchJobBackupsRequest",
        "omit": ["SearchJobIdentifier"]
      }
    },
    "ListSearchJobResults": {
      "operation": "listSearchJobResults",
      "resource": "SearchJob",
      "request": {
        "mode": "optional",
        "interface": "ListSearchJobResultsRequest",
        "omit": ["SearchJobIdentifier"]
      }
    }
  }
}
