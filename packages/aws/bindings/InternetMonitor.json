{
  "tag": "AWS.InternetMonitor",
  "module": "internetmonitor",
  "alias": "im",
  "resources": {
    "Monitor": {
      "file": "Monitor.ts"
    }
  },
  "builder": "makeInternetMonitorMonitorHttpBinding",
  "builders": {
    "makeInternetMonitorAccountHttpBinding": {
      "grants": "*",
      "arns": true
    },
    "makeInternetMonitorMonitorHttpBinding": {
      "grants": "resource"
    }
  },
  "bindings": {
    "GetHealthEvent": {
      "operation": "getHealthEvent",
      "resource": "Monitor",
      "request": {
        "mode": "required",
        "interface": "GetHealthEventRequest",
        "omit": ["MonitorName"]
      },
      "actions": ["internetmonitor:GetHealthEvent"]
    },
    "GetInternetEvent": {
      "operation": "getInternetEvent",
      "request": {
        "mode": "required",
        "interface": "GetInternetEventRequest",
        "omit": []
      },
      "builder": "makeInternetMonitorAccountHttpBinding",
      "actions": ["internetmonitor:GetInternetEvent"],
      "unscoped": "Narrowed to AWS's ARN formats (arn:${Partition}:internetmonitor::${Account}:internet-event/*), the call was denied live in the InternetMonitor Bindings suite; the grant stays on *."
    },
    "GetQueryResults": {
      "operation": "getQueryResults",
      "resource": "Monitor",
      "request": {
        "mode": "required",
        "interface": "GetQueryResultsRequest",
        "omit": ["MonitorName"]
      },
      "actions": ["internetmonitor:GetQueryResults"]
    },
    "GetQueryStatus": {
      "operation": "getQueryStatus",
      "resource": "Monitor",
      "request": {
        "mode": "required",
        "interface": "GetQueryStatusRequest",
        "omit": ["MonitorName"]
      },
      "actions": ["internetmonitor:GetQueryStatus"]
    },
    "ListHealthEvents": {
      "operation": "listHealthEvents",
      "resource": "Monitor",
      "request": {
        "mode": "optional",
        "interface": "ListHealthEventsRequest",
        "omit": ["MonitorName"]
      },
      "actions": ["internetmonitor:ListHealthEvents"]
    },
    "ListInternetEvents": {
      "operation": "listInternetEvents",
      "request": {
        "mode": "optional",
        "interface": "ListInternetEventsRequest",
        "omit": []
      },
      "builder": "makeInternetMonitorAccountHttpBinding",
      "actions": ["internetmonitor:ListInternetEvents"]
    },
    "StartQuery": {
      "operation": "startQuery",
      "resource": "Monitor",
      "request": {
        "mode": "required",
        "interface": "StartQueryRequest",
        "omit": ["MonitorName"]
      },
      "actions": ["internetmonitor:StartQuery"]
    },
    "StopQuery": {
      "operation": "stopQuery",
      "resource": "Monitor",
      "request": {
        "mode": "required",
        "interface": "StopQueryRequest",
        "omit": ["MonitorName"]
      },
      "actions": ["internetmonitor:StopQuery"]
    }
  }
}
