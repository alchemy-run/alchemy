{
  "tag": "AWS.MemoryDB",
  "module": "memorydb",
  "resources": {
    "Cluster": {
      "file": "Cluster.ts"
    }
  },
  "builder": "makeMemoryDBAccountHttpBinding",
  "builders": {
    "makeMemoryDBAccountHttpBinding": {},
    "makeMemoryDBClusterHttpBinding": {
      "grants": "resource"
    }
  },
  "bindings": {
    "BatchUpdateCluster": {
      "operation": "batchUpdateCluster",
      "request": {
        "mode": "required"
      },
      "actions": ["memorydb:BatchUpdateCluster"],
      "with": {
        "resources": ["arn:aws:memorydb:*:*:cluster/*"]
      },
      "note": "Clusters are addressed by a runtime name list \u2014 grant on the cluster ARN wildcard."
    },
    "CopySnapshot": {
      "operation": "copySnapshot",
      "request": {
        "mode": "required"
      },
      "actions": ["memorydb:CopySnapshot", "memorydb:TagResource"],
      "withTs": {
        "resources": "[SNAPSHOT_ARN_WILDCARD]"
      },
      "imports": {
        "./BindingHttp.ts": ["SNAPSHOT_ARN_WILDCARD"]
      },
      "note": "TagResource authorizes tag-on-create for the target snapshot. Both the source and target snapshot names are runtime data."
    },
    "CreateSnapshot": {
      "operation": "createSnapshot",
      "resource": "Cluster",
      "request": {
        "mode": "required",
        "omit": ["ClusterName"],
        "inline": true
      },
      "builder": "makeMemoryDBClusterHttpBinding",
      "actions": ["memorydb:CreateSnapshot", "memorydb:TagResource"],
      "withTs": {
        "extraResources": "[SNAPSHOT_ARN_WILDCARD]"
      },
      "imports": {
        "./BindingHttp.ts": ["SNAPSHOT_ARN_WILDCARD"]
      },
      "note": "TagResource authorizes tag-on-create for the snapshot. The action authorizes against both the source cluster and the to-be-created snapshot (whose name-based ARN is runtime data)."
    },
    "DeleteSnapshot": {
      "operation": "deleteSnapshot",
      "request": {
        "mode": "required"
      },
      "actions": ["memorydb:DeleteSnapshot"],
      "withTs": {
        "resources": "[SNAPSHOT_ARN_WILDCARD]"
      },
      "imports": {
        "./BindingHttp.ts": ["SNAPSHOT_ARN_WILDCARD"]
      }
    },
    "DescribeClusters": {
      "operation": "describeClusters",
      "actions": ["memorydb:DescribeClusters"]
    },
    "DescribeEngineVersions": {
      "operation": "describeEngineVersions",
      "actions": ["memorydb:DescribeEngineVersions"]
    },
    "DescribeEvents": {
      "operation": "describeEvents",
      "actions": ["memorydb:DescribeEvents"]
    },
    "DescribeServiceUpdates": {
      "operation": "describeServiceUpdates",
      "actions": ["memorydb:DescribeServiceUpdates"]
    },
    "DescribeSnapshots": {
      "operation": "describeSnapshots",
      "actions": ["memorydb:DescribeSnapshots"]
    },
    "FailoverShard": {
      "operation": "failoverShard",
      "resource": "Cluster",
      "request": {
        "mode": "required",
        "omit": ["ClusterName"],
        "inline": true
      },
      "builder": "makeMemoryDBClusterHttpBinding",
      "actions": ["memorydb:FailoverShard"]
    },
    "ListAllowedNodeTypeUpdates": {
      "operation": "listAllowedNodeTypeUpdates",
      "resource": "Cluster",
      "request": {
        "mode": "none"
      },
      "builder": "makeMemoryDBClusterHttpBinding",
      "actions": ["memorydb:ListAllowedNodeTypeUpdates"]
    }
  }
}
