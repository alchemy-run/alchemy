{
  "tag": "AWS.Location",
  "module": "location",
  "resources": {
    "GeofenceCollection": {
      "file": "GeofenceCollection.ts"
    },
    "PlaceIndex": {
      "file": "PlaceIndex.ts"
    },
    "RouteCalculator": {
      "file": "RouteCalculator.ts"
    },
    "Tracker": {
      "file": "Tracker.ts"
    }
  },
  "builder": "makeLocationTrackerHttpBinding",
  "builders": {
    "makeLocationAccountHttpBinding": {
      "grants": "*",
      "arns": true
    },
    "makeLocationCalculatorHttpBinding": {
      "grants": "resource"
    },
    "makeLocationCollectionHttpBinding": {
      "grants": "resource"
    },
    "makeLocationPlaceIndexHttpBinding": {
      "grants": "resource"
    },
    "makeLocationTrackerHttpBinding": {
      "grants": "resource"
    }
  },
  "bindings": {
    "BatchDeleteDevicePositionHistory": {
      "operation": "batchDeleteDevicePositionHistory",
      "resource": "Tracker",
      "request": {
        "mode": "required",
        "interface": "BatchDeleteDevicePositionHistoryRequest",
        "omit": ["TrackerName"]
      }
    },
    "BatchDeleteGeofence": {
      "operation": "batchDeleteGeofence",
      "resource": "GeofenceCollection",
      "param": "collection",
      "request": {
        "mode": "required",
        "interface": "BatchDeleteGeofenceRequest",
        "omit": ["CollectionName"]
      },
      "builder": "makeLocationCollectionHttpBinding"
    },
    "BatchEvaluateGeofences": {
      "operation": "batchEvaluateGeofences",
      "resource": "GeofenceCollection",
      "param": "collection",
      "request": {
        "mode": "required",
        "interface": "BatchEvaluateGeofencesRequest",
        "omit": ["CollectionName"]
      },
      "builder": "makeLocationCollectionHttpBinding"
    },
    "BatchGetDevicePosition": {
      "operation": "batchGetDevicePosition",
      "resource": "Tracker",
      "request": {
        "mode": "required",
        "interface": "BatchGetDevicePositionRequest",
        "omit": ["TrackerName"]
      }
    },
    "BatchPutGeofence": {
      "operation": "batchPutGeofence",
      "resource": "GeofenceCollection",
      "param": "collection",
      "request": {
        "mode": "required",
        "interface": "BatchPutGeofenceRequest",
        "omit": ["CollectionName"]
      },
      "builder": "makeLocationCollectionHttpBinding"
    },
    "BatchUpdateDevicePosition": {
      "operation": "batchUpdateDevicePosition",
      "resource": "Tracker",
      "request": {
        "mode": "required",
        "interface": "BatchUpdateDevicePositionRequest",
        "omit": ["TrackerName"]
      }
    },
    "CalculateRoute": {
      "operation": "calculateRoute",
      "resource": "RouteCalculator",
      "param": "calculator",
      "request": {
        "mode": "required",
        "interface": "CalculateRouteRequest",
        "omit": ["CalculatorName"]
      },
      "builder": "makeLocationCalculatorHttpBinding"
    },
    "CalculateRouteMatrix": {
      "operation": "calculateRouteMatrix",
      "resource": "RouteCalculator",
      "param": "calculator",
      "request": {
        "mode": "required",
        "interface": "CalculateRouteMatrixRequest",
        "omit": ["CalculatorName"]
      },
      "builder": "makeLocationCalculatorHttpBinding"
    },
    "CancelJob": {
      "operation": "cancelJob",
      "request": {
        "mode": "required"
      },
      "builder": "makeLocationAccountHttpBinding"
    },
    "ForecastGeofenceEvents": {
      "operation": "forecastGeofenceEvents",
      "resource": "GeofenceCollection",
      "param": "collection",
      "request": {
        "mode": "required",
        "interface": "ForecastGeofenceEventsRequest",
        "omit": ["CollectionName"]
      },
      "builder": "makeLocationCollectionHttpBinding"
    },
    "GetDevicePosition": {
      "operation": "getDevicePosition",
      "resource": "Tracker",
      "request": {
        "mode": "required",
        "interface": "GetDevicePositionRequest",
        "omit": ["TrackerName"]
      }
    },
    "GetDevicePositionHistory": {
      "operation": "getDevicePositionHistory",
      "resource": "Tracker",
      "request": {
        "mode": "required",
        "interface": "GetDevicePositionHistoryRequest",
        "omit": ["TrackerName"]
      }
    },
    "GetGeofence": {
      "operation": "getGeofence",
      "resource": "GeofenceCollection",
      "param": "collection",
      "request": {
        "mode": "required",
        "interface": "GetGeofenceRequest",
        "omit": ["CollectionName"]
      },
      "builder": "makeLocationCollectionHttpBinding"
    },
    "GetJob": {
      "operation": "getJob",
      "request": {
        "mode": "required"
      },
      "builder": "makeLocationAccountHttpBinding"
    },
    "GetPlace": {
      "operation": "getPlace",
      "resource": "PlaceIndex",
      "param": "index",
      "request": {
        "mode": "required",
        "interface": "GetPlaceRequest",
        "omit": ["IndexName"]
      },
      "builder": "makeLocationPlaceIndexHttpBinding"
    },
    "ListDevicePositions": {
      "operation": "listDevicePositions",
      "resource": "Tracker",
      "request": {
        "mode": "optional",
        "interface": "ListDevicePositionsRequest",
        "omit": ["TrackerName"]
      }
    },
    "ListGeofences": {
      "operation": "listGeofences",
      "resource": "GeofenceCollection",
      "param": "collection",
      "request": {
        "mode": "optional",
        "interface": "ListGeofencesRequest",
        "omit": ["CollectionName"]
      },
      "builder": "makeLocationCollectionHttpBinding"
    },
    "ListJobs": {
      "operation": "listJobs",
      "builder": "makeLocationAccountHttpBinding"
    },
    "PutGeofence": {
      "operation": "putGeofence",
      "resource": "GeofenceCollection",
      "param": "collection",
      "request": {
        "mode": "required",
        "interface": "PutGeofenceRequest",
        "omit": ["CollectionName"]
      },
      "builder": "makeLocationCollectionHttpBinding"
    },
    "SearchPlaceIndexForPosition": {
      "operation": "searchPlaceIndexForPosition",
      "resource": "PlaceIndex",
      "param": "index",
      "request": {
        "mode": "required",
        "interface": "SearchPlaceIndexForPositionRequest",
        "omit": ["IndexName"]
      },
      "builder": "makeLocationPlaceIndexHttpBinding"
    },
    "SearchPlaceIndexForSuggestions": {
      "operation": "searchPlaceIndexForSuggestions",
      "resource": "PlaceIndex",
      "param": "index",
      "request": {
        "mode": "required",
        "interface": "SearchPlaceIndexForSuggestionsRequest",
        "omit": ["IndexName"]
      },
      "builder": "makeLocationPlaceIndexHttpBinding"
    },
    "SearchPlaceIndexForText": {
      "operation": "searchPlaceIndexForText",
      "resource": "PlaceIndex",
      "param": "index",
      "request": {
        "mode": "required",
        "interface": "SearchPlaceIndexForTextRequest",
        "omit": ["IndexName"]
      },
      "builder": "makeLocationPlaceIndexHttpBinding"
    },
    "VerifyDevicePosition": {
      "operation": "verifyDevicePosition",
      "resource": "Tracker",
      "request": {
        "mode": "required",
        "interface": "VerifyDevicePositionRequest",
        "omit": ["TrackerName"]
      }
    }
  }
}
