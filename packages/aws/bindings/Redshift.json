{
  "tag": "AWS.Redshift",
  "module": "redshift",
  "resources": {
    "Cluster": {
      "file": "Cluster.ts"
    }
  },
  "builder": "makeRedshiftAccountHttpBinding",
  "builders": {
    "makeRedshiftAccountHttpBinding": {
      "grants": "*",
      "arns": true
    },
    "makeRedshiftClusterHttpBinding": {
      "grants": "resource"
    }
  },
  "bindings": {
    "CopyClusterSnapshot": {
      "operation": "copyClusterSnapshot",
      "request": {
        "mode": "required"
      },
      "actions": ["redshift:CopyClusterSnapshot"]
    },
    "CreateClusterSnapshot": {
      "operation": "createClusterSnapshot",
      "resource": "Cluster",
      "request": {
        "mode": "required",
        "omit": ["ClusterIdentifier"],
        "inline": true
      },
      "builder": "makeRedshiftClusterHttpBinding",
      "actions": ["redshift:CreateClusterSnapshot"],
      "withTs": {
        "extraResources": "(clusterArn) => [clusterSnapshotArnPattern(clusterArn)]"
      },
      "imports": {
        "./BindingHttp.ts": ["clusterSnapshotArnPattern"]
      },
      "reviewed": {
        "redshift:CreateTags": "Needed only when the request sets tags; not granted, since tagging can change tag-based access."
      }
    },
    "DeleteClusterSnapshot": {
      "operation": "deleteClusterSnapshot",
      "request": {
        "mode": "required"
      },
      "actions": ["redshift:DeleteClusterSnapshot"]
    },
    "DescribeClusterSnapshots": {
      "operation": "describeClusterSnapshots",
      "actions": ["redshift:DescribeClusterSnapshots"]
    },
    "DescribeClusters": {
      "operation": "describeClusters",
      "actions": ["redshift:DescribeClusters"]
    },
    "DescribeEvents": {
      "operation": "describeEvents",
      "actions": ["redshift:DescribeEvents"]
    },
    "PauseCluster": {
      "operation": "pauseCluster",
      "resource": "Cluster",
      "request": {
        "mode": "none"
      },
      "builder": "makeRedshiftClusterHttpBinding",
      "actions": ["redshift:PauseCluster"]
    },
    "RebootCluster": {
      "operation": "rebootCluster",
      "resource": "Cluster",
      "request": {
        "mode": "none"
      },
      "builder": "makeRedshiftClusterHttpBinding",
      "actions": ["redshift:RebootCluster"]
    },
    "ResumeCluster": {
      "operation": "resumeCluster",
      "resource": "Cluster",
      "request": {
        "mode": "none"
      },
      "builder": "makeRedshiftClusterHttpBinding",
      "actions": ["redshift:ResumeCluster"]
    }
  }
}
