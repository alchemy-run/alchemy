{
  "tag": "AWS.CodeConnections",
  "module": "codeconnections",
  "resources": {
    "Connection": {
      "file": "Connection.ts"
    },
    "RepositoryLink": {
      "file": "RepositoryLink.ts"
    },
    "SyncConfiguration": {
      "file": "SyncConfiguration.ts"
    }
