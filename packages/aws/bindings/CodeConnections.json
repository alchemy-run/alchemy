      "operation": "getConnection",
      "resource": "Connection",
      "request": {
        "mode": "none"
      },
      "builder": "makeConnectionScopedHttpBinding",
      "actions": ["codeconnections:GetConnection"],
      "reviewed": {
        "codestar-connections:GetConnection": "codestar-connections is the legacy prefix of codeconnections; AWS authorizes either."
      }
    },
    "GetRepositorySyncStatus": {
      "operation": "getRepositorySyncStatus",
