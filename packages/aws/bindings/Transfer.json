{
  "tag": "AWS.Transfer",
  "module": "transfer",
  "resources": {
    "Server": {
      "file": "Server.ts"
    },
    "User": {
      "file": "User.ts"
    }
  },
  "builder": "makeTransferServerHttpBinding",
  "builders": {
    "makeTransferAccountHttpBinding": {
      "grants": "*",
      "arns": true
    },
    "makeTransferServerHttpBinding": {
      "grants": "resource"
    },
    "makeTransferUserHttpBinding": {
      "grants": "resource"
    }
  },
  "bindings": {
    "DeleteSshPublicKey": {
      "operation": "deleteSshPublicKey",
      "resource": "User",
      "request": {
        "mode": "required",
        "omit": ["ServerId", "UserName"],
        "inline": true
      },
      "builder": "makeTransferUserHttpBinding"
    },
    "DescribeServer": {
      "operation": "describeServer",
      "resource": "Server",
      "request": {
        "mode": "optional",
        "omit": ["ServerId"],
        "inline": true
      }
    },
    "DescribeUser": {
      "operation": "describeUser",
      "resource": "User",
      "request": {
        "mode": "optional",
        "omit": ["ServerId", "UserName"],
        "inline": true
      },
      "builder": "makeTransferUserHttpBinding"
    },
    "ImportSshPublicKey": {
      "operation": "importSshPublicKey",
      "resource": "User",
      "request": {
        "mode": "required",
        "omit": ["ServerId", "UserName"],
        "inline": true
      },
      "builder": "makeTransferUserHttpBinding"
    },
    "ListUsers": {
      "operation": "listUsers",
      "resource": "Server",
      "request": {
        "mode": "optional",
        "omit": ["ServerId"],
        "inline": true
      }
    },
    "SendWorkflowStepState": {
      "operation": "sendWorkflowStepState",
      "request": {
        "mode": "required"
      },
      "builder": "makeTransferAccountHttpBinding"
    },
    "StartServer": {
      "operation": "startServer",
      "resource": "Server",
      "request": {
        "mode": "optional",
        "omit": ["ServerId"],
        "inline": true
      }
    },
    "StopServer": {
      "operation": "stopServer",
      "resource": "Server",
      "request": {
        "mode": "optional",
        "omit": ["ServerId"],
        "inline": true
      }
    },
    "TestIdentityProvider": {
      "operation": "testIdentityProvider",
      "resource": "Server",
      "request": {
        "mode": "required",
        "omit": ["ServerId"],
        "inline": true
      },
      "withTs": {
        "resource": "(server) => Output.map(server.arn, (arn) => `${arn.replace(\":server/\", \":user/\")}/*`)"
      },
      "imports": {
        "alchemy/Output": "* as Output"
      },
      "note": "AWS authorizes this operation against the addressed user, despite the binding being server-scoped so it can inject ServerId. UserName arrives at runtime, so grant the operation on every user of the bound server."
    }
  }
}
