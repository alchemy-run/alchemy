        "mode": "required",
        "interface": "AcceptPredictionsRequest",
        "omit": ["domainIdentifier"]
      },
      "actions": ["datazone:AcceptPredictions"]
    },
    "AcceptSubscriptionRequest": {
      "operation": "acceptSubscriptionRequest",
