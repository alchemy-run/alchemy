{
  "tag": "AWS.Shield",
  "module": "shield",
  "resources": {},
  "builder": "makeShieldHttpBinding",
  "builders": {
    "makeShieldHttpBinding": {
      "grants": "*",
      "arns": true
    }
  },
  "bindings": {
    "DescribeAttack": {
      "operation": "describeAttack",
      "request": {
        "mode": "required"
      },
      "actions": ["shield:DescribeAttack"],
      "arns": ["arn:${Partition}:shield::${Account}:attack/*"]
    },
    "DescribeAttackStatistics": {
      "operation": "describeAttackStatistics",
      "actions": ["shield:DescribeAttackStatistics"]
    },
    "DescribeDRTAccess": {
      "operation": "describeDRTAccess",
      "actions": ["shield:DescribeDRTAccess"]
    },
    "GetSubscriptionState": {
      "operation": "getSubscriptionState",
      "actions": ["shield:GetSubscriptionState"]
    },
    "ListAttacks": {
      "operation": "listAttacks",
      "actions": ["shield:ListAttacks"]
    },
    "ListResourcesInProtectionGroup": {
      "operation": "listResourcesInProtectionGroup",
      "request": {
        "mode": "required"
      },
      "actions": ["shield:ListResourcesInProtectionGroup"],
      "arns": ["arn:${Partition}:shield::${Account}:protection-group/*"]
    }
  }
}
