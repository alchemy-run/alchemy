{
  "tag": "AWS.DocDB",
  "module": "docdb",
  "resources": {
    "DBCluster": {
      "file": "DBCluster.ts"
    },
    "DBInstance": {
      "file": "DBInstance.ts"
    }
  },
  "builder": "makeDocDBAccountHttpBinding",
  "builders": {
    "makeDocDBAccountHttpBinding": {
      "grants": "*",
      "arns": true
    },
    "makeDocDBClusterHttpBinding": {
      "grants": "resource"
    },
    "makeDocDBInstanceHttpBinding": {
      "grants": "resource"
    }
  },
  "bindings": {
    "ApplyPendingMaintenanceAction": {
      "operation": "applyPendingMaintenanceAction",
      "request": {
        "mode": "required"
      }
    },
    "CopyDBClusterSnapshot": {
      "operation": "copyDBClusterSnapshot",
      "request": {
        "mode": "required"
      }
    },
    "CreateDBClusterSnapshot": {
      "operation": "createDBClusterSnapshot",
      "resource": "DBCluster",
      "param": "cluster",
      "request": {
        "mode": "required",
        "omit": ["DBClusterIdentifier"],
        "inline": true
      },
      "builder": "makeDocDBClusterHttpBinding",
      "withTs": {
        "extraResources": "(clusterArn) => [`${clusterArn.split(\":\").slice(0, 5).join(\":\")}:cluster-snapshot:*`]"
      },
      "note": "Snapshot creation authorizes against BOTH the source cluster ARN and the target snapshot ARN — widen the grant to the account's DocumentDB cluster-snapshot space (`arn:…:rds:{region}:{account}:cluster-snapshot:*`)."
    },
    "DeleteDBClusterSnapshot": {
      "operation": "deleteDBClusterSnapshot",
      "request": {
        "mode": "required"
      }
    },
    "DescribeDBClusterSnapshots": {
      "operation": "describeDBClusterSnapshots"
    },
    "DescribeDBClusters": {
      "operation": "describeDBClusters"
    },
    "DescribeDBInstances": {
      "operation": "describeDBInstances"
    },
    "DescribeEvents": {
      "operation": "describeEvents"
    },
    "DescribePendingMaintenanceActions": {
      "operation": "describePendingMaintenanceActions"
    },
    "FailoverDBCluster": {
      "operation": "failoverDBCluster",
      "resource": "DBCluster",
      "param": "cluster",
      "request": {
        "mode": "optional",
        "omit": ["DBClusterIdentifier"],
        "inline": true
      },
      "builder": "makeDocDBClusterHttpBinding"
    },
    "RebootDBInstance": {
      "operation": "rebootDBInstance",
      "resource": "DBInstance",
      "param": "instance",
      "request": {
        "mode": "optional",
        "omit": ["DBInstanceIdentifier"],
        "inline": true
      },
      "builder": "makeDocDBInstanceHttpBinding"
    },
    "StartDBCluster": {
      "operation": "startDBCluster",
      "resource": "DBCluster",
      "param": "cluster",
      "request": {
        "mode": "none"
      },
      "builder": "makeDocDBClusterHttpBinding"
    },
    "StopDBCluster": {
      "operation": "stopDBCluster",
      "resource": "DBCluster",
      "param": "cluster",
      "request": {
        "mode": "none"
      },
      "builder": "makeDocDBClusterHttpBinding"
    }
  }
}
