{
  "tag": "AWS.Forecast",
  "module": "forecast",
  "resources": {},
  "builder": "makeForecastHttpBinding",
  "builders": {
    "makeForecastHttpBinding": {
      "options": {
        "capability": "name",
        "iamActions": "actions",
        "operation": "operation"
      },
      "grants": "*",
      "arns": true
    }
  },
  "bindings": {
    "CreateAutoPredictor": {
      "operation": "createAutoPredictor",
      "request": {
        "mode": "required"
      },
      "actions": ["forecast:CreateAutoPredictor"],
      "with": {
        "passRole": true
      },
      "reviewed": {
        "forecast:TagResource": "Needed only when the request sets tags; not granted, since tagging can change tag-based access."
      }
    },
    "CreateDatasetImportJob": {
      "operation": "createDatasetImportJob",
      "request": {
        "mode": "required"
      },
      "actions": ["forecast:CreateDatasetImportJob"],
      "with": {
        "passRole": true
      },
      "reviewed": {
        "forecast:TagResource": "Needed only when the request sets tags; not granted, since tagging can change tag-based access."
      }
    },
    "CreateForecast": {
      "operation": "createForecast",
      "request": {
        "mode": "required"
      },
      "actions": ["forecast:CreateForecast"],
      "arns": ["arn:${Partition}:forecast:${Region}:${Account}:predictor/*"],
      "reviewed": {
        "forecast:TagResource": "Needed only when the request sets tags; not granted, since tagging can change tag-based access."
      }
    },
    "CreateForecastExportJob": {
      "operation": "createForecastExportJob",
      "request": {
        "mode": "required"
      },
      "actions": ["forecast:CreateForecastExportJob"],
      "with": {
        "passRole": true
      },
      "note": "Destination hands Forecast a role to write the export to S3.",
      "arns": ["arn:${Partition}:forecast:${Region}:${Account}:forecast/*"],
      "reviewed": {
        "forecast:TagResource": "Needed only when the request sets tags; not granted, since tagging can change tag-based access.",
        "iam:PassRole": "AWS lists it for the operation, but the Forecast Bindings suite calls it successfully without it."
      }
    },
    "CreateWhatIfAnalysis": {
      "operation": "createWhatIfAnalysis",
      "request": {
        "mode": "required"
      },
      "actions": ["forecast:CreateWhatIfAnalysis"],
      "arns": ["arn:${Partition}:forecast:${Region}:${Account}:forecast/*"],
      "reviewed": {
        "forecast:TagResource": "Needed only when the request sets tags; not granted, since tagging can change tag-based access."
      }
    },
    "CreateWhatIfForecast": {
      "operation": "createWhatIfForecast",
      "request": {
        "mode": "required"
      },
      "actions": ["forecast:CreateWhatIfForecast"],
      "with": {
        "passRole": true
      },
      "note": "TimeSeriesReplacementsDataSource hands Forecast a role to read S3.",
      "arns": ["arn:${Partition}:forecast:${Region}:${Account}:what-if-analysis/*"],
      "reviewed": {
        "iam:PassRole": "The request can name an S3 role for its data source or destination; the builder's PassRole is limited to forecast.amazonaws.com."
      }
    },
    "CreateWhatIfForecastExport": {
      "operation": "createWhatIfForecastExport",
      "request": {
        "mode": "required"
      },
      "actions": ["forecast:CreateWhatIfForecastExport"],
      "with": {
        "passRole": true
      },
      "note": "Destination hands Forecast a role to write the export to S3.",
      "arns": ["arn:${Partition}:forecast:${Region}:${Account}:what-if-forecast/*"],
      "reviewed": {
        "iam:PassRole": "The request can name an S3 role for its data source or destination; the builder's PassRole is limited to forecast.amazonaws.com."
      }
    },
    "DeleteResourceTree": {
      "operation": "deleteResourceTree",
      "request": {
        "mode": "required"
      },
      "actions": ["forecast:DeleteResourceTree"],
      "arns": [
        "arn:${Partition}:forecast:${Region}:${Account}:dataset-group/*",
        "arn:${Partition}:forecast:${Region}:${Account}:dataset-import-job/*",
        "arn:${Partition}:forecast:${Region}:${Account}:dataset/*",
        "arn:${Partition}:forecast:${Region}:${Account}:explainability-export/*",
        "arn:${Partition}:forecast:${Region}:${Account}:explainability/*",
        "arn:${Partition}:forecast:${Region}:${Account}:forecast-endpoint/*",
        "arn:${Partition}:forecast:${Region}:${Account}:forecast-export-job/*",
        "arn:${Partition}:forecast:${Region}:${Account}:forecast/*",
        "arn:${Partition}:forecast:${Region}:${Account}:monitor/*",
        "arn:${Partition}:forecast:${Region}:${Account}:predictor-backtest-export-job/*",
        "arn:${Partition}:forecast:${Region}:${Account}:predictor/*",
        "arn:${Partition}:forecast:${Region}:${Account}:what-if-analysis/*",
        "arn:${Partition}:forecast:${Region}:${Account}:what-if-forecast-export/*",
        "arn:${Partition}:forecast:${Region}:${Account}:what-if-forecast/*"
      ]
    },
    "DescribeAutoPredictor": {
      "operation": "describeAutoPredictor",
      "request": {
        "mode": "required"
      },
      "actions": ["forecast:DescribeAutoPredictor"],
      "arns": ["arn:${Partition}:forecast:${Region}:${Account}:predictor/*"]
    },
    "DescribeDatasetImportJob": {
      "operation": "describeDatasetImportJob",
      "request": {
        "mode": "required"
      },
      "actions": ["forecast:DescribeDatasetImportJob"],
      "arns": ["arn:${Partition}:forecast:${Region}:${Account}:dataset-import-job/*"]
    },
    "DescribeForecast": {
      "operation": "describeForecast",
      "request": {
        "mode": "required"
      },
      "actions": ["forecast:DescribeForecast"],
      "arns": ["arn:${Partition}:forecast:${Region}:${Account}:forecast/*"]
    },
    "DescribeForecastExportJob": {
      "operation": "describeForecastExportJob",
      "request": {
        "mode": "required"
      },
      "actions": ["forecast:DescribeForecastExportJob"],
      "arns": ["arn:${Partition}:forecast:${Region}:${Account}:forecast-export-job/*"]
    },
    "DescribeWhatIfAnalysis": {
      "operation": "describeWhatIfAnalysis",
      "request": {
        "mode": "required"
      },
      "actions": ["forecast:DescribeWhatIfAnalysis"],
      "arns": ["arn:${Partition}:forecast:${Region}:${Account}:what-if-analysis/*"]
    },
    "DescribeWhatIfForecast": {
      "operation": "describeWhatIfForecast",
      "request": {
        "mode": "required"
      },
      "actions": ["forecast:DescribeWhatIfForecast"],
      "arns": ["arn:${Partition}:forecast:${Region}:${Account}:what-if-forecast/*"]
    },
    "DescribeWhatIfForecastExport": {
      "operation": "describeWhatIfForecastExport",
      "request": {
        "mode": "required"
      },
      "actions": ["forecast:DescribeWhatIfForecastExport"],
      "arns": ["arn:${Partition}:forecast:${Region}:${Account}:what-if-forecast-export/*"]
    },
    "GetAccuracyMetrics": {
      "operation": "getAccuracyMetrics",
      "request": {
        "mode": "required"
      },
      "actions": ["forecast:GetAccuracyMetrics"],
      "arns": ["arn:${Partition}:forecast:${Region}:${Account}:predictor/*"]
    },
    "QueryForecast": {
      "operation": "queryForecast",
      "request": {
        "mode": "required"
      },
      "actions": ["forecast:QueryForecast"],
      "module": "forecastquery",
      "arns": ["arn:${Partition}:forecast:${Region}:${Account}:forecast/*"]
    },
    "QueryWhatIfForecast": {
      "operation": "queryWhatIfForecast",
      "request": {
        "mode": "required"
      },
      "actions": ["forecast:QueryWhatIfForecast"],
      "module": "forecastquery",
      "arns": ["arn:${Partition}:forecast:${Region}:${Account}:what-if-forecast/*"]
    },
    "ResumeResource": {
      "operation": "resumeResource",
      "request": {
        "mode": "required"
      },
      "actions": ["forecast:ResumeResource"],
      "arns": ["arn:${Partition}:forecast:${Region}:${Account}:monitor/*"]
    },
    "StopResource": {
      "operation": "stopResource",
      "request": {
        "mode": "required"
      },
      "actions": ["forecast:StopResource"],
      "arns": [
        "arn:${Partition}:forecast:${Region}:${Account}:dataset-import-job/*",
        "arn:${Partition}:forecast:${Region}:${Account}:explainability-export/*",
        "arn:${Partition}:forecast:${Region}:${Account}:explainability/*",
        "arn:${Partition}:forecast:${Region}:${Account}:forecast-endpoint/*",
        "arn:${Partition}:forecast:${Region}:${Account}:forecast-export-job/*",
        "arn:${Partition}:forecast:${Region}:${Account}:forecast/*",
        "arn:${Partition}:forecast:${Region}:${Account}:monitor/*",
        "arn:${Partition}:forecast:${Region}:${Account}:predictor-backtest-export-job/*",
        "arn:${Partition}:forecast:${Region}:${Account}:predictor/*",
        "arn:${Partition}:forecast:${Region}:${Account}:what-if-analysis/*",
        "arn:${Partition}:forecast:${Region}:${Account}:what-if-forecast-export/*",
        "arn:${Partition}:forecast:${Region}:${Account}:what-if-forecast/*"
      ]
    }
  }
}
