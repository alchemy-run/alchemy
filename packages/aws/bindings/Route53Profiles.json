{
  "tag": "AWS.Route53Profiles",
  "module": "route53profiles",
  "alias": "profiles",
  "resources": {
    "Profile": {
      "file": "Profile.ts"
    }
  },
  "builder": "makeProfilesHttpBinding",
  "builders": {
    "makeProfilesHttpBinding": {
      "grants": "*"
    }
  },
  "bindings": {
    "ListProfileAssociations": {
      "operation": "listProfileAssociations",
      "resource": "Profile",
      "request": {
        "mode": "optional",
        "interface": "ListProfileAssociationsRequest",
        "omit": ["ProfileId"]
      },
      "actions": ["route53profiles:ListProfileAssociations"]
    },
    "ListProfileResourceAssociations": {
      "operation": "listProfileResourceAssociations",
      "resource": "Profile",
      "request": {
        "mode": "optional",
        "interface": "ListProfileResourceAssociationsRequest",
        "omit": ["ProfileId"]
      },
      "actions": ["route53profiles:ListProfileResourceAssociations"]
    }
  }
}
