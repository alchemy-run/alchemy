{
  "tag": "AWS.DataSync",
  "module": "datasync",
  "resources": {
    "Task": {
      "file": "Task.ts"
    }
  },
  "builder": "makeDataSyncTaskExecutionHttpBinding",
  "builders": {
    "makeDataSyncTaskExecutionHttpBinding": {},
    "makeDataSyncTaskHttpBinding": {}
  },
  "bindings": {
    "CancelTaskExecution": {
      "operation": "cancelTaskExecution",
      "resource": "Task",
      "request": {
        "mode": "required"
      }
    },
    "DescribeTask": {
      "operation": "describeTask",
      "resource": "Task",
      "request": {
        "mode": "none"
      },
      "builder": "makeDataSyncTaskHttpBinding"
    },
    "DescribeTaskExecution": {
      "operation": "describeTaskExecution",
      "resource": "Task",
      "request": {
        "mode": "required"
      }
    },
    "ListTaskExecutions": {
      "operation": "listTaskExecutions",
      "resource": "Task",
      "request": {
        "mode": "optional",
        "omit": ["TaskArn"],
        "inline": true
      },
      "builder": "makeDataSyncTaskHttpBinding"
    },
    "StartTaskExecution": {
      "operation": "startTaskExecution",
      "resource": "Task",
      "request": {
        "mode": "optional",
        "omit": ["TaskArn"],
        "inline": true
      },
      "builder": "makeDataSyncTaskHttpBinding"
    },
    "UpdateTaskExecution": {
      "operation": "updateTaskExecution",
      "resource": "Task",
      "request": {
        "mode": "required"
      }
    }
  }
}
