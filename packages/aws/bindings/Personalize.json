{
  "tag": "AWS.Personalize",
  "module": "personalize",
  "resources": {
    "Dataset": {
      "file": "Dataset.ts"
    },
    "EventTracker": {
      "file": "EventTracker.ts"
    }
  },
  "builder": "makePersonalizeAccountHttpBinding",
  "builders": {
    "makePersonalizeAccountHttpBinding": {
      "grants": "*",
      "arns": true
    },
    "makePersonalizeDatasetHttpBinding": {},
    "makePersonalizeEventTrackerHttpBinding": {
      "grants": "*",
      "arns": true
    }
  },
  "bindings": {
    "CreateBatchInferenceJob": {
      "operation": "createBatchInferenceJob",
      "request": {
        "mode": "required"
      },
      "actions": ["personalize:CreateBatchInferenceJob"],
      "with": {
        "passRole": true
      },
      "arns": [
        "arn:${Partition}:personalize:${Region}:${Account}:batch-inference-job/*",
        "arn:${Partition}:personalize:${Region}:${Account}:solution/*"
      ],
      "reviewed": {
        "personalize:TagResource": "Needed only when the request sets tags; not granted, since tagging can change tag-based access."
      }
    },
    "CreateCampaign": {
      "operation": "createCampaign",
      "request": {
        "mode": "required"
      },
      "actions": ["personalize:CreateCampaign"],
      "arns": [
        "arn:${Partition}:personalize:${Region}:${Account}:campaign/*",
        "arn:${Partition}:personalize:${Region}:${Account}:solution/*"
      ],
      "reviewed": {
        "personalize:TagResource": "Needed only when the request sets tags; not granted, since tagging can change tag-based access."
      }
    },
    "CreateDatasetImportJob": {
      "operation": "createDatasetImportJob",
      "request": {
        "mode": "required"
      },
      "actions": ["personalize:CreateDatasetImportJob"],
      "with": {
        "passRole": true
      },
      "arns": [
        "arn:${Partition}:personalize:${Region}:${Account}:dataset-import-job/*",
        "arn:${Partition}:personalize:${Region}:${Account}:dataset/*"
      ],
      "reviewed": {
        "personalize:TagResource": "Needed only when the request sets tags; not granted, since tagging can change tag-based access."
      }
    },
    "CreateSolution": {
      "operation": "createSolution",
      "request": {
        "mode": "required"
      },
      "actions": ["personalize:CreateSolution"],
      "reviewed": {
        "personalize:TagResource": "Needed only when the request sets tags; not granted, since tagging can change tag-based access."
      },
      "unscoped": "Narrowed to AWS's ARN formats (arn:${Partition}:personalize:${Region}:${Account}:dataset-group/*, arn:${Partition}:personalize:${Region}:${Account}:solution/*), the call was denied live in the Personalize Bindings suite; the grant stays on *."
    },
    "CreateSolutionVersion": {
      "operation": "createSolutionVersion",
      "request": {
        "mode": "required"
      },
      "actions": ["personalize:CreateSolutionVersion"],
      "arns": ["arn:${Partition}:personalize:${Region}:${Account}:solution/*"],
      "reviewed": {
        "personalize:TagResource": "Needed only when the request sets tags; not granted, since tagging can change tag-based access."
      }
    },
    "DescribeBatchInferenceJob": {
      "operation": "describeBatchInferenceJob",
      "request": {
        "mode": "required"
      },
      "actions": ["personalize:DescribeBatchInferenceJob"],
      "arns": ["arn:${Partition}:personalize:${Region}:${Account}:batch-inference-job/*"]
    },
    "DescribeCampaign": {
      "operation": "describeCampaign",
      "request": {
        "mode": "required"
      },
      "actions": ["personalize:DescribeCampaign"],
      "arns": ["arn:${Partition}:personalize:${Region}:${Account}:campaign/*"]
    },
    "DescribeDatasetImportJob": {
      "operation": "describeDatasetImportJob",
      "request": {
        "mode": "required"
      },
      "actions": ["personalize:DescribeDatasetImportJob"],
      "arns": ["arn:${Partition}:personalize:${Region}:${Account}:dataset-import-job/*"]
    },
    "DescribeSolutionVersion": {
      "operation": "describeSolutionVersion",
      "request": {
        "mode": "required"
      },
      "actions": ["personalize:DescribeSolutionVersion"],
      "arns": ["arn:${Partition}:personalize:${Region}:${Account}:solution/*"]
    },
    "GetActionRecommendations": {
      "operation": "getActionRecommendations",
      "request": {
        "mode": "required"
      },
      "actions": ["personalize:GetActionRecommendations"],
      "module": "personalize-runtime",
      "unscoped": "Narrowed to AWS's ARN formats (arn:${Partition}:personalize:${Region}:${Account}:campaign/*), the call was denied live in the Personalize Bindings suite; the grant stays on *."
    },
    "GetPersonalizedRanking": {
      "operation": "getPersonalizedRanking",
      "request": {
        "mode": "required"
      },
      "actions": ["personalize:GetPersonalizedRanking"],
      "module": "personalize-runtime",
      "arns": ["arn:${Partition}:personalize:${Region}:${Account}:campaign/*"]
    },
    "GetRecommendations": {
      "operation": "getRecommendations",
      "request": {
        "mode": "required"
      },
      "actions": ["personalize:GetRecommendations"],
      "module": "personalize-runtime",
      "arns": ["arn:${Partition}:personalize:${Region}:${Account}:campaign/*"]
    },
    "GetSolutionMetrics": {
      "operation": "getSolutionMetrics",
      "request": {
        "mode": "required"
      },
      "actions": ["personalize:GetSolutionMetrics"],
      "arns": ["arn:${Partition}:personalize:${Region}:${Account}:solution/*"]
    },
    "PutActionInteractions": {
      "operation": "putActionInteractions",
      "resource": "EventTracker",
      "param": "tracker",
      "request": {
        "mode": "required",
        "interface": "PutActionInteractionsRequest",
        "omit": ["trackingId"]
      },
      "builder": "makePersonalizeEventTrackerHttpBinding",
      "actions": ["personalize:PutActionInteractions"],
      "module": "personalize-events"
    },
    "PutActions": {
      "operation": "putActions",
      "resource": "Dataset",
      "request": {
        "mode": "required",
        "interface": "PutActionsRequest",
        "omit": ["datasetArn"]
      },
      "builder": "makePersonalizeDatasetHttpBinding",
      "actions": ["personalize:PutActions"],
      "module": "personalize-events"
    },
    "PutEvents": {
      "operation": "putEvents",
      "resource": "EventTracker",
      "param": "tracker",
      "request": {
        "mode": "required",
        "interface": "PutEventsRequest",
        "omit": ["trackingId"]
      },
      "builder": "makePersonalizeEventTrackerHttpBinding",
      "actions": ["personalize:PutEvents"],
      "module": "personalize-events"
    },
    "PutItems": {
      "operation": "putItems",
      "resource": "Dataset",
      "request": {
        "mode": "required",
        "interface": "PutItemsRequest",
        "omit": ["datasetArn"]
      },
      "builder": "makePersonalizeDatasetHttpBinding",
      "actions": ["personalize:PutItems"],
      "module": "personalize-events"
    },
    "PutUsers": {
      "operation": "putUsers",
      "resource": "Dataset",
      "request": {
        "mode": "required",
        "interface": "PutUsersRequest",
        "omit": ["datasetArn"]
      },
      "builder": "makePersonalizeDatasetHttpBinding",
      "actions": ["personalize:PutUsers"],
      "module": "personalize-events"
    },
    "UpdateCampaign": {
      "operation": "updateCampaign",
      "request": {
        "mode": "required"
      },
      "actions": ["personalize:UpdateCampaign"],
      "arns": ["arn:${Partition}:personalize:${Region}:${Account}:campaign/*"]
    }
  }
}
