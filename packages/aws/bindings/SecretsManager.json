{
  "tag": "AWS.SecretsManager",
  "module": "secrets-manager",
  "resources": {
    "Secret": {
      "file": "Secret.ts"
    }
  },
  "builder": "makeSecretHttpBinding",
  "builders": {
    "makeSecretHttpBinding": {
      "grants": "resource"
    },
    "makeSecretsManagerAccountHttpBinding": {
      "grants": "*"
    }
  },
  "bindings": {
    "DescribeSecret": {
      "operation": "describeSecret",
      "resource": "Secret",
      "request": {
        "mode": "none"
      },
      "actions": ["secretsmanager:DescribeSecret"]
    },
    "GetRandomPassword": {
      "operation": "getRandomPassword",
      "builder": "makeSecretsManagerAccountHttpBinding",
      "actions": ["secretsmanager:GetRandomPassword"]
    },
    "GetSecretValue": {
      "operation": "getSecretValue",
      "resource": "Secret",
      "request": {
        "mode": "optional",
        "interface": "GetSecretValueRequest",
        "omit": ["SecretId"]
      },
      "actions": ["secretsmanager:GetSecretValue"]
    },
    "ListSecretVersionIds": {
      "operation": "listSecretVersionIds",
      "resource": "Secret",
      "request": {
        "mode": "optional",
        "interface": "ListSecretVersionIdsRequest",
        "omit": ["SecretId"]
      },
      "actions": ["secretsmanager:ListSecretVersionIds"]
    },
    "ListSecrets": {
      "operation": "listSecrets",
      "builder": "makeSecretsManagerAccountHttpBinding",
      "actions": ["secretsmanager:ListSecrets"]
    },
    "PutSecretValue": {
      "operation": "putSecretValue",
      "resource": "Secret",
      "request": {
        "mode": "required",
        "interface": "PutSecretValueRequest",
        "omit": ["SecretId"]
      },
      "actions": ["secretsmanager:PutSecretValue", "secretsmanager:DescribeSecret"]
    },
    "RotateSecret": {
      "operation": "rotateSecret",
      "resource": "Secret",
      "request": {
        "mode": "optional",
        "interface": "RotateSecretRequest",
        "omit": ["SecretId"]
      },
      "actions": ["secretsmanager:RotateSecret", "secretsmanager:DescribeSecret"]
    },
    "UpdateSecretVersionStage": {
      "operation": "updateSecretVersionStage",
      "resource": "Secret",
      "request": {
        "mode": "required",
        "interface": "UpdateSecretVersionStageRequest",
        "omit": ["SecretId"]
      },
      "actions": ["secretsmanager:UpdateSecretVersionStage"]
    }
  }
}
