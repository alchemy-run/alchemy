{
  "tag": "AWS.QuickSight",
  "module": "quicksight",
  "resources": {
    "Dashboard": {
      "file": "Dashboard.ts"
    },
    "DataSet": {
      "file": "DataSet.ts"
    }
  },
  "builder": "makeQuickSightDataSetHttpBinding",
  "builders": {
    "makeQuickSightDashboardHttpBinding": {
      "grants": "resource"
    },
    "makeQuickSightDataSetHttpBinding": {
      "grants": "resource"
    }
  },
  "bindings": {
    "CancelIngestion": {
      "operation": "cancelIngestion",
      "resource": "DataSet",
      "request": {
        "mode": "required",
        "omit": ["AwsAccountId", "DataSetId"],
        "inline": true
      },
      "actions": ["quicksight:CancelIngestion"]
    },
    "CreateIngestion": {
      "operation": "createIngestion",
      "resource": "DataSet",
      "request": {
        "mode": "required",
        "omit": ["AwsAccountId", "DataSetId"],
        "inline": true
      },
      "actions": ["quicksight:CreateIngestion"]
    },
    "DescribeDashboardSnapshotJob": {
      "operation": "describeDashboardSnapshotJob",
      "resource": "Dashboard",
      "request": {
        "mode": "required",
        "omit": ["AwsAccountId", "DashboardId"],
        "inline": true
      },
      "builder": "makeQuickSightDashboardHttpBinding",
      "actions": ["quicksight:DescribeDashboardSnapshotJob"]
    },
    "DescribeDashboardSnapshotJobResult": {
      "operation": "describeDashboardSnapshotJobResult",
      "resource": "Dashboard",
      "request": {
        "mode": "required",
        "omit": ["AwsAccountId", "DashboardId"],
        "inline": true
      },
      "builder": "makeQuickSightDashboardHttpBinding",
      "actions": ["quicksight:DescribeDashboardSnapshotJobResult"]
    },
    "DescribeIngestion": {
      "operation": "describeIngestion",
      "resource": "DataSet",
      "request": {
        "mode": "required",
        "omit": ["AwsAccountId", "DataSetId"],
        "inline": true
      },
      "actions": ["quicksight:DescribeIngestion"]
    },
    "ListIngestions": {
      "operation": "listIngestions",
      "resource": "DataSet",
      "request": {
        "mode": "optional",
        "omit": ["AwsAccountId", "DataSetId"],
        "inline": true
      },
      "actions": ["quicksight:ListIngestions"]
    },
    "StartDashboardSnapshotJob": {
      "operation": "startDashboardSnapshotJob",
      "resource": "Dashboard",
      "request": {
        "mode": "required",
        "omit": ["AwsAccountId", "DashboardId"],
        "inline": true
      },
      "builder": "makeQuickSightDashboardHttpBinding",
      "actions": ["quicksight:StartDashboardSnapshotJob"]
    }
  }
}
