  "module": "identitystore",
  "resources": {
    "Instance": {
      "file": "Instance.ts"
    }
  },
  "builder": "makeIdentityStoreHttpBinding",
  "builders": {
    "makeIdentityCenterInstanceHttpBinding": {
      "grants": "resource"
    },
    "makeIdentityStoreHttpBinding": {
      "grants": "resource"
    }
  },
  "bindings": {
    "CreateGroupMembership": {
      "operation": "createGroupMembership",
      "resource": "Instance",
      "request": {
        "mode": "required",
        "omit": ["IdentityStoreId"],
        "inline": true
      }
    },
    "CreateUser": {
      "operation": "createUser",
      "resource": "Instance",
      "request": {
        "mode": "required",
        "omit": ["IdentityStoreId"],
        "inline": true
      }
    },
