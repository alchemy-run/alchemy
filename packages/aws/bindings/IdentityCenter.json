      "operation": "listGroups",
      "resource": "Instance",
      "request": {
        "mode": "optional",
        "omit": ["IdentityStoreId"],
        "inline": true
      }
    },
    "ListPermissionSets": {
      "operation": "listPermissionSets",
      "resource": "Instance",
      "request": {
        "mode": "optional",
        "omit": ["InstanceArn"],
