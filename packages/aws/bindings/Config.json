{
  "tag": "AWS.Config",
  "module": "config-service",
  "alias": "config",
  "resources": {
    "ConfigRule": {
      "file": "ConfigRule.ts"
    },
    "DeliveryChannel": {
      "file": "DeliveryChannel.ts"
    }
  },
  "builder": "makeConfigAccountHttpBinding",
  "builders": {
    "makeConfigAccountHttpBinding": {
      "grants": "*",
      "arns": true
    },
    "makeConfigResourceHttpBinding": {
      "grants": "*",
      "arns": true
    }
  },
  "bindings": {
    "BatchGetResourceConfig": {
      "operation": "batchGetResourceConfig",
      "request": {
        "mode": "required"
      },
      "actions": ["config:BatchGetResourceConfig"]
    },
    "DeleteResourceConfig": {
      "operation": "deleteResourceConfig",
      "request": {
        "mode": "required"
      },
      "actions": ["config:DeleteResourceConfig"]
    },
    "DeliverConfigSnapshot": {
      "operation": "deliverConfigSnapshot",
      "resource": "DeliveryChannel",
      "param": "channel",
      "request": {
        "mode": "none"
      },
      "builder": "makeConfigResourceHttpBinding",
      "actions": ["config:DeliverConfigSnapshot"],
      "with": {
        "requestKey": "deliveryChannelName"
      },
      "withTs": {
        "identifier": "(channel: DeliveryChannel) => channel.deliveryChannelName"
      }
    },
    "DescribeComplianceByConfigRule": {
      "operation": "describeComplianceByConfigRule",
      "actions": ["config:DescribeComplianceByConfigRule"]
    },
    "DescribeComplianceByResource": {
      "operation": "describeComplianceByResource",
      "actions": ["config:DescribeComplianceByResource"]
    },
    "DescribeConfigRuleEvaluationStatus": {
      "operation": "describeConfigRuleEvaluationStatus",
      "actions": ["config:DescribeConfigRuleEvaluationStatus"]
    },
    "GetComplianceDetailsByConfigRule": {
      "operation": "getComplianceDetailsByConfigRule",
      "resource": "ConfigRule",
      "param": "rule",
      "request": {
        "mode": "optional",
        "interface": "GetComplianceDetailsByConfigRuleRequest",
        "omit": ["ConfigRuleName"]
      },
      "builder": "makeConfigResourceHttpBinding",
      "actions": ["config:GetComplianceDetailsByConfigRule"],
      "with": {
        "requestKey": "ConfigRuleName"
      },
      "withTs": {
        "identifier": "(rule: ConfigRule) => rule.configRuleName"
      },
      "arns": ["arn:${Partition}:config:${Region}:${Account}:config-rule/*"]
    },
    "GetComplianceDetailsByResource": {
      "operation": "getComplianceDetailsByResource",
      "actions": ["config:GetComplianceDetailsByResource"]
    },
    "GetComplianceSummaryByConfigRule": {
      "operation": "getComplianceSummaryByConfigRule",
      "actions": ["config:GetComplianceSummaryByConfigRule"]
    },
    "GetComplianceSummaryByResourceType": {
      "operation": "getComplianceSummaryByResourceType",
      "actions": ["config:GetComplianceSummaryByResourceType"]
    },
    "GetDiscoveredResourceCounts": {
      "operation": "getDiscoveredResourceCounts",
      "actions": ["config:GetDiscoveredResourceCounts"]
    },
    "GetResourceConfigHistory": {
      "operation": "getResourceConfigHistory",
      "request": {
        "mode": "required"
      },
      "actions": ["config:GetResourceConfigHistory"]
    },
    "GetResourceEvaluationSummary": {
      "operation": "getResourceEvaluationSummary",
      "request": {
        "mode": "required"
      },
      "actions": ["config:GetResourceEvaluationSummary"]
    },
    "ListDiscoveredResources": {
      "operation": "listDiscoveredResources",
      "request": {
        "mode": "required"
      },
      "actions": ["config:ListDiscoveredResources"]
    },
    "ListResourceEvaluations": {
      "operation": "listResourceEvaluations",
      "actions": ["config:ListResourceEvaluations"]
    },
    "PutEvaluations": {
      "operation": "putEvaluations",
      "request": {
        "mode": "required"
      },
      "actions": ["config:PutEvaluations"]
    },
    "PutExternalEvaluation": {
      "operation": "putExternalEvaluation",
      "resource": "ConfigRule",
      "param": "rule",
      "request": {
        "mode": "required",
        "interface": "PutExternalEvaluationRequest",
        "omit": ["ConfigRuleName"]
      },
      "builder": "makeConfigResourceHttpBinding",
      "actions": ["config:PutExternalEvaluation"],
      "with": {
        "requestKey": "ConfigRuleName"
      },
      "withTs": {
        "identifier": "(rule: ConfigRule) => rule.configRuleName"
      },
      "arns": ["arn:${Partition}:config:${Region}:${Account}:config-rule/*"]
    },
    "PutResourceConfig": {
      "operation": "putResourceConfig",
      "request": {
        "mode": "required"
      },
      "actions": ["config:PutResourceConfig"]
    },
    "SelectResourceConfig": {
      "operation": "selectResourceConfig",
      "request": {
        "mode": "required"
      },
      "actions": ["config:SelectResourceConfig"]
    },
    "StartConfigRulesEvaluation": {
      "operation": "startConfigRulesEvaluation",
      "resource": "ConfigRule",
      "param": "rule",
      "request": {
        "mode": "none"
      },
      "builder": "makeConfigResourceHttpBinding",
      "actions": ["config:StartConfigRulesEvaluation"],
      "with": {
        "requestKey": "ConfigRuleNames",
        "asList": true
      },
      "withTs": {
        "identifier": "(rule: ConfigRule) => rule.configRuleName"
      },
      "arns": ["arn:${Partition}:config:${Region}:${Account}:config-rule/*"]
    },
    "StartResourceEvaluation": {
      "operation": "startResourceEvaluation",
      "request": {
        "mode": "required"
      },
      "actions": ["config:StartResourceEvaluation", "cloudformation:DescribeType"],
      "note": "cloudformation:DescribeType is a dependent action: Config validates the CFN_RESOURCE_SCHEMA resource type schema with the CALLER's permissions and rejects with AccessDeniedException without it (observed live; see the StartResourceEvaluation API reference).",
      "reviewed": {
        "cloudformation:DescribeType": "See the note: cloudformation:DescribeType is a dependent action: Config validates the CFN_RESOURCE_SCHEMA resource type schema with the CALLER's permissions and rejects with AccessDeniedException without it (observed live; see the StartResourceEvaluation API reference)."
      }
    }
  }
}
