{
  "tag": "AWS.Polly",
  "module": "polly",
  "resources": {},
  "builder": "makePollyHttpBinding",
  "builders": {
    "makePollyHttpBinding": {
      "options": {
        "capability": "name",
        "iamActions": "actions",
        "operation": "operation"
      },
      "grants": "*",
      "arns": true
    }
  },
  "bindings": {
    "DescribeVoices": {
      "operation": "describeVoices"
    },
    "GetSpeechSynthesisTask": {
      "operation": "getSpeechSynthesisTask",
      "request": {
        "mode": "required"
      }
    },
    "ListLexicons": {
      "operation": "listLexicons"
    },
    "ListSpeechSynthesisTasks": {
      "operation": "listSpeechSynthesisTasks"
    },
    "StartSpeechSynthesisStream": {
      "operation": "startSpeechSynthesisStream",
      "request": {
        "mode": "required"
      }
    },
    "StartSpeechSynthesisTask": {
      "operation": "startSpeechSynthesisTask",
      "request": {
        "mode": "required"
      }
    }
  }
}
