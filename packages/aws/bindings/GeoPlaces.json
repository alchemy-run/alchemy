{
  "tag": "AWS.GeoPlaces",
  "module": "geo-places",
  "alias": "geoPlaces",
  "resources": {},
  "builder": "makeGeoPlacesHttpBinding",
  "builders": {
    "makeGeoPlacesHttpBinding": {
      "options": {
        "capability": "name",
        "iamActions": "actions",
        "operation": "operation"
      },
      "grants": "*",
      "arns": true
    }
  },
  "bindings": {
    "Autocomplete": {
      "operation": "autocomplete",
      "request": {
        "mode": "required"
      },
      "actions": ["geo-places:Autocomplete"],
      "arns": ["arn:${Partition}:geo-places:${Region}::provider/default"]
    },
    "Geocode": {
      "operation": "geocode",
      "request": {
        "mode": "required"
      },
      "actions": ["geo-places:Geocode"],
      "arns": ["arn:${Partition}:geo-places:${Region}::provider/default"]
    },
    "GetPlace": {
      "operation": "getPlace",
      "request": {
        "mode": "required"
      },
      "actions": ["geo-places:GetPlace"],
      "arns": ["arn:${Partition}:geo-places:${Region}::provider/default"]
    },
    "ReverseGeocode": {
      "operation": "reverseGeocode",
      "request": {
        "mode": "required"
      },
      "actions": ["geo-places:ReverseGeocode"],
      "arns": ["arn:${Partition}:geo-places:${Region}::provider/default"]
    },
    "SearchNearby": {
      "operation": "searchNearby",
      "request": {
        "mode": "required"
      },
      "actions": ["geo-places:SearchNearby"],
      "arns": ["arn:${Partition}:geo-places:${Region}::provider/default"]
    },
    "SearchText": {
      "operation": "searchText",
      "request": {
        "mode": "required"
      },
      "actions": ["geo-places:SearchText"],
      "arns": ["arn:${Partition}:geo-places:${Region}::provider/default"]
    },
    "Suggest": {
      "operation": "suggest",
      "request": {
        "mode": "required"
      },
      "actions": ["geo-places:Suggest"],
      "arns": ["arn:${Partition}:geo-places:${Region}::provider/default"]
    }
  }
}
