{
  "tag": "AWS.DynamoDB",
  "module": "dynamodb",
  "alias": "DynamoDB",
  "resources": {},
  "builder": "makeAccountHttpBinding",
  "builders": {
    "makeAccountHttpBinding": {
      "grants": "*"
    }
  },
  "bindings": {
    "ListTables": {
