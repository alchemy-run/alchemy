{
  "tag": "AWS.GreengrassV2",
  "module": "greengrassv2",
  "resources": {
    "ComponentVersion": {
      "file": "ComponentVersion.ts"
    },
    "Deployment": {
      "file": "Deployment.ts"
    }
  },
  "builder": "makeGreengrassAccountHttpBinding",
  "builders": {
    "makeGreengrassAccountHttpBinding": {
      "grants": "*",
      "arns": true
    },
    "makeGreengrassComponentHttpBinding": {
      "grants": "resource"
    },
    "makeGreengrassDeploymentHttpBinding": {}
  },
  "bindings": {
    "BatchAssociateClientDeviceWithCoreDevice": {
      "operation": "batchAssociateClientDeviceWithCoreDevice",
      "request": {
        "mode": "required"
      }
    },
    "BatchDisassociateClientDeviceFromCoreDevice": {
      "operation": "batchDisassociateClientDeviceFromCoreDevice",
      "request": {
        "mode": "required"
      }
    },
    "CancelDeployment": {
      "operation": "cancelDeployment",
      "resource": "Deployment",
      "request": {
        "mode": "optional",
        "omit": ["deploymentId"],
        "inline": true
      },
      "builder": "makeGreengrassDeploymentHttpBinding",
      "with": {
        "dependentActions": [
          "iot:CancelJob",
          "iot:DeleteThingShadow",
          "iot:DescribeJob",
          "iot:DescribeThing",
          "iot:DescribeThingGroup",
          "iot:GetThingShadow",
          "iot:UpdateJob",
          "iot:UpdateThingShadow"
        ]
      },
      "note": "Canceling a deployment cancels the backing IoT Job and resolves the thing/thing-group target with the caller's credentials."
    },
    "DeleteCoreDevice": {
      "operation": "deleteCoreDevice",
      "request": {
        "mode": "required"
      },
      "note": "Deleting a core device resolves the device's deployment job executions with the caller's credentials (documented dependent action)."
    },
    "DescribeComponent": {
      "operation": "describeComponent",
      "resource": "ComponentVersion",
      "param": "component",
      "request": {
        "mode": "optional",
        "omit": ["arn"],
        "inline": true
      },
      "builder": "makeGreengrassComponentHttpBinding"
    },
    "GetComponent": {
      "operation": "getComponent",
      "resource": "ComponentVersion",
      "param": "component",
      "request": {
        "mode": "optional",
        "omit": ["arn"],
        "inline": true
      },
      "builder": "makeGreengrassComponentHttpBinding"
    },
    "GetComponentVersionArtifact": {
      "operation": "getComponentVersionArtifact",
      "resource": "ComponentVersion",
      "param": "component",
      "request": {
        "mode": "required",
        "omit": ["arn"],
        "inline": true
      },
      "builder": "makeGreengrassComponentHttpBinding"
    },
    "GetConnectivityInfo": {
      "operation": "getConnectivityInfo",
      "request": {
        "mode": "required"
      },
      "note": "Connectivity info is stored in IoT Core; Greengrass reads it with the caller's credentials (documented dependent action)."
    },
    "GetCoreDevice": {
      "operation": "getCoreDevice",
      "request": {
        "mode": "required"
      },
      "note": "Core devices are IoT things; Greengrass authorizes the IoT-side lookup with the caller's credentials before resolving the device (observed \"not authorized to call Iot Core services for thing\" without it)."
    },
    "GetDeployment": {
      "operation": "getDeployment",
      "resource": "Deployment",
      "request": {
        "mode": "optional",
        "omit": ["deploymentId"],
        "inline": true
      },
      "builder": "makeGreengrassDeploymentHttpBinding",
      "with": {
        "dependentActions": [
          "iot:DescribeJob",
          "iot:DescribeThing",
          "iot:DescribeThingGroup",
          "iot:GetThingShadow"
        ]
      },
      "note": "Deployments are backed by IoT Jobs; reading one resolves the job and the thing/thing-group target with the caller's credentials."
    },
    "ListClientDevicesAssociatedWithCoreDevice": {
      "operation": "listClientDevicesAssociatedWithCoreDevice",
      "request": {
        "mode": "required"
      }
    },
    "ListComponentVersions": {
      "operation": "listComponentVersions",
      "request": {
        "mode": "required"
      }
    },
    "ListComponents": {
      "operation": "listComponents"
    },
    "ListCoreDevices": {
      "operation": "listCoreDevices"
    },
    "ListDeployments": {
      "operation": "listDeployments",
      "note": "Enumerating deployments resolves each deployment's backing IoT Job and thing/thing-group target with the caller's credentials."
    },
    "ListEffectiveDeployments": {
      "operation": "listEffectiveDeployments",
      "request": {
        "mode": "required"
      },
      "note": "Effective deployments are backed by IoT Jobs; enumerating them resolves each job, its execution on the device, and the thing/thing-group target with the caller's credentials (documented dependent actions)."
    },
    "ListInstalledComponents": {
      "operation": "listInstalledComponents",
      "request": {
        "mode": "required"
      }
    },
    "ResolveComponentCandidates": {
      "operation": "resolveComponentCandidates"
    },
    "UpdateConnectivityInfo": {
      "operation": "updateConnectivityInfo",
      "request": {
        "mode": "required"
      },
      "note": "Connectivity info is stored in IoT Core; Greengrass writes it with the caller's credentials (documented dependent action)."
    }
  }
}
