{
  "tag": "AWS.Kafka",
  "module": "kafka",
  "resources": {
    "ServerlessCluster": {
      "file": "ServerlessCluster.ts"
    }
  },
  "builder": "makeKafkaClusterHttpBinding",
  "builders": {
    "makeKafkaClusterHttpBinding": {
      "grants": "resource"
    }
  },
  "bindings": {
    "CreateTopic": {
      "operation": "createTopic",
      "resource": "ServerlessCluster",
      "param": "cluster",
      "request": {
        "mode": "required",
        "omit": ["ClusterArn"],
        "inline": true
      },
      "with": {
        "topicScoped": true
      },
      "note": "The control-plane action authorizes against the topic ARN; the kafka-cluster analogs cover the underlying Kafka admin operation."
    },
    "DeleteTopic": {
      "operation": "deleteTopic",
      "resource": "ServerlessCluster",
      "param": "cluster",
      "request": {
        "mode": "required",
        "omit": ["ClusterArn"],
        "inline": true
      },
      "with": {
        "topicScoped": true
      }
    },
    "DescribeTopic": {
      "operation": "describeTopic",
      "resource": "ServerlessCluster",
      "param": "cluster",
      "request": {
        "mode": "required",
        "omit": ["ClusterArn"],
        "inline": true
      },
      "with": {
        "topicScoped": true
      }
    },
    "DescribeTopicPartitions": {
      "operation": "describeTopicPartitions",
      "resource": "ServerlessCluster",
      "param": "cluster",
      "request": {
        "mode": "required",
        "omit": ["ClusterArn"],
        "inline": true
      },
      "with": {
        "topicScoped": true
      }
    },
    "GetBootstrapBrokers": {
      "operation": "getBootstrapBrokers",
      "resource": "ServerlessCluster",
      "param": "cluster",
      "request": {
        "mode": "none"
      }
    },
    "ListTopics": {
      "operation": "listTopics",
      "resource": "ServerlessCluster",
      "param": "cluster",
      "request": {
        "mode": "optional",
        "omit": ["ClusterArn"],
        "inline": true
      },
      "with": {
        "topicScoped": true
      }
    },
    "UpdateTopic": {
      "operation": "updateTopic",
      "resource": "ServerlessCluster",
      "param": "cluster",
      "request": {
        "mode": "required",
        "omit": ["ClusterArn"],
        "inline": true
      },
      "with": {
        "topicScoped": true
      }
    }
  }
}
