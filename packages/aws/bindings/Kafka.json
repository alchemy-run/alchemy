{
  "tag": "AWS.Kafka",
  "module": "kafka",
  "resources": {
    "ServerlessCluster": {
      "file": "ServerlessCluster.ts"
    }
  },
  "builder": "makeKafkaClusterHttpBinding",
  "builders": {
    "makeKafkaClusterHttpBinding": {
      "grants": "resource"
    }
  },
  "bindings": {
    "CreateTopic": {
      "operation": "createTopic",
      "resource": "ServerlessCluster",
      "param": "cluster",
      "request": {
        "mode": "required",
        "omit": ["ClusterArn"],
        "inline": true
      },
      "actions": ["kafka:CreateTopic", "kafka-cluster:Connect", "kafka-cluster:CreateTopic"],
      "with": {
        "topicScoped": true
      },
      "note": "The control-plane action authorizes against the topic ARN; the kafka-cluster analogs cover the underlying Kafka admin operation.",
      "reviewed": {
        "kafka:CreateTopic": "The MSK topic API authorizes the control-plane kafka: action on the topic as well as the kafka-cluster: data-plane ones."
      }
    },
    "DeleteTopic": {
      "operation": "deleteTopic",
      "resource": "ServerlessCluster",
      "param": "cluster",
      "request": {
        "mode": "required",
        "omit": ["ClusterArn"],
        "inline": true
      },
      "actions": [
        "kafka:DeleteTopic",
        "kafka-cluster:Connect",
        "kafka-cluster:DeleteTopic",
        "kafka-cluster:DescribeTopic"
      ],
      "with": {
        "topicScoped": true
      },
      "reviewed": {
        "kafka:DeleteTopic": "The MSK topic API authorizes the control-plane kafka: action on the topic as well as the kafka-cluster: data-plane ones."
      }
    },
    "DescribeTopic": {
      "operation": "describeTopic",
      "resource": "ServerlessCluster",
      "param": "cluster",
      "request": {
        "mode": "required",
        "omit": ["ClusterArn"],
        "inline": true
      },
      "actions": [
        "kafka:DescribeTopic",
        "kafka-cluster:Connect",
        "kafka-cluster:DescribeTopic",
        "kafka-cluster:DescribeTopicDynamicConfiguration"
      ],
      "with": {
        "topicScoped": true
      },
      "reviewed": {
        "kafka:DescribeTopic": "The MSK topic API authorizes the control-plane kafka: action on the topic as well as the kafka-cluster: data-plane ones."
      }
    },
    "DescribeTopicPartitions": {
      "operation": "describeTopicPartitions",
      "resource": "ServerlessCluster",
      "param": "cluster",
      "request": {
        "mode": "required",
        "omit": ["ClusterArn"],
        "inline": true
      },
      "actions": [
        "kafka:DescribeTopicPartitions",
        "kafka-cluster:Connect",
        "kafka-cluster:DescribeTopic",
        "kafka-cluster:DescribeTopicDynamicConfiguration"
      ],
      "with": {
        "topicScoped": true
      },
      "reviewed": {
        "kafka:DescribeTopicPartitions": "The MSK topic API authorizes the control-plane kafka: action on the topic as well as the kafka-cluster: data-plane ones."
      }
    },
    "GetBootstrapBrokers": {
      "operation": "getBootstrapBrokers",
      "resource": "ServerlessCluster",
      "param": "cluster",
      "request": {
        "mode": "none"
      },
      "actions": ["kafka:GetBootstrapBrokers"]
    },
    "ListTopics": {
      "operation": "listTopics",
      "resource": "ServerlessCluster",
      "param": "cluster",
      "request": {
        "mode": "optional",
        "omit": ["ClusterArn"],
        "inline": true
      },
      "actions": ["kafka:ListTopics", "kafka-cluster:Connect", "kafka-cluster:DescribeTopic"],
      "with": {
        "topicScoped": true
      },
      "reviewed": {
        "kafka:ListTopics": "The MSK topic API authorizes the control-plane kafka: action on the topic as well as the kafka-cluster: data-plane ones."
      }
    },
    "UpdateTopic": {
      "operation": "updateTopic",
      "resource": "ServerlessCluster",
      "param": "cluster",
      "request": {
        "mode": "required",
        "omit": ["ClusterArn"],
        "inline": true
      },
      "actions": [
        "kafka:UpdateTopic",
        "kafka-cluster:Connect",
        "kafka-cluster:AlterTopic",
        "kafka-cluster:AlterTopicDynamicConfiguration",
        "kafka-cluster:DescribeTopic"
      ],
      "with": {
        "topicScoped": true
      },
      "reviewed": {
        "kafka:UpdateTopic": "The MSK topic API authorizes the control-plane kafka: action on the topic as well as the kafka-cluster: data-plane ones."
      }
    }
  }
}
