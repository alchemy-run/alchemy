{
  "tag": "AWS.DMS",
  "module": "database-migration-service",
  "alias": "dms",
  "resources": {
    "Endpoint": {
      "file": "Endpoint.ts"
    },
    "ReplicationInstance": {
      "file": "ReplicationInstance.ts"
    }
  },
  "builder": "makeDmsAccountHttpBinding",
  "builders": {
    "makeDmsAccountHttpBinding": {
      "grants": "*"
    },
    "makeDmsEndpointScopedHttpBinding": {
      "grants": "*"
    },
    "makeDmsInstanceScopedHttpBinding": {
      "grants": "resource"
    }
  },
  "bindings": {
    "DescribeConnections": {
      "operation": "describeConnections",
      "actions": ["dms:DescribeConnections"]
    },
    "DescribeEndpointSettings": {
      "operation": "describeEndpointSettings",
      "request": {
        "mode": "required"
      },
      "actions": ["dms:DescribeEndpointSettings"]
    },
    "DescribeEvents": {
      "operation": "describeEvents",
      "actions": ["dms:DescribeEvents"]
    },
    "DescribeOrderableReplicationInstances": {
      "operation": "describeOrderableReplicationInstances",
      "actions": ["dms:DescribeOrderableReplicationInstances"]
    },
    "DescribeRefreshSchemasStatus": {
      "operation": "describeRefreshSchemasStatus",
      "resource": "Endpoint",
      "request": {
        "mode": "none"
      },
      "builder": "makeDmsEndpointScopedHttpBinding",
      "actions": ["dms:DescribeRefreshSchemasStatus"]
    },
    "DescribeReplicationInstanceTaskLogs": {
      "operation": "describeReplicationInstanceTaskLogs",
      "resource": "ReplicationInstance",
      "param": "instance",
      "request": {
        "mode": "optional",
        "omit": ["ReplicationInstanceArn"],
        "inline": true
      },
      "builder": "makeDmsInstanceScopedHttpBinding",
      "actions": ["dms:DescribeReplicationInstanceTaskLogs"],
      "with": {
        "iam": "wildcard"
      }
    },
    "DescribeReplicationTasks": {
      "operation": "describeReplicationTasks",
      "actions": ["dms:DescribeReplicationTasks"]
    },
    "DescribeReplications": {
      "operation": "describeReplications",
      "actions": ["dms:DescribeReplications"]
    },
    "DescribeSchemas": {
      "operation": "describeSchemas",
      "resource": "Endpoint",
      "request": {
        "mode": "optional",
        "omit": ["EndpointArn"],
        "inline": true
      },
      "builder": "makeDmsEndpointScopedHttpBinding",
      "actions": ["dms:DescribeSchemas"]
    },
    "DescribeTableStatistics": {
      "operation": "describeTableStatistics",
      "request": {
        "mode": "required"
      },
      "actions": ["dms:DescribeTableStatistics"]
    },
    "RebootReplicationInstance": {
      "operation": "rebootReplicationInstance",
      "resource": "ReplicationInstance",
      "param": "instance",
      "request": {
        "mode": "optional",
        "omit": ["ReplicationInstanceArn"],
        "inline": true
      },
      "builder": "makeDmsInstanceScopedHttpBinding",
      "actions": ["dms:RebootReplicationInstance"],
      "with": {
        "iam": "resource"
      }
    },
    "ReloadTables": {
      "operation": "reloadTables",
      "request": {
        "mode": "required"
      },
      "actions": ["dms:ReloadTables"]
    },
    "StartReplication": {
      "operation": "startReplication",
      "request": {
        "mode": "required"
      },
      "actions": ["dms:StartReplication"]
    },
    "StartReplicationTask": {
      "operation": "startReplicationTask",
      "request": {
        "mode": "required"
      },
      "actions": ["dms:StartReplicationTask"]
    },
    "StopReplication": {
      "operation": "stopReplication",
      "request": {
        "mode": "required"
      },
      "actions": ["dms:StopReplication"]
    },
    "StopReplicationTask": {
      "operation": "stopReplicationTask",
      "request": {
        "mode": "required"
      },
      "actions": ["dms:StopReplicationTask"]
    }
  }
}
