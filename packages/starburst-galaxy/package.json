{
  "name": "@alchemy.run/starburst-galaxy",
  "version": "2.0.0-beta.85",
  "description": "Starburst Galaxy clusters, catalogs, roles, privileges and governance for Alchemy.",
  "keywords": [
    "alchemy",
    "effect",
    "infrastructure-as-code",
    "starburst",
    "starburst-galaxy",
    "trino"
  ],
  "homepage": "https://alchemy.run",
  "bugs": {
    "url": "https://github.com/alchemy-run/alchemy/issues"
  },
  "license": "Apache-2.0",
  "author": "Sam Goodwin <sam@alchemy.run>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alchemy-run/alchemy.git",
    "directory": "packages/starburst-galaxy"
  },
  "files": [
    "lib",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./Catalog": "./src/Catalog/index.ts",
    "./CloudAccess": "./src/CloudAccess/index.ts",
    "./Cluster": "./src/Cluster/index.ts",
    "./DataProduct": "./src/DataProduct/index.ts",
    "./Discovery": "./src/Discovery/index.ts",
    "./Governance": "./src/Governance/index.ts",
    "./Network": "./src/Network/index.ts",
    "./Role": "./src/Role/index.ts",
    "./ServiceAccount": "./src/ServiceAccount/index.ts",
    "./SqlJob": "./src/SqlJob/index.ts",
    "./User": "./src/User/index.ts",
    "./*": "./src/*.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "bun": "./src/index.ts",
        "worker": "./src/index.ts",
        "default": "./lib/index.js"
      },
      "./Catalog": {
        "types": "./lib/Catalog/index.d.ts",
        "bun": "./src/Catalog/index.ts",
        "worker": "./src/Catalog/index.ts",
        "default": "./lib/Catalog/index.js"
      },
      "./CloudAccess": {
        "types": "./lib/CloudAccess/index.d.ts",
        "bun": "./src/CloudAccess/index.ts",
        "worker": "./src/CloudAccess/index.ts",
        "default": "./lib/CloudAccess/index.js"
      },
      "./Cluster": {
        "types": "./lib/Cluster/index.d.ts",
        "bun": "./src/Cluster/index.ts",
        "worker": "./src/Cluster/index.ts",
        "default": "./lib/Cluster/index.js"
      },
      "./DataProduct": {
        "types": "./lib/DataProduct/index.d.ts",
        "bun": "./src/DataProduct/index.ts",
        "worker": "./src/DataProduct/index.ts",
        "default": "./lib/DataProduct/index.js"
      },
      "./Discovery": {
        "types": "./lib/Discovery/index.d.ts",
        "bun": "./src/Discovery/index.ts",
        "worker": "./src/Discovery/index.ts",
        "default": "./lib/Discovery/index.js"
      },
      "./Governance": {
        "types": "./lib/Governance/index.d.ts",
        "bun": "./src/Governance/index.ts",
        "worker": "./src/Governance/index.ts",
        "default": "./lib/Governance/index.js"
      },
      "./Network": {
        "types": "./lib/Network/index.d.ts",
        "bun": "./src/Network/index.ts",
        "worker": "./src/Network/index.ts",
        "default": "./lib/Network/index.js"
      },
      "./Role": {
        "types": "./lib/Role/index.d.ts",
        "bun": "./src/Role/index.ts",
        "worker": "./src/Role/index.ts",
        "default": "./lib/Role/index.js"
      },
      "./ServiceAccount": {
        "types": "./lib/ServiceAccount/index.d.ts",
        "bun": "./src/ServiceAccount/index.ts",
        "worker": "./src/ServiceAccount/index.ts",
        "default": "./lib/ServiceAccount/index.js"
      },
      "./SqlJob": {
        "types": "./lib/SqlJob/index.d.ts",
        "bun": "./src/SqlJob/index.ts",
        "worker": "./src/SqlJob/index.ts",
        "default": "./lib/SqlJob/index.js"
      },
      "./User": {
        "types": "./lib/User/index.d.ts",
        "bun": "./src/User/index.ts",
        "worker": "./src/User/index.ts",
        "default": "./lib/User/index.js"
      },
      "./internal": null,
      "./*": {
        "types": "./lib/*.d.ts",
        "bun": "./src/*.ts",
        "worker": "./src/*.ts",
        "default": "./lib/*.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "pnpm -r --filter \"{.}...\" run build:package",
    "build:package": "node scripts/build.ts"
  },
  "dependencies": {
    "@distilled.cloud/core": "workspace:*",
    "@distilled.cloud/starburst-galaxy": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "alchemy": "workspace:*",
    "effect": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "alchemy": "workspace:*",
    "effect": "catalog:"
  },
  "alchemy": {
    "contributes": [
      "@alchemy.run/starburst-galaxy/Contributions"
    ]
  }
}
