  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "default": "./lib/index.js",
      "types": "./lib/index.d.ts"
    }
  },
  "dependencies": {
    "@ai-sdk/harness-opencode": "catalog:",
    "@alchemy.run/harness-ai-sdk": "workspace:*",
