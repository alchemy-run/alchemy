  "repository": {
    "type": "git",
    "url": "git+https://github.com/alchemy-run/alchemy-effect.git",
    "directory": "packages/@alchemy.run/harness-opencode"
  },
  "files": [
    "lib",
    "src"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "doppler run -- bun test",
