{
  "extends": "../../../tsconfig.cloudflare.json",
  "include": ["../src/astro", "test", "vitest.config.ts"],
  "exclude": ["../src/astro/runtime"],
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "types": ["node"],
    // See tsconfig.node.json — dedupe vite's types across bun's peer-hashed
    // instances.
    "paths": {
      "vite": ["./node_modules/vite/dist/node/index.d.ts"],
      "vite/module-runner": ["./node_modules/vite/dist/node/module-runner.d.ts"]
    }
  }
}
