{
  "name": "@alchemy.run/portless",
  "version": "2.0.0-beta.84",
  "description": "Stable HTTPS .localhost URLs for dev servers and local ports, through a shared Portless proxy.",
  "keywords": [
    "alchemy",
    "dev-server",
    "effect",
    "https",
    "infrastructure-as-code",
    "localhost",
    "portless",
    "proxy"
  ],
  "homepage": "https://alchemy.run",
  "bugs": {
    "url": "https://github.com/alchemy-run/alchemy/issues"
  },
  "license": "Apache-2.0",
  "author": "Sam Goodwin <sam@alchemy.run>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alchemy-run/alchemy.git",
    "directory": "packages/portless"
  },
  "files": [
    "lib",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "bun": "./src/index.ts",
        "default": "./lib/index.js"
      },
      "./internal/*": null,
      "./*": {
        "types": "./lib/*.d.ts",
        "bun": "./src/*.ts",
        "default": "./lib/*.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "pnpm -r --filter \"{.}...\" run build:package",
    "build:package": "node scripts/build.ts"
  },
  "dependencies": {
    "portless": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "alchemy": "workspace:*",
    "effect": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "alchemy": "workspace:*",
    "effect": "catalog:"
  },
  "alchemy": {
    "contributes": [
      "@alchemy.run/portless/Contributions"
    ]
  }
}
