{
  "name": "@alchemy.run/pi",
  "version": "2.0.0-beta.85",
  "description": "Pi Durable agent harnesses for Alchemy: durable conversations, typed tools and models as Effect Layers.",
  "keywords": [
    "agents",
    "ai",
    "alchemy",
    "effect",
    "harness",
    "pi"
  ],
  "homepage": "https://alchemy.run",
  "bugs": {
    "url": "https://github.com/alchemy-run/alchemy/issues"
  },
  "license": "Apache-2.0",
  "author": "Sam Goodwin <sam@alchemy.run>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alchemy-run/alchemy.git",
    "directory": "packages/pi"
  },
  "files": [
    "lib",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./Cloudflare": "./src/Cloudflare/index.ts",
    "./*": "./src/*.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "bun": "./src/index.ts",
        "worker": "./src/index.ts",
        "default": "./lib/index.js"
      },
      "./Cloudflare": {
        "types": "./lib/Cloudflare/index.d.ts",
        "bun": "./src/Cloudflare/index.ts",
        "worker": "./src/Cloudflare/index.ts",
        "default": "./lib/Cloudflare/index.js"
      },
      "./internal/*": null,
      "./*": {
        "types": "./lib/*.d.ts",
        "bun": "./src/*.ts",
        "worker": "./src/*.ts",
        "default": "./lib/*.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "pnpm -r --filter \"{.}...\" run build:package",
    "build:package": "node scripts/build.ts"
  },
  "dependencies": {
    "@earendil-works/chord": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-codemode": "1.5.0",
    "@earendil-works/pi-durable": "1.5.0",
    "@earendil-works/pi-schema": "1.5.0"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "workspace:*",
    "@types/bun": "catalog:",
    "alchemy": "workspace:*",
    "effect": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@alchemy.run/cloudflare": "workspace:*",
    "alchemy": "workspace:*",
    "effect": "catalog:"
  },
  "peerDependenciesMeta": {
    "@alchemy.run/cloudflare": {
      "optional": true
    }
  }
}
