  "scopeName": "inline.alchemy-prose",
  "injectionSelector": "L:source.ts -comment -string -meta.embedded.block.alchemy-prose, L:source.tsx -comment -string -meta.embedded.block.alchemy-prose, L:source.js -comment -string -meta.embedded.block.alchemy-prose, L:source.jsx -comment -string -meta.embedded.block.alchemy-prose, L:source.js.jsx -comment -string -meta.embedded.block.alchemy-prose",
  "patterns": [
    {
      "include": "#typescript-template"
    },
