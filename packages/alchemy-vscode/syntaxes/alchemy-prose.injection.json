    "typescript-template": {
      "comment": "typescript`…` (alchemy/Code) — a block of generated code written inline, so the body is highlighted as TypeScript rather than as a string. Listed before the prose rules: a bare `typescript` tag would otherwise never be reached. Like them it begins at the tag rather than at the backtick, so the host grammar's own tagged-template rule cannot match first and win.",
      "begin": "(?<![_$[:alnum:]])((?:[_$[:alpha:]][_$[:alnum:]]*\\s*\\??\\.\\s*)*)(typescript)\\s*(`)",
      "beginCaptures": {
        "1": {
          "patterns": [
            {
              "include": "source.ts"
            }
