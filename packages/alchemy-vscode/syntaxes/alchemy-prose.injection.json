        }
      },
      "contentName": "meta.embedded.block.typescript",
      "patterns": [
        {
          "include": "#splice"
        },
        {
          "include": "#escape"
        },
        {
          "include": "#code-line-ts"
        }
      ]
    },
    "markdown-template": {
      "comment": "markdown`…` (alchemy/Code) — a document written inline, given the same Markdown treatment as charter prose.",
      "begin": "(?<![_$[:alnum:]])((?:[_$[:alpha:]][_$[:alnum:]]*\\s*\\??\\.\\s*)*)(markdown)\\s*(`)",
      "beginCaptures": {
        "1": {
