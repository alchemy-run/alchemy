{
  "name": "@alchemy.run/rivet",
  "version": "2.0.0-beta.84",
  "description": "Durable Objects on Rivet 3 control planes, with nodes hosted on any cloud, for Alchemy.",
  "keywords": [
    "actors",
    "alchemy",
    "durable-objects",
    "effect",
    "infrastructure-as-code",
    "rivet"
  ],
  "homepage": "https://alchemy.run",
  "bugs": {
    "url": "https://github.com/alchemy-run/alchemy/issues"
  },
  "license": "Apache-2.0",
  "author": "Sam Goodwin <sam@alchemy.run>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alchemy-run/alchemy.git",
    "directory": "packages/rivet"
  },
  "files": [
    "images",
    "lib",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./AWS": "./src/AWS/index.ts",
    "./Cloud": "./src/Cloud/index.ts",
    "./Docker": "./src/Docker/index.ts",
    "./*": "./src/*.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "bun": "./src/index.ts",
        "worker": "./src/index.ts",
        "default": "./lib/index.js"
      },
      "./AWS": {
        "types": "./lib/AWS/index.d.ts",
        "bun": "./src/AWS/index.ts",
        "worker": "./src/AWS/index.ts",
        "default": "./lib/AWS/index.js"
      },
      "./Cloud": {
        "types": "./lib/Cloud/index.d.ts",
        "bun": "./src/Cloud/index.ts",
        "worker": "./src/Cloud/index.ts",
        "default": "./lib/Cloud/index.js"
      },
      "./Docker": {
        "types": "./lib/Docker/index.d.ts",
        "bun": "./src/Docker/index.ts",
        "worker": "./src/Docker/index.ts",
        "default": "./lib/Docker/index.js"
      },
      "./internal/*": null,
      "./*": {
        "types": "./lib/*.d.ts",
        "bun": "./src/*.ts",
        "worker": "./src/*.ts",
        "default": "./lib/*.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "pnpm -r --filter \"{.}...\" run build:package",
    "build:package": "node scripts/build.ts"
  },
  "dependencies": {
    "@distilled.cloud/core": "workspace:*",
    "@distilled.cloud/rivet": "workspace:*",
    "@effect/platform-bun": "catalog:",
    "rivetkit": "3.0.0-preview.4"
  },
  "devDependencies": {
    "@alchemy.run/aws": "workspace:*",
    "@alchemy.run/docker": "workspace:*",
    "@types/bun": "catalog:",
    "alchemy": "workspace:*",
    "effect": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@alchemy.run/aws": "workspace:*",
    "@alchemy.run/docker": "workspace:*",
    "alchemy": "workspace:*",
    "effect": "catalog:"
  },
  "peerDependenciesMeta": {
    "@alchemy.run/aws": {
      "optional": true
    },
    "@alchemy.run/docker": {
      "optional": true
    }
  }
}
