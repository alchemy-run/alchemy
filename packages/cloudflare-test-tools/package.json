{
  "name": "@alchemy.run/cloudflare-test-tools",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p miniflare/tsconfig.json && tsc -p e2e/tsconfig.json",
    "e2e": "bun run e2e/src/Cli.ts",
    "typecheck": "bun run build"
  },
  "dependencies": {
    "@alchemy.run/cloudflare-runtime": "workspace:*",
    "@alchemy.run/frameworks": "workspace:*",
    "@effect/platform-node": "catalog:effect",
    "effect": "catalog:effect",
    "miniflare": "catalog:workers"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "rolldown": "catalog:",
    "vite": "catalog:"
  },
  "exports": {
    "./e2e/Framework": "./e2e/src/Framework.ts",
    "./e2e/Options": "./e2e/src/Options.ts",
    "./e2e/Playwright": "./e2e/src/Playwright.ts",
    "./miniflare": "./miniflare/src/miniflare.ts",
    "./miniflare-module": "./miniflare/src/miniflare-module.ts"
  }
}
