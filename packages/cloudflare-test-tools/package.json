  },
  "dependencies": {
    "@alchemy.run/cloudflare-runtime": "workspace:*",
    "@alchemy.run/frontend-frameworks": "workspace:*",
    "@effect/platform-node": "catalog:effect",
    "effect": "catalog:effect",
    "miniflare": "catalog:workers"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "rolldown": "catalog:",
    "vite": "catalog:"
  },
  "exports": {
    "./e2e/Framework": "./src/e2e/Framework.ts",
    "./e2e/Options": "./src/e2e/Options.ts",
    "./e2e/Playwright": "./src/e2e/Playwright.ts",
    "./miniflare": "./src/miniflare/miniflare.ts",
    "./miniflare-module": "./src/miniflare/miniflare-module.ts"
