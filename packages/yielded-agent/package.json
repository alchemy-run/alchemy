{
  "name": "@alchemy.run/yielded-agent",
  "version": "2.0.0-beta.87",
  "description": "Yielded Agent on Alchemy: schema-defined agents and Threads in your runtime, with models, tools and sandboxes as Effect Layers.",
  "keywords": [
    "agents",
    "ai",
    "alchemy",
    "effect",
    "harness",
    "yielded"
  ],
  "homepage": "https://alchemy.run",
  "bugs": {
    "url": "https://github.com/alchemy-run/alchemy/issues"
  },
  "license": "Apache-2.0",
  "author": "Sam Goodwin <sam@alchemy.run>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alchemy-run/alchemy.git",
    "directory": "packages/yielded-agent"
  },
  "files": [
    "lib",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./Cloudflare": "./src/Cloudflare/index.ts",
    "./*": "./src/*.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "bun": "./src/index.ts",
        "worker": "./src/index.ts",
        "default": "./lib/index.js"
      },
      "./Cloudflare": {
        "types": "./lib/Cloudflare/index.d.ts",
        "bun": "./src/Cloudflare/index.ts",
        "worker": "./src/Cloudflare/index.ts",
        "default": "./lib/Cloudflare/index.js"
      },
      "./*": {
        "types": "./lib/*.d.ts",
        "bun": "./src/*.ts",
        "worker": "./src/*.ts",
        "default": "./lib/*.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "pnpm -r --filter \"{.}...\" run build:package",
    "build:package": "node scripts/build.ts"
  },
  "dependencies": {
    "@alchemy.run/ai": "workspace:*",
    "@yielded/agent": "0.1.0-beta.192"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "workspace:*",
    "@types/bun": "catalog:",
    "@yielded/agent-storage-cloudflare": "0.1.0-beta.192",
    "alchemy": "workspace:*",
    "effect": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@alchemy.run/cloudflare": "workspace:*",
    "@yielded/agent-storage-cloudflare": "0.1.0-beta.192",
    "alchemy": "workspace:*",
    "effect": "catalog:"
  },
  "peerDependenciesMeta": {
    "@alchemy.run/cloudflare": {
      "optional": true
    },
    "@yielded/agent-storage-cloudflare": {
      "optional": true
    }
  }
}
