{
  "name": "@alchemy.run/dashboard",
  "version": "2.0.0-beta.76",
  "description": "Web dashboard for alchemy stacks: the SPA behind `alchemy deploy --ui`, `alchemy dashboard`, and the hosted dashboard viewers.",
  "homepage": "https://alchemy.run",
  "license": "Apache-2.0",
  "author": "Sam Goodwin <sam@alchemy.run>",
  "keywords": [
    "alchemy",
    "dashboard",
    "effect",
    "infrastructure-as-code"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alchemy-run/alchemy.git",
    "directory": "packages/dashboard"
  },
  "bugs": {
    "url": "https://github.com/alchemy-run/alchemy/issues"
  },
  "type": "module",
  "files": [
    "dist",
    "NOTICE"
  ],
  "exports": {
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && bun ../../scripts/copy-package-files.ts dashboard",
    "clean": "rm -rf dist",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "bun test test/",
    "validate:ui": "bun scripts/validate-ui.ts --all",
    "prepublishOnly": "vite build"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:frontend",
    "@types/react": "catalog:frontend",
    "@types/react-dom": "catalog:frontend",
    "@vitejs/plugin-react": "catalog:frontend",
    "@xyflow/react": "^12.3.0",
    "alchemy": "workspace:*",
    "effect": "catalog:effect",
    "elkjs": "^0.10.0",
    "lucide-react": "^0.475.0",
    "motion": "^12.42.2",
    "react": "catalog:frontend",
    "react-dom": "catalog:frontend",
    "tailwindcss": "catalog:frontend",
    "vite": "catalog:build",
    "zustand": "^5"
  }
}
