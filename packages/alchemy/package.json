        "default": "./lib/Http/index.js"
      },
      "./Cli": {
        "types": "./lib/Cli/index.d.ts",
        "bun": "./src/Cli/index.ts",
        "default": "./lib/Cli/index.js"
      },
      "./Cli/CliKit": {
        "types": "./lib/Cli/CliKit/index.d.ts",
        "bun": "./src/Cli/CliKit/index.ts",
        "default": "./lib/Cli/CliKit/index.js"
      },
      "./Endpoint": {
        "types": "./lib/Endpoint/index.d.ts",
        "bun": "./src/Endpoint/index.ts",
        "default": "./lib/Endpoint/index.js"
      },
      "./Runtime/Bootstrap/*": {
        "types": "./src/Runtime/Bootstrap/*.ts",
        "bun": "./src/Runtime/Bootstrap/*.ts",
        "default": "./src/Runtime/Bootstrap/*.ts"
      },
      "./Process": {
        "types": "./lib/Process/index.d.ts",
        "bun": "./src/Process/index.ts",
        "default": "./lib/Process/index.js"
      },
      "./TUI": {
        "types": "./lib/TUI/index.d.ts",
        "bun": "./src/TUI/index.ts",
        "default": "./lib/TUI/index.js"
      },
      "./Secrets": {
        "types": "./lib/Secrets/index.d.ts",
        "bun": "./src/Secrets/index.ts",
        "default": "./lib/Secrets/index.js"
      },
      "./Server": {
        "types": "./lib/Server/index.d.ts",
        "bun": "./src/Server/index.ts",
        "default": "./lib/Server/index.js"
      },
      "./State": {
        "types": "./lib/State/index.d.ts",
        "bun": "./src/State/index.ts",
        "default": "./lib/State/index.js"
      },
      "./Util": {
        "types": "./lib/Util/index.d.ts",
        "bun": "./src/Util/index.ts",
        "default": "./lib/Util/index.js"
      },
      "./bin/alchemy.js": "./bin/alchemy.js",
      "./bin/exec.js": "./bin/exec.js"
    },
    "access": "public"
  },
  "scripts": {
    "build": "pnpm -r --filter \"{.}...\" run build:package",
    "build:package": "node scripts/build.ts",
    "clear:state": "cd ../../ && bun clear:state",
    "pretest": "pnpm -w ensure:built",
    "test": "alchemy-test --exclude test/Railway",
    "nuke": "cd ../../ && bun nuke"
  },
