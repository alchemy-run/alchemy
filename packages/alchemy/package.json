{
  "name": "alchemy",
  "version": "2.0.0-beta.83",
  "description": "Infrastructure as Effects for TypeScript.",
  "keywords": [
    "alchemy",
    "effect",
    "infrastructure-as-code"
  ],
  "homepage": "https://alchemy.run",
  "bugs": {
    "url": "https://github.com/alchemy-run/alchemy/issues"
  },
  "license": "Apache-2.0",
  "author": "Sam Goodwin <sam@alchemy.run>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alchemy-run/alchemy.git",
    "directory": "packages/alchemy"
  },
  "bin": {
    "alchemy": "./bin/cli.js"
  },
  "files": [
    "bin",
    "!bin/register-dev-mode.js",
    "lib",
    "src",
    "NOTICE",
    "THIRD_PARTY_LICENSES.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./AI": "./src/AI/index.ts",
    "./Workflows": "./src/Workflows.ts",
    "./Auth": "./src/Auth/index.ts",
    "./Alchemist": "./src/Alchemist/index.ts",
    "./Command": "./src/Command/index.ts",
    "./Construct": "./src/Construct/index.ts",
    "./Bundle": "./src/Bundle/index.ts",
    "./Http": "./src/Http/index.ts",
    "./Cli": "./src/Cli/index.ts",
    "./Cli/CliKit": "./src/Cli/CliKit/index.ts",
    "./Endpoint": "./src/Endpoint/index.ts",
    "./Runtime/Bootstrap/*": "./src/Runtime/Bootstrap/*.ts",
    "./Process": "./src/Process/index.ts",
    "./TUI": "./src/TUI/index.ts",
    "./Secrets": "./src/Secrets/index.ts",
    "./Server": "./src/Server/index.ts",
    "./State": "./src/State/index.ts",
    "./Util": "./src/Util/index.ts",
    "./bin/alchemy.js": "./bin/alchemy.js",
    "./bin/exec.js": "./bin/exec.js"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "bun": "./src/index.ts",
        "default": "./lib/index.js"
      },
      "./*": {
        "types": "./lib/*.d.ts",
        "bun": "./src/*.ts",
        "default": "./lib/*.js"
      },
      "./AI": {
        "types": "./lib/AI/index.d.ts",
        "bun": "./src/AI/index.ts",
        "default": "./lib/AI/index.js"
      },
      "./Workflows": {
        "types": "./lib/Workflows.d.ts",
        "bun": "./src/Workflows.ts",
        "default": "./lib/Workflows.js"
      },
      "./Auth": {
        "types": "./lib/Auth/index.d.ts",
        "bun": "./src/Auth/index.ts",
        "default": "./lib/Auth/index.js"
      },
      "./Alchemist": {
        "types": "./lib/Alchemist/index.d.ts",
        "bun": "./src/Alchemist/index.ts",
        "default": "./lib/Alchemist/index.js"
      },
      "./Command": {
        "types": "./lib/Command/index.d.ts",
        "bun": "./src/Command/index.ts",
        "default": "./lib/Command/index.js"
      },
      "./Construct": {
