{
  "extends": "../../tsconfig.base.json",
  "include": [
    "package.json",
    "test",
    // JSON modules imported by fixtures (plain `include: ["test"]` only
    // sweeps .ts files).
    "test/Cloudflare/Workers/fixtures/prisma-orm/generated/contract.json",
    "test/Prisma/ORM/fixtures/client/generated/contract.json"
  ],
  "exclude": [
    // prisma-next migration packages are self-emitting Node scripts whose
    // snapshot imports (`../../snapshots/<hash>/contract`) are extensionless
    // and only resolve under prisma-next's own toolchain — not this project.
    "test/Cloudflare/Workers/fixtures/prisma-orm/migrations",
    // Executed by the prisma-next CLI (which resolves its own toolchain
    // types); its inferred config type is not portable from this project.
    "test/Cloudflare/Workers/fixtures/prisma-orm/prisma-next.config.ts",
    "test/Prisma/ORM/fixtures/client/migrations",
    "test/Prisma/ORM/fixtures/client/prisma-next.config.ts",
    "test/Local/fixtures/rpc-server-entry.ts",
    "test/Local/fixtures/rpc-spawner-parent.ts",
    "test/Local/fixtures/rpc-spawner-devserver-parent.ts",
    // Nuxt fixture: server routes use nitro's auto-imported globals
    // (`defineEventHandler`), which only type-check against the `.nuxt/`
    // types a nuxt build generates.
    "test/Cloudflare/Website/fixtures/nuxt-app",
    "test/Cloudflare/Website/fixtures/nuxt-spa-app",
    // Octane fixture: `.tsx` components use octane's JSX runtime, which
    // conflicts with this package's default `@opentui/solid` jsxImportSource.
    "test/Cloudflare/Website/fixtures/octane-app",
    "test/Cloudflare/Website/fixtures/octane-spa-app"
  ],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "outDir": "./lib",
    "rootDir": ".",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "target": "ESNext",
    "paths": {
      "@/*": ["./src/*"]
    },
    // Solid is the default JSX runtime in this package; React files opt in per-file.
    "jsx": "react-jsx",
    "jsxImportSource": "@opentui/solid",
    "lib": ["DOM", "DOM.Iterable", "ES2023"]
  },
  "references": [
    {
      "path": "./tsconfig.json"
    },
    {
      "path": "../alchemy-test/tsconfig.json"
    },
    {
      "path": "./tsconfig.bin.json"
    }
  ]
}
