{
  "name": "@alchemy.run/stackit",
  "version": "2.0.0-beta.84",
  "description": "STACKIT (Schwarz Group's German cloud) projects, networks, DNS and object storage for Alchemy.",
  "keywords": [
    "alchemy",
    "effect",
    "infrastructure-as-code",
    "stackit"
  ],
  "homepage": "https://alchemy.run",
  "bugs": {
    "url": "https://github.com/alchemy-run/alchemy/issues"
  },
  "license": "Apache-2.0",
  "author": "Sam Goodwin <sam@alchemy.run>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alchemy-run/alchemy.git",
    "directory": "packages/stackit"
  },
  "files": [
    "lib",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./Bootstrap": "./src/Bootstrap.ts",
    "./ContainerRegistry": "./src/ContainerRegistry/index.ts",
    "./DNS": "./src/DNS/index.ts",
    "./Functions": "./src/Functions/index.ts",
    "./IaaS": "./src/IaaS/index.ts",
    "./IAM": "./src/IAM/index.ts",
    "./KMS": "./src/KMS/index.ts",
    "./LoadBalancer": "./src/LoadBalancer/index.ts",
    "./ObjectStorage": "./src/ObjectStorage/index.ts",
    "./PostgresFlex": "./src/PostgresFlex/index.ts",
    "./ResourceManager": "./src/ResourceManager/index.ts",
    "./SecretsManager": "./src/SecretsManager/index.ts",
    "./ServiceEnablement": "./src/ServiceEnablement/index.ts",
    "./SKE": "./src/SKE/index.ts",
    "./*": "./src/*.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "bun": "./src/index.ts",
        "worker": "./src/index.ts",
        "default": "./lib/index.js"
      },
      "./Bootstrap": {
        "types": "./src/Bootstrap.ts",
        "bun": "./src/Bootstrap.ts",
        "default": "./src/Bootstrap.ts"
      },
      "./ContainerRegistry": {
        "types": "./lib/ContainerRegistry/index.d.ts",
        "bun": "./src/ContainerRegistry/index.ts",
        "worker": "./src/ContainerRegistry/index.ts",
        "default": "./lib/ContainerRegistry/index.js"
      },
      "./DNS": {
        "types": "./lib/DNS/index.d.ts",
        "bun": "./src/DNS/index.ts",
        "worker": "./src/DNS/index.ts",
        "default": "./lib/DNS/index.js"
      },
      "./Functions": {
        "types": "./lib/Functions/index.d.ts",
        "bun": "./src/Functions/index.ts",
        "worker": "./src/Functions/index.ts",
        "default": "./lib/Functions/index.js"
      },
      "./IaaS": {
        "types": "./lib/IaaS/index.d.ts",
        "bun": "./src/IaaS/index.ts",
        "worker": "./src/IaaS/index.ts",
        "default": "./lib/IaaS/index.js"
      },
      "./IAM": {
        "types": "./lib/IAM/index.d.ts",
        "bun": "./src/IAM/index.ts",
        "worker": "./src/IAM/index.ts",
        "default": "./lib/IAM/index.js"
      },
      "./KMS": {
        "types": "./lib/KMS/index.d.ts",
        "bun": "./src/KMS/index.ts",
        "worker": "./src/KMS/index.ts",
        "default": "./lib/KMS/index.js"
      },
      "./LoadBalancer": {
        "types": "./lib/LoadBalancer/index.d.ts",
        "bun": "./src/LoadBalancer/index.ts",
        "worker": "./src/LoadBalancer/index.ts",
        "default": "./lib/LoadBalancer/index.js"
      },
      "./ObjectStorage": {
        "types": "./lib/ObjectStorage/index.d.ts",
        "bun": "./src/ObjectStorage/index.ts",
        "worker": "./src/ObjectStorage/index.ts",
        "default": "./lib/ObjectStorage/index.js"
      },
      "./PostgresFlex": {
        "types": "./lib/PostgresFlex/index.d.ts",
        "bun": "./src/PostgresFlex/index.ts",
        "worker": "./src/PostgresFlex/index.ts",
        "default": "./lib/PostgresFlex/index.js"
      },
      "./ResourceManager": {
        "types": "./lib/ResourceManager/index.d.ts",
        "bun": "./src/ResourceManager/index.ts",
        "worker": "./src/ResourceManager/index.ts",
        "default": "./lib/ResourceManager/index.js"
      },
      "./SecretsManager": {
        "types": "./lib/SecretsManager/index.d.ts",
        "bun": "./src/SecretsManager/index.ts",
        "worker": "./src/SecretsManager/index.ts",
        "default": "./lib/SecretsManager/index.js"
      },
      "./ServiceEnablement": {
        "types": "./lib/ServiceEnablement/index.d.ts",
        "bun": "./src/ServiceEnablement/index.ts",
        "worker": "./src/ServiceEnablement/index.ts",
        "default": "./lib/ServiceEnablement/index.js"
      },
      "./SKE": {
        "types": "./lib/SKE/index.d.ts",
        "bun": "./src/SKE/index.ts",
        "worker": "./src/SKE/index.ts",
        "default": "./lib/SKE/index.js"
      },
      "./IAM/internal/*": null,
      "./internal/*": null,
      "./*/internal": null,
      "./*": {
        "types": "./lib/*.d.ts",
        "bun": "./src/*.ts",
        "worker": "./src/*.ts",
        "default": "./lib/*.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "pnpm -r --filter \"{.}...\" run build:package",
    "build:package": "node scripts/build.ts"
  },
  "dependencies": {
    "@alchemy.run/docker": "workspace:*",
    "@alchemy.run/kubernetes": "workspace:*",
    "@alchemy.run/sql": "workspace:*",
    "@distilled.cloud/aws": "workspace:*",
    "@distilled.cloud/core": "workspace:*",
    "@distilled.cloud/stackit": "workspace:*",
    "rolldown": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@types/bun": "catalog:",
    "alchemy": "workspace:*",
    "effect": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "alchemy": "workspace:*",
    "effect": "catalog:"
  },
  "peerDependenciesMeta": {
    "@effect/platform-bun": {
      "optional": true
    },
    "@effect/platform-node": {
      "optional": true
    }
  },
  "alchemy": {
    "contributes": [
      "@alchemy.run/stackit/Contributions"
    ]
  }
}
