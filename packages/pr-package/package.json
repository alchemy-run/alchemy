{
  "name": "@alchemy.run/pr-package",
  "version": "2.0.0-beta.77",
  "description": "Self-hostable PR package registry for Cloudflare built with Alchemy.",
  "keywords": [
    "alchemy",
    "cloudflare",
    "effect",
    "infrastructure-as-code"
  ],
  "homepage": "https://alchemy.run",
  "bugs": {
    "url": "https://github.com/alchemy-run/alchemy/issues"
  },
  "license": "Apache-2.0",
  "author": "Sam Goodwin <sam@alchemy.run>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alchemy-run/alchemy.git",
    "directory": "packages/pr-package"
  },
  "files": [
    "lib",
    "src",
    "NOTICE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "worker": "./src/index.ts",
      "import": "./lib/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b && bun ../../scripts/copy-package-files.ts pr-package",
    "test": "bun test ./test"
  },
  "dependencies": {
    "alchemy": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:"
  }
}
