{
  // Type-level regressions compiled the way a strict consumer compiles
  // against the package (#2959).
  "extends": "../../../../tsconfig.base.json",
  "include": ["*.ts"],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "outDir": "./lib",
    "rootDir": ".",
    "exactOptionalPropertyTypes": true,
    "lib": ["DOM", "DOM.Iterable", "ES2023"]
  },
  "references": [{ "path": "../../tsconfig.json" }]
}
