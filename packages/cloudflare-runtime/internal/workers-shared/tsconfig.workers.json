{
  "extends": "../../../../tsconfig.cloudflare.json",
  "include": ["../../src/internal/workers-shared/workers/**/*.ts"],
  "compilerOptions": {
    "tsBuildInfoFile": ".cache/tsconfig.workers.tsbuildinfo",
    "outDir": ".cache/workers",
    "rootDir": "../../src/internal/workers-shared",
    "emitDeclarationOnly": true,
    "module": "Preserve",
    "moduleResolution": "bundler",
    "types": [
      "@cloudflare/workers-types/experimental",
      "@cloudflare/vitest-pool-workers/types"
    ],
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  },
  "references": [{ "path": "./tsconfig.shared.json" }]
}
