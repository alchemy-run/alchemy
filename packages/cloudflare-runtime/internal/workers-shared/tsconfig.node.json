{
  "extends": "../../../../tsconfig.cloudflare.json",
  "include": [
    "../../src/internal/workers-shared/node/**/*.ts",
    "../../src/internal/workers-shared/index.ts"
  ],
  "compilerOptions": {
    "tsBuildInfoFile": ".cache/tsconfig.node.tsbuildinfo",
    "outDir": ".cache/node",
    "rootDir": "../../src/internal/workers-shared",
    "emitDeclarationOnly": true,
    "module": "Preserve",
    "moduleResolution": "bundler",
    "types": ["node"],
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  },
  "references": [{ "path": "./tsconfig.shared.json" }]
}
