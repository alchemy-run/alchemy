{
  "extends": "../../../tsconfig.cloudflare.json",
  "include": ["test"],
  // Fixtures are bundler inputs, not code to check: they deliberately exercise
  // aliases, extensionless requires, and globals that only exist once unenv
  // and the plugin's own resolution have been applied.
  "exclude": ["test/fixtures"],
  "compilerOptions": {
    // Checked separately from `tsconfig.json`, whose `tsc` run is the package
    // build and must not compile tests into `dist`.
    "tsBuildInfoFile": ".cache/tsconfig.test.tsbuildinfo",
    "composite": false,
    "noEmit": true,
    "types": ["node", "@cloudflare/workers-types/experimental"]
  }
}
