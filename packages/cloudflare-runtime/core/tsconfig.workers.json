{
  "extends": "../../../tsconfig.cloudflare.json",
  "include": [
    "../src/core/**/*.worker.ts",
    "../src/core/**/*.shared.ts",
    "../src/internal/workers-shared/shared/**/*.ts",
    "../src/internal/workers-shared/workers/**/*.ts",
    "../src/internal/workflows-shared"
  ],
  "exclude": ["../src/internal/workers-shared/**/tests/**"],
  "compilerOptions": {
    "tsBuildInfoFile": ".cache/tsconfig.workers.tsbuildinfo",
    "outDir": ".cache/workers",
    "rootDir": "..",
    "emitDeclarationOnly": true,
    "types": [
      "@cloudflare/workers-types/experimental",
      "@cloudflare/vitest-pool-workers/types",
      "node"
    ]
  }
}
