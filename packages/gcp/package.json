      "./Labels": {
        "types": "./lib/Labels.d.ts",
        "bun": "./src/Labels.ts",
        "default": "./lib/Labels.js"
      },
      "./MetadataCredentials": {
        "types": "./lib/MetadataCredentials.d.ts",
        "bun": "./src/MetadataCredentials.ts",
        "default": "./lib/MetadataCredentials.js"
