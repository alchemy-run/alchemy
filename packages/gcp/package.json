        "bun": "./src/Errors.ts",
        "default": "./lib/Errors.js"
      },
      "./GCPBindings": {
        "types": "./lib/GCPBindings.d.ts",
        "bun": "./src/GCPBindings.ts",
        "default": "./lib/GCPBindings.js"
