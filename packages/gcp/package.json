      "./DataManager/internal": {
        "types": "./lib/DataManager/internal.d.ts",
        "bun": "./src/DataManager/internal.ts",
        "default": "./lib/DataManager/internal.js"
      },
      "./Firestore/Document": {
        "types": "./lib/Firestore/Document.d.ts",
        "bun": "./src/Firestore/Document.ts",
        "default": "./lib/Firestore/Document.js"
      },
      "./Firestore/Values": {
        "types": "./lib/Firestore/Values.d.ts",
        "bun": "./src/Firestore/Values.ts",
        "default": "./lib/Firestore/Values.js"
      },
      "./PubSub/TopicEventSource": {
        "types": "./lib/PubSub/TopicEventSource.d.ts",
