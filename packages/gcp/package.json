{
  "name": "@alchemy.run/gcp",
  "version": "2.0.0-beta.83",
  "description": "Google Cloud resources, Cloud Run, Cloud Functions and GKE for Alchemy.",
  "keywords": [
    "alchemy",
    "effect",
    "gcp",
    "google-cloud",
    "infrastructure-as-code"
  ],
