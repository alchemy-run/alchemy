        "default": "./lib/Proto.js"
      },
      "./Providers": {
        "types": "./lib/Providers.d.ts",
        "bun": "./src/Providers.ts",
        "default": "./lib/Providers.js"
      },
      "./PushDelivery": {
        "types": "./lib/PushDelivery.d.ts",
        "bun": "./src/PushDelivery.ts",
        "default": "./lib/PushDelivery.js"
      },
      "./Region": {
        "types": "./lib/Region.d.ts",
        "bun": "./src/Region.ts",
        "default": "./lib/Region.js"
      },
      "./Token": {
        "types": "./lib/Token.d.ts",
        "bun": "./src/Token.ts",
        "default": "./lib/Token.js"
