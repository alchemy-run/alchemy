{
  "discovery": "gkebackup-v1",
  "module": "gkebackup_v1",
  "resources": {
    "BackupChannel": {
      "pattern": "projects/*/locations/*/backupChannels/*"
    },
    "BackupPlan": {
      "pattern": "projects/*/locations/*/backupPlans/*"
    },
    "BackupPlansBackup": {
      "pattern": "projects/*/locations/*/backupPlans/*/backups/*"
    },
    "RestoreChannel": {
      "pattern": "projects/*/locations/*/restoreChannels/*"
    },
    "RestorePlan": {
      "pattern": "projects/*/locations/*/restorePlans/*"
    },
    "RestorePlansRestore": {
      "pattern": "projects/*/locations/*/restorePlans/*/restores/*"
    }
  },
  "probes": {
    "resources": {}
  }
}
