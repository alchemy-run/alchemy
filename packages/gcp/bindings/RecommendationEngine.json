{
  "discovery": "recommendationengine-v1beta1",
  "module": "recommendationengine_v1beta1",
  "resources": {
    "CatalogsCatalogItem": {
      "pattern": "projects/*/locations/*/catalogs/*/catalogItems/.*"
    }
  },
  "permissionService": "automlrecommendations",
  "probes": {
    "resources": {
      "CatalogsCatalogItem": "Shirt"
    },
    "untestable": {
      "*": "recommendationengine.googleapis.com is not enabled on the testing project"
    }
  }
}
