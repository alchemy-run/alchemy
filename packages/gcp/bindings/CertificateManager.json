{
  "discovery": "certificatemanager-v1",
  "module": "certificatemanager_v1",
  "resources": {
    "Certificate": {
      "pattern": "projects/*/locations/*/certificates/*"
    },
    "CertificateIssuanceConfig": {
      "pattern": "projects/*/locations/*/certificateIssuanceConfigs/*"
    },
    "CertificateMap": {
      "pattern": "projects/*/locations/*/certificateMaps/*"
    },
    "CertificateMapEntry": {
      "pattern": "projects/*/locations/*/certificateMaps/*/certificateMapEntries/*"
    },
    "DnsAuthorization": {
      "pattern": "projects/*/locations/*/dnsAuthorizations/*"
    },
    "TrustConfig": {
      "pattern": "projects/*/locations/*/trustConfigs/*"
    }
  },
  "probes": {
    "resources": {
      "CertificateMap": "ProbeCertificateMap",
      "DnsAuthorization": "ProbeDnsAuthorization",
      "TrustConfig": "ProbeTrustConfig",
      "Certificate": "ProbeCertificate",
      "CertificateMapEntry": "ProbeMapEntry",
      "CertificateIssuanceConfig": "ProbeIssuanceConfig"
    },
    "untestable": {},
    "locations": {
      "ListCertificateMaps": "global"
    }
  },
  "permissionCollections": {
    "certificates": "certs",
    "certificateIssuanceConfigs": "certissuanceconfigs",
    "certificateMaps": "certmaps",
    "certificateMapEntries": "certmapentries"
  }
}
