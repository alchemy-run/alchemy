{
  "discovery": "secretmanager-v1",
  "module": "secretmanager_v1",
  "resources": {
    "Secret": {
      "pattern": "projects/*/secrets/*",
      "iamKind": "secretmanager.secret"
    },
    "LocationsSecret": {
      "pattern": "projects/*/locations/*/secrets/*",
      "iamKind": "secretmanager.secret"
    }
  },
  "permissions": {
    "secretmanager.projects.secrets.addVersion": "secretmanager.versions.add",
    "secretmanager.projects.locations.secrets.addVersion": "secretmanager.versions.add",
    "secretmanager.projects.secrets.rotateSecret": "secretmanager.secrets.rotate",
    "secretmanager.projects.locations.secrets.rotateSecret": "secretmanager.secrets.rotate"
  },
  "names": {},
  "skip": {},
  "probes": {
    "resources": {}
  }
}
