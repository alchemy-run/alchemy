{
  "discovery": "pubsub-v1",
  "module": "pubsub_v1",
  "resources": {
    "Topic": {
      "pattern": "projects/*/topics/*",
      "iamKind": "pubsub.topic"
    },
    "Subscription": {
      "pattern": "projects/*/subscriptions/*",
      "iamKind": "pubsub.subscription"
    },
    "Schema": {
      "pattern": "projects/*/schemas/*",
      "iamKind": "pubsub.schema"
    },
    "Snapshot": {
      "pattern": "projects/*/snapshots/*",
      "iamKind": "pubsub.snapshot"
    }
  },
  "names": {},
  "skip": {},
  "suffix": {
    "pubsub.projects.schemas.deleteRevision": ["@", "revisionId"]
  },
  "grantOn": {
    "pubsub.projects.subscriptions.detach": {
      "attribute": "topic",
      "iamKind": "pubsub.topic"
    }
  },
  "projectGrant": {
    "pubsub.projects.schemas.deleteRevision": "a revision (`schema@revision`) is not covered by the schema's own IAM policy"
  },
  "probes": {
    "resources": {},
    "coveredBy": "Bindings.test.ts"
  }
}
