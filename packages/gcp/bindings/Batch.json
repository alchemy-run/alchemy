{
  "discovery": "batch-v1",
  "module": "batch_v1",
  "resources": {
    "Job": {
      "pattern": "projects/*/locations/*/jobs/*"
    }
  },
  "permissions": {
    "batch.projects.locations.jobs.cancel": "batch.jobs.delete"
  },
  "probes": {
    "resources": {
      "Job": "ProbeJob"
    },
    "enable": ["batch.googleapis.com", "compute.googleapis.com"]
  }
}
