{
  "discovery": "eventarc-v1",
  "module": "eventarc_v1",
  "resources": {
    "Channel": {
      "pattern": "projects/*/locations/*/channels/*"
    },
    "ChannelConnection": {
      "pattern": "projects/*/locations/*/channelConnections/*"
    },
    "Enrollment": {
      "pattern": "projects/*/locations/*/enrollments/*"
    },
    "GoogleApiSource": {
      "pattern": "projects/*/locations/*/googleApiSources/*"
    },
    "MessageBus": {
      "pattern": "projects/*/locations/*/messageBuses/*"
    },
    "Pipeline": {
      "pattern": "projects/*/locations/*/pipelines/*"
    },
    "Trigger": {
      "pattern": "projects/*/locations/*/triggers/*"
    }
  },
  "probes": {
    "resources": {
      "Channel": "ProbeChannel",
      "MessageBus": "ProbeBus",
      "Pipeline": "ProbePipeline",
      "Enrollment": "ProbeEnrollment",
      "GoogleApiSource": "ProbeApiSource",
      "Trigger": "ProbeTrigger"
    },
    "untestable": {
      "ChannelConnection": "ChannelConnection is created in a third-party provider project using a subscriber Channel activation token. The testing project is not an Eventarc SaaS partner; live create is gated. (GCP_TEST_EVENTARC_PARTNER)"
    }
  }
}
