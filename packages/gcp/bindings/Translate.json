{
  "discovery": "translate-v3",
  "module": "translate_v3",
  "resources": {
    "AdaptiveMtDataset": {
      "pattern": "projects/*/locations/*/adaptiveMtDatasets/*"
    },
    "Glossary": {
      "pattern": "projects/*/locations/*/glossaries/*"
    },
    "GlossariesGlossaryEntry": {
      "pattern": "projects/*/locations/*/glossaries/*/glossaryEntries/*"
    },
    "Model": {
      "pattern": "projects/*/locations/*/models/*"
    }
  },
  "permissionService": "cloudtranslate",
  "probes": {
    "resources": {
      "AdaptiveMtDataset": "Dataset",
      "Glossary": "EnEsGlossary",
      "GlossariesGlossaryEntry": "Hello"
    },
    "untestable": {
      "Model": "a custom model trains for hours from a prepared dataset (GCP_TEST_TRANSLATE_MODEL_DATASET)"
    },
    "enable": ["translate.googleapis.com"]
  }
}
