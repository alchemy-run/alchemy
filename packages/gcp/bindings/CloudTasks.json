{
  "discovery": "cloudtasks-v2",
  "module": "cloudtasks_v2",
  "resources": {
    "Queue": {
      "pattern": "projects/*/locations/*/queues/*",
      "iamKind": "cloudtasks.queue"
    }
  },
  "permissions": {
    "cloudtasks.projects.locations.queues.tasks.batchCreate": "cloudtasks.tasks.create",
    "cloudtasks.projects.locations.queues.tasks.buffer": "cloudtasks.tasks.create",
    "cloudtasks.projects.locations.queues.tasks.batchDelete": "cloudtasks.tasks.delete"
  },
  "names": {
    "BatchTaskCreate": "BatchCreateTasks",
    "BatchTaskDelete": "BatchDeleteTasks",
    "BufferQueueTask": "BufferTask"
  }
}
