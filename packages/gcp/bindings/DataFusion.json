{
  "discovery": "datafusion-v1",
  "module": "datafusion_v1",
  "resources": {
    "Instance": {
      "pattern": "projects/*/locations/*/instances/*"
    }
  },
  "permissions": {
    "datafusion.projects.locations.versions.list": "datafusion.instances.list"
  },
  "probes": {
    "resources": {},
    "enable": ["datafusion.googleapis.com"],
    "untestable": {
      "Instance": "the testing project can't host Data Fusion: every create fails its operation with code 10 \"Failed to perform tenant project creation\""
    }
  }
}
