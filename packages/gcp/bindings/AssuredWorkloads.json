{
  "discovery": "assuredworkloads-v1",
  "module": "assuredworkloads_v1",
  "resources": {
    "Workload": {
      "pattern": "organizations/*/locations/*/workloads/*"
    }
  },
  "probes": {
    "resources": {},
    "untestable": {
      "Workload": "Workloads live under an organization the credentials administer. Set (GOOGLE_ORGANIZATION_ID)"
    },
    "location": "global"
  }
}
