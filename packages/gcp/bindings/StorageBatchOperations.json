{
  "discovery": "storagebatchoperations-v1",
  "module": "storagebatchoperations_v1",
  "resources": {
    "Job": {
      "pattern": "projects/*/locations/*/jobs/*"
    }
  },
  "probes": {
    "resources": {
      "Job": "ProbeJob"
    },
    "enable": ["storagebatchoperations.googleapis.com"],
    "location": "global"
  }
}
