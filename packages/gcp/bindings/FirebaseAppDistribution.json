{
  "discovery": "firebaseappdistribution-v1",
  "module": "firebaseappdistribution_v1",
  "resources": {
    "Group": {
      "pattern": "projects/*/groups/*"
    }
  },
  "probes": {
    "resources": {},
    "untestable": {
      "Group": "needs a Firebase project; adding Firebase to a GCP project is permanent, and the testing project has none"
    },
    "enable": [
      "firebaseappdistribution.googleapis.com"
    ]
  },
  "permissionService": "firebaseappdistro",
  "permissionCollections": {
    "feedbackReports": "releases",
    "apps": "releases"
  },
  "verbPermissions": {
    "batchAdd": "update",
    "batchRemove": "update",
    "batchJoin": "update",
    "batchLeave": "update",
    "patch": "update",
    "distribute": "update",
    "batchDelete": "update",
    "delete": "update",
    "upload": "update",
    "get": "list",
    "getAabInfo": "list"
  }
}
