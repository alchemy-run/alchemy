{
  "discovery": "apim-v1alpha",
  "module": "apim_v1alpha",
  "resources": {
    "ObservationJob": {
      "pattern": "projects/*/locations/*/observationJobs/*"
    },
    "ObservationSource": {
      "pattern": "projects/*/locations/*/observationSources/*"
    }
  },
  "probes": {
    "resources": {
      "ObservationJob": "ProbeObservationJob",
      "ObservationSource": "ProbeObservationSource"
    },
    "untestable": {},
    "enable": [
      "apim.googleapis.com"
    ]
  }
}
