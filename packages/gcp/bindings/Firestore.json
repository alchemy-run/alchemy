    "BeginDocumentTransaction": "BeginTransaction",
    "BulkDatabaseDeleteDocuments": "BulkDeleteDocuments",
    "CommitDatabaseDocument": "Commit",
    "RollbackDatabaseDocument": "Rollback",
    "ExecuteDocumentPipeline": "ExecutePipeline",
    "PartitionDocumentQuery": "PartitionQuery",
    "RunDocumentAggregationQuery": "RunAggregationQuery",
    "ListDocumentCollectionIds": "ListCollectionIds",
    "ExportDatabaseDocuments": "ExportDocuments",
    "ImportDatabaseDocuments": "ImportDocuments"
