{
  "discovery": "iamcredentials-v1",
  "module": "iamcredentials_v1",
  "resources": {},
  "permissions": {
    "iamcredentials.projects.serviceAccounts.signJwt": "iam.serviceAccounts.signJwt",
    "iamcredentials.projects.serviceAccounts.generateAccessToken": "iam.serviceAccounts.getAccessToken",
    "iamcredentials.projects.serviceAccounts.signBlob": "iam.serviceAccounts.signBlob",
    "iamcredentials.projects.serviceAccounts.generateIdToken": "iam.serviceAccounts.getOpenIdToken"
  },
  "skip": {
    "iamcredentials.projects.serviceAccounts.getAllowedLocations": "public metadata that takes no credentials",
    "iamcredentials.projects.locations.workloadIdentityPools.getAllowedLocations": "public metadata that takes no credentials"
  },
  "probes": {
    "resources": {},
    "enable": ["iamcredentials.googleapis.com"]
  }
}
