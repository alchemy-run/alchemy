{
  "discovery": "contentwarehouse-v1",
  "module": "contentwarehouse_v1",
  "resources": {
    "Document": {
      "pattern": "projects/*/locations/*/documents/*"
    },
    "DocumentSchema": {
      "pattern": "projects/*/locations/*/documentSchemas/*"
    },
    "RuleSet": {
      "pattern": "projects/*/locations/*/ruleSets/*"
    },
    "SynonymSet": {
      "pattern": "projects/*/locations/*/synonymSets/*"
    }
  },
  "probes": {
    "resources": {
      "Document": "ProbeDocument"
    },
    "untestable": {},
    "enable": [
      "contentwarehouse.googleapis.com"
    ]
  },
  "permissions": {
    "contentwarehouse.projects.fetchAcl": "contentwarehouse.documents.getIamPolicy",
    "contentwarehouse.projects.setAcl": "contentwarehouse.documents.setIamPolicy"
  }
}
