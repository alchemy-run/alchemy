{
  "discovery": "healthcare-v1",
  "module": "healthcare_v1",
  "resources": {
    "Dataset": {
      "pattern": "projects/*/locations/*/datasets/*"
    },
    "DatasetsConsentStore": {
      "pattern": "projects/*/locations/*/datasets/*/consentStores/*"
    },
    "DatasetsConsentStoresAttributeDefinition": {
      "pattern": "projects/*/locations/*/datasets/*/consentStores/*/attributeDefinitions/*"
    },
    "DatasetsConsentStoresConsent": {
      "pattern": "projects/*/locations/*/datasets/*/consentStores/*/consents/*"
    },
    "DatasetsConsentStoresConsentArtifact": {
      "pattern": "projects/*/locations/*/datasets/*/consentStores/*/consentArtifacts/*"
    },
    "DatasetsConsentStoresUserDataMapping": {
      "pattern": "projects/*/locations/*/datasets/*/consentStores/*/userDataMappings/*"
    },
    "DatasetsDicomStore": {
      "pattern": "projects/*/locations/*/datasets/*/dicomStores/*"
    },
    "DatasetsFhirStore": {
      "pattern": "projects/*/locations/*/datasets/*/fhirStores/*"
    },
    "DatasetsHl7V2Store": {
      "pattern": "projects/*/locations/*/datasets/*/hl7V2Stores/*"
    },
    "DatasetsHl7V2StoresMessage": {
      "pattern": "projects/*/locations/*/datasets/*/hl7V2Stores/*/messages/*"
    }
  },
  "probes": {
    "resources": {
      "Dataset": "ProbeDataset",
      "DatasetsConsentStore": "ProbeConsentStore",
      "DatasetsDicomStore": "ProbeDicomStore",
      "DatasetsFhirStore": "ProbeFhirStore",
      "DatasetsHl7V2Store": "ProbeHl7V2Store",
      "DatasetsHl7V2StoresMessage": "ProbeHl7Message",
      "DatasetsConsentStoresAttributeDefinition": "ProbeAttribute",
      "DatasetsConsentStoresConsentArtifact": "ProbeArtifact",
      "DatasetsConsentStoresConsent": "ProbeConsent",
      "DatasetsConsentStoresUserDataMapping": "ProbeMapping"
    },
    "args": {
      "DeidentifyDataset": "{ body: { destinationDataset: `projects/${yield* hostProject}/locations/us-central1/datasets/alchemy probe invalid` } }",
      "DeidentifyFhirStore": "{ body: { destinationStore: `projects/${yield* hostProject}/locations/us-central1/datasets/alchemy-missing/fhirStores/alchemy-missing` } }"
    },
    "skip": {
      "DeidentifyDicomStore": "a DICOM destination store that doesn't exist answers 403 like a denied call (the FHIR variant answers NotFound and passes), and a real destination would receive copied data; dicomEditor, granted alongside, carries dicomWebWrite"
    }
  },
  "suffix": {
    "healthcare.projects.locations.datasets.fhirStores.fhir.read": ["/", "resourceId"],
    "healthcare.projects.locations.datasets.fhirStores.fhir.update": ["/", "resourceId"],
    "healthcare.projects.locations.datasets.fhirStores.fhir.patch": ["/", "resourceId"],
    "healthcare.projects.locations.datasets.fhirStores.fhir.delete": ["/", "resourceId"],
    "healthcare.projects.locations.datasets.fhirStores.fhir.history": ["/", "resourceId"],
    "healthcare.projects.locations.datasets.fhirStores.fhir.Resource-purge": ["/", "resourceId"]
  },
  "childFields": {
    "fhir": "resourceType"
  }
}
