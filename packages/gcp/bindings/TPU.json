{
  "discovery": "tpu-v2",
  "module": "tpu_v2",
  "resources": {
    "Node": {
      "pattern": "projects/*/locations/*/nodes/*"
    },
    "QueuedResource": {
      "pattern": "projects/*/locations/*/queuedResources/*"
    }
  },
  "permissions": {
    "tpu.projects.locations.queuedResources.list": "tpu.nodes.list",
    "tpu.projects.locations.queuedResources.reset": "tpu.nodes.reset"
  },
  "probes": {
    "resources": {
      "Node": "Trainer",
      "QueuedResource": "QueuedTrainer"
    },
    "untestable": {},
    "enable": ["tpu.googleapis.com"],
    "location": "us-central1-a"
  }
}
