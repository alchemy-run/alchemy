{
  "discovery": "tpu-v2",
  "module": "tpu_v2",
  "resources": {
    "Node": {
      "pattern": "projects/*/locations/*/nodes/*"
    },
    "QueuedResource": {
      "pattern": "projects/*/locations/*/queuedResources/*"
    }
  },
  "permissions": {
    "tpu.projects.locations.queuedResources.list": "tpu.nodes.list",
    "tpu.projects.locations.queuedResources.reset": "tpu.nodes.reset"
  },
  "probes": {
    "resources": {},
    "untestable": {
      "Node": "TPU VMs bill by the hour and need TPU quota the testing project doesn't have",
      "QueuedResource": "a queued resource provisions TPU VMs: hourly billing and TPU quota"
    },
    "enable": [
      "tpu.googleapis.com"
    ],
    "location": "us-central1-a"
  }
}
