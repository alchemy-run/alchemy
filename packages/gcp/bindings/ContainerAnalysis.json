{
  "discovery": "containeranalysis-v1",
  "module": "containeranalysis_v1",
  "resources": {
    "LocationsNote": {
      "pattern": "projects/*/locations/*/notes/*"
    },
    "LocationsOccurrence": {
      "pattern": "projects/*/locations/*/occurrences/*"
    },
    "Note": {
      "pattern": "projects/*/notes/*",
      "iamKind": "containeranalysis.note"
    },
    "Occurrence": {
      "pattern": "projects/*/occurrences/*"
    }
  },
  "probes": {
    "resources": {
      "Note": "Authority",
      "Occurrence": "Signed",
      "LocationsNote": "RegionalNote",
      "LocationsOccurrence": "RegionalOccurrence"
    }
  }
}
