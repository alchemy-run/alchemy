{
  "discovery": "ml-v1",
  "module": "ml_v1",
  "resources": {
    "Model": {
      "pattern": "projects/*/models/*",
      "iamKind": "ml.model"
    },
    "ModelsVersion": {
      "pattern": "projects/*/models/*/versions/*"
    }
  },
  "probes": {
    "resources": {},
    "untestable": {
      "*": "Cloud AI Platform (ml v1) is deprecated; new projects get AiPlatformDeprecated"
    }
  }
}
