{
  "discovery": "biglake-v1",
  "module": "biglake_v1",
  "resources": {
    "Catalog": {
      "pattern": "projects/*/locations/*/catalogs/*"
    },
    "CatalogsDatabase": {
      "pattern": "projects/*/locations/*/catalogs/*/databases/*"
    },
    "CatalogsDatabasesTable": {
      "pattern": "projects/*/locations/*/catalogs/*/databases/*/tables/*"
    }
  },
  "probes": {
    "resources": {
      "Catalog": "ProbeCatalog"
    },
    "untestable": {}
  }
}
