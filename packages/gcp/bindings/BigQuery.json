{
  "discovery": "bigquery-v2",
  "module": "bigquery_v2",
  "resources": {
    "Dataset": {
      "pattern": "projects/*/datasets/*",
      "attributes": ["project", "datasetId"],
      "iamKind": "bigquery.dataset"
    },
    "Table": {
      "pattern": "projects/*/datasets/*/tables/*",
      "attributes": ["project", "datasetId", "tableId"],
      "iamKind": "bigquery.table"
    },
    "Job": {
      "pattern": "projects/*/jobs/*",
      "attributes": ["project", "jobId"],
      "fields": {
        "location": "location"
      }
    },
    "Routine": {
      "pattern": "projects/*/datasets/*/routines/*",
      "lifecycleOnly": true
    },
    "RowAccessPolicy": {
      "pattern": "projects/*/datasets/*/tables/*/rowAccessPolicies/*",
      "lifecycleOnly": true
    }
  },
  "names": {
    "BatchRowAccessPolicyDelete": "BatchDeleteRowAccessPolicies"
  },
  "projectCalls": ["bigquery.jobs.insert"],
  "skip": {
    "bigquery.projects.getServiceAccount": "returns BigQuery's service agent for the project: setup information, not a runtime call"
  },
  "projectGrant": {
    "bigquery.datasets.undelete": "a deleted dataset has no IAM policy: undelete is authorized on the project"
  },
  "probes": {
    "resources": {},
    "coveredBy": "Bindings.test.ts"
  }
}
