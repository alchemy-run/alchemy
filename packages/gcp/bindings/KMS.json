{
  "discovery": "cloudkms-v1",
  "module": "cloudkms_v1",
  "resources": {
    "KeyRing": {
      "pattern": "projects/*/locations/*/keyRings/*",
      "iamKind": "kms.keyRing"
    },
    "CryptoKey": {
      "pattern": "projects/*/locations/*/keyRings/*/cryptoKeys/*",
      "iamKind": "kms.cryptoKey"
    },
    "ImportJob": {
      "pattern": "projects/*/locations/*/keyRings/*/importJobs/*",
      "iamKind": "kms.importJob"
    }
  },
  "permissions": {
    "cloudkms.projects.locations.keyRings.cryptoKeys.updatePrimaryVersion": "cloudkms.cryptoKeys.update",
    "cloudkms.projects.locations.keyRings.cryptoKeys.cryptoKeyVersions.rawDecrypt": "cloudkms.cryptoKeyVersions.useToDecrypt",
    "cloudkms.projects.locations.keyRings.cryptoKeys.cryptoKeyVersions.asymmetricDecrypt": "cloudkms.cryptoKeyVersions.useToDecrypt",
    "cloudkms.projects.locations.keyRings.cryptoKeys.cryptoKeyVersions.rawEncrypt": "cloudkms.cryptoKeyVersions.useToEncrypt",
    "cloudkms.projects.locations.keyRings.cryptoKeys.cryptoKeyVersions.getPublicKey": "cloudkms.cryptoKeyVersions.viewPublicKey",
    "cloudkms.projects.locations.keyRings.cryptoKeys.cryptoKeyVersions.macSign": "cloudkms.cryptoKeyVersions.useToSign",
    "cloudkms.projects.locations.keyRings.cryptoKeys.cryptoKeyVersions.asymmetricSign": "cloudkms.cryptoKeyVersions.useToSign",
    "cloudkms.projects.locations.keyRings.cryptoKeys.cryptoKeyVersions.macVerify": "cloudkms.cryptoKeyVersions.useToVerify",
    "cloudkms.projects.locations.keyRings.cryptoKeys.cryptoKeyVersions.decapsulate": "cloudkms.cryptoKeyVersions.useToDecapsulate"
  },
  "skip": {
    "cloudkms.projects.locations.keyRings.cryptoKeys.cryptoKeyVersions.import": "imports wrapped key material through an ImportJob; a deploy-time concern, not a runtime call",
    "cloudkms.projects.locations.keyRings.cryptoKeys.cryptoKeyVersions.importTrustedKeyWrappedCryptoKeyVersion": "single-tenant HSM key transfer",
    "cloudkms.projects.locations.keyRings.cryptoKeys.cryptoKeyVersions.exportTrustedKeyWrappedCryptoKeyVersion": "single-tenant HSM key transfer"
  },
  "names": {
    "AsymmetricCryptoKeyVersionDecrypt": "AsymmetricDecrypt",
    "AsymmetricCryptoKeyVersionSign": "AsymmetricSign",
    "MacCryptoKeyVersionSign": "MacSign",
    "MacCryptoKeyVersionVerify": "MacVerify",
    "RawCryptoKeyVersionDecrypt": "RawDecrypt",
    "RawCryptoKeyVersionEncrypt": "RawEncrypt",
    "DecapsulateCryptoKeyVersion": "Decapsulate",
    "GetCryptoKeyVersionPublicKey": "GetPublicKey"
  }
}
