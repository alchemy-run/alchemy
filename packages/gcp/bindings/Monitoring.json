{
  "discovery": "monitoring-v3",
  "module": "monitoring_v3",
  "resources": {
    "AlertPolicy": {
      "pattern": "projects/*/alertPolicies/*"
    },
    "Group": {
      "pattern": "projects/*/groups/*"
    },
    "MetricDescriptor": {
      "pattern": "projects/*/metricDescriptors/*"
    },
    "NotificationChannel": {
      "pattern": "projects/*/notificationChannels/*"
    },
    "Service": {
      "pattern": "*/*/services/*"
    },
    "ServicesServiceLevelObjective": {
      "pattern": "*/*/services/*/serviceLevelObjectives/*"
    },
    "UptimeCheckConfig": {
      "pattern": "projects/*/uptimeCheckConfigs/*"
    }
  },
  "probes": {
    "resources": {
      "Group": "ProbeGroup",
      "MetricDescriptor": "ProbeMetricDescriptor",
      "NotificationChannel": "ProbeNotificationChannel",
      "Service": "ProbeService",
      "UptimeCheckConfig": "ProbeUptimeCheckConfig",
      "AlertPolicy": "ProbeAlertPolicy",
      "ServicesServiceLevelObjective": "ProbeSlo"
    },
    "untestable": {}
  }
}
