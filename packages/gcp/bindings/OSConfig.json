{
  "discovery": "osconfig-v2",
  "module": "osconfig_v2",
  "resources": {
    "FoldersLocationsGlobalPolicyOrchestrator": {
      "pattern": "folders/*/locations/global/policyOrchestrators/*"
    },
    "OrganizationsLocationsGlobalPolicyOrchestrator": {
      "pattern": "organizations/*/locations/global/policyOrchestrators/*"
    },
    "ProjectsLocationsGlobalPolicyOrchestrator": {
      "pattern": "projects/*/locations/global/policyOrchestrators/*"
    }
  },
  "probes": {
    "resources": {
      "ProjectsLocationsGlobalPolicyOrchestrator": "ProbeOrchestrator"
    },
    "untestable": {
      "FoldersLocationsGlobalPolicyOrchestrator": "folder-level: needs a folder and folder IAM the testing account lacks",
      "OrganizationsLocationsGlobalPolicyOrchestrator": "organization-level: needs org IAM the testing account lacks"
    },
    "enable": [
      "osconfig.googleapis.com"
    ]
  }
}
