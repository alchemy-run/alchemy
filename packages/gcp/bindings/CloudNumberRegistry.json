{
  "discovery": "cloudnumberregistry-v1alpha",
  "module": "cloudnumberregistry_v1alpha",
  "resources": {
    "CustomRange": {
      "pattern": "projects/*/locations/*/customRanges/*"
    },
    "IpamAdminScope": {
      "pattern": "projects/*/locations/*/ipamAdminScopes/*"
    },
    "Realm": {
      "pattern": "projects/*/locations/*/realms/*"
    },
    "RegistryBook": {
      "pattern": "projects/*/locations/*/registryBooks/*"
    }
  },
  "probes": {
    "resources": {
      "RegistryBook": "ProbeRegistryBook",
      "Realm": "ProbeRealm",
      "CustomRange": "ProbeCustomRange"
    },
    "untestable": {
      "IpamAdminScope": "scopes IPAM to an organization; the testing account has none"
    },
    "enable": [
      "cloudnumberregistry.googleapis.com"
    ],
    "location": "global"
  }
}
