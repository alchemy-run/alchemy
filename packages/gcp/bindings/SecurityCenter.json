{
  "discovery": "securitycenter-v1",
  "module": "securitycenter_v1",
  "resources": {
    "BigQueryExport": {
      "pattern": "projects/*/bigQueryExports/*"
    },
    "EventThreatDetectionSettingsCustomModule": {
      "pattern": "projects/*/eventThreatDetectionSettings/customModules/*"
    },
    "FolderBigQueryExport": {
      "pattern": "folders/*/bigQueryExports/*"
    },
    "FolderEventThreatDetectionSettingsCustomModule": {
      "pattern": "folders/*/eventThreatDetectionSettings/customModules/*"
    },
    "FolderMuteConfig": {
      "pattern": "folders/*/muteConfigs/*"
    },
    "FolderNotificationConfig": {
      "pattern": "folders/*/notificationConfigs/*"
    },
    "FolderSecurityHealthAnalyticsSettingsCustomModule": {
      "pattern": "folders/*/securityHealthAnalyticsSettings/customModules/*"
    },
    "MuteConfig": {
      "pattern": "projects/*/muteConfigs/*"
    },
    "NotificationConfig": {
      "pattern": "projects/*/notificationConfigs/*"
    },
    "OrganizationBigQueryExport": {
      "pattern": "organizations/*/bigQueryExports/*"
    },
    "OrganizationEventThreatDetectionSettingsCustomModule": {
      "pattern": "organizations/*/eventThreatDetectionSettings/customModules/*"
    },
    "OrganizationMuteConfig": {
      "pattern": "organizations/*/muteConfigs/*"
    },
    "OrganizationsNotificationConfig": {
      "pattern": "organizations/*/notificationConfigs/*"
    },
    "OrganizationsSecurityHealthAnalyticsSettingsCustomModule": {
      "pattern": "organizations/*/securityHealthAnalyticsSettings/customModules/*"
    },
    "SecurityHealthAnalyticsSettingsCustomModule": {
      "pattern": "projects/*/securityHealthAnalyticsSettings/customModules/*"
    }
  },
  "probes": {
    "resources": {},
    "untestable": {
      "*": "Security Command Center isn't activated on the testing project: calls answer 'Security Command Center Legacy has been permanently disabled', and the Standard or Premium tier is activated on an organization, which the testing account doesn't have"
    }
  }
}
