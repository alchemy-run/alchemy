{
  "discovery": "iap-v1",
  "module": "iap_v1",
  "resources": {
    "BrandsIdentityAwareProxyClient": {
      "pattern": "projects/*/brands/*/identityAwareProxyClients/*"
    }
  },
  "probes": {
    "resources": {}
  },
  "permissionService": "clientauthconfig",
  "permissionCollections": {
    "identityAwareProxyClients": "clients"
  },
  "verbPermissions": {
    "resetSecret": "getWithSecret"
  }
}
