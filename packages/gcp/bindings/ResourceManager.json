{
  "discovery": "cloudresourcemanager-v3",
  "module": "cloudresourcemanager_v3",
  "resources": {
    "Folder": {
      "pattern": "folders/*"
    },
    "Lien": {
      "pattern": "liens/*"
    },
    "Project": {
      "pattern": "projects/*"
    },
    "TagBinding": {
      "pattern": "projects/*"
    },
    "TagKey": {
      "pattern": "tagKeys/*"
    },
    "TagValue": {
      "pattern": "tagValues/*"
    }
  },
  "probes": {
    "resources": {}
  }
}
