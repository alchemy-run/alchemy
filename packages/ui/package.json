{
  "name": "@alchemy.run/ui",
  "version": "2.0.0-beta.85",
  "private": true,
  "description": "Experimental Effect-native UI: components as Layers with effectful constructors, fine-grained signals, and story tests over an inferred event model.",
  "keywords": [
    "alchemy",
    "effect",
    "signals",
    "ui"
  ],
  "homepage": "https://alchemy.run",
  "license": "Apache-2.0",
  "author": "Sam Goodwin <sam@alchemy.run>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alchemy-run/alchemy.git",
    "directory": "packages/ui"
  },
  "files": [
    "lib",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "bun": "./src/index.ts",
        "default": "./lib/index.js"
      },
      "./internal/*": null,
      "./*": {
        "types": "./lib/*.d.ts",
        "bun": "./src/*.ts",
        "default": "./lib/*.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "pnpm -r --filter \"{.}...\" run build:package",
    "build:package": "node scripts/build.ts"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:"
  }
}
