{
  "name": "@alchemy.run/convex",
  "version": "2.0.0-beta.86",
  "description": "Convex Cloud and self-hosted Convex for Alchemy.",
  "keywords": [
    "alchemy",
    "convex",
    "effect",
    "infrastructure-as-code"
  ],
  "homepage": "https://alchemy.run",
  "bugs": {
    "url": "https://github.com/alchemy-run/alchemy/issues"
  },
  "license": "Apache-2.0",
  "author": "Sam Goodwin <sam@alchemy.run>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alchemy-run/alchemy.git",
    "directory": "packages/convex"
  },
  "files": [
    "lib",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./aws": "./src/aws/index.ts",
    "./*": "./src/*.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "bun": "./src/index.ts",
        "worker": "./src/index.ts",
        "default": "./lib/index.js"
      },
      "./aws": {
        "types": "./lib/aws/index.d.ts",
        "bun": "./src/aws/index.ts",
        "worker": "./src/aws/index.ts",
        "default": "./lib/aws/index.js"
      },
      "./internal/*": null,
      "./*": {
        "types": "./lib/*.d.ts",
        "bun": "./src/*.ts",
        "worker": "./src/*.ts",
        "default": "./lib/*.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "pnpm -r --filter \"{.}...\" run build:package",
    "build:package": "node scripts/build.ts"
  },
  "dependencies": {
    "@distilled.cloud/convex": "workspace:*",
    "@distilled.cloud/core": "workspace:*",
    "@noble/ciphers": "^2.3.0"
  },
  "devDependencies": {
    "@alchemy.run/aws": "workspace:*",
    "@alchemy.run/docker": "workspace:*",
    "@distilled.cloud/aws": "workspace:*",
    "@types/bun": "catalog:",
    "alchemy": "workspace:*",
    "effect": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@alchemy.run/aws": "workspace:*",
    "@alchemy.run/docker": "workspace:*",
    "@distilled.cloud/aws": "workspace:*",
    "alchemy": "workspace:*",
    "effect": "catalog:"
  },
  "peerDependenciesMeta": {
    "@alchemy.run/aws": {
      "optional": true
    },
    "@alchemy.run/docker": {
      "optional": true
    },
    "@distilled.cloud/aws": {
      "optional": true
    }
  },
  "alchemy": {
    "contributes": [
      "@alchemy.run/convex/Contributions"
    ]
  }
}
