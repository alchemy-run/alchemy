{
  "name": "@alchemy.run/git-service",
  "version": "2.0.0-beta.70",
  "description": "Git hosting service on Cloudflare Workers, Durable Objects, and R2 — built with Alchemy Effect-native Workers.",
  "homepage": "https://alchemy.run",
  "license": "Apache-2.0",
  "author": "Sam Goodwin <sam@alchemy.run>",
  "keywords": [
    "alchemy",
    "git",
    "effect",
    "cloudflare",
    "infrastructure-as-code"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alchemy-run/alchemy.git",
    "directory": "packages/git-service"
  },
  "bugs": {
    "url": "https://github.com/alchemy-run/alchemy/issues"
  },
  "files": [
    "lib",
    "src"
  ],
  "scripts": {
    "build": "tsc -b && bun ../../scripts/copy-package-files.ts git-service",
    "test": "alchemy-test"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "bun": "./src/index.ts",
      "worker": "./src/index.ts",
      "import": "./lib/index.js"
    },
    "./*": {
      "types": "./lib/*.d.ts",
      "bun": "./src/*.ts",
      "worker": "./src/*.ts",
      "import": "./lib/*.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "alchemy": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@effect/platform-bun": "catalog:",
    "alchemy": "workspace:*",
    "alchemy-test": "workspace:*",
    "effect": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
