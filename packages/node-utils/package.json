{
  "name": "@alchemy.run/node-utils",
  "version": "2.0.0-beta.79",
  "description": "Runtime utilities for Alchemy packages.",
  "homepage": "https://alchemy.run",
  "author": "Sam Goodwin <sam@alchemy.run>",
  "keywords": [
    "alchemy",
    "gitignore",
    "node",
    "utilities"
  ],
  "bugs": {
    "url": "https://github.com/alchemy-run/alchemy/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alchemy-run/alchemy.git",
    "directory": "packages/node-utils"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "src",
    "lib",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_LICENSES.md"
  ],
  "scripts": {
    "build": "tsc -b && bun ../../scripts/copy-package-files.ts node-utils",
    "test": "bun test ./test"
  },
  "exports": {
    "./cached-function": {
      "types": "./lib/cached-function.d.ts",
      "bun": "./src/cached-function.ts",
      "import": "./lib/cached-function.js"
    },
    "./hash": {
      "types": "./lib/hash.d.ts",
      "bun": "./src/hash.ts",
      "import": "./lib/hash.js"
    },
    "./ignore": {
      "types": "./lib/ignore.d.ts",
      "bun": "./src/ignore.ts",
      "import": "./lib/ignore.js"
    },
    "./ignore-rules": {
      "types": "./lib/ignore-rules.d.ts",
      "bun": "./src/ignore-rules.ts",
      "import": "./lib/ignore-rules.js"
    },
    "./memo": {
      "types": "./lib/memo.d.ts",
      "bun": "./src/memo.ts",
      "import": "./lib/memo.js"
    },
    "./port": {
      "types": "./lib/port.d.ts",
      "bun": "./src/port.ts",
      "import": "./lib/port.js"
    },
    "./register-oxc": {
      "types": "./lib/register-oxc.d.ts",
      "bun": "./src/register-oxc.ts",
      "import": "./lib/register-oxc.js"
    },
    "./watch-import": {
      "types": "./lib/watch-import.d.ts",
      "bun": "./src/watch-import.ts",
      "import": "./lib/watch-import.js"
    },
    "./watch-import-bun": {
      "types": "./lib/watch-import-bun.d.ts",
      "bun": "./src/watch-import-bun.ts",
      "import": "./lib/watch-import-bun.js"
    }
  },
  "dependencies": {
    "chokidar": "catalog:",
    "rolldown": "catalog:",
    "tinyglobby": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:"
  },
  "peerDependenciesMeta": {
    "effect": {
      "optional": true
    }
  }
}
