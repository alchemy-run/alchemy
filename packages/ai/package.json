{
  "name": "@alchemy.run/ai",
  "version": "2.0.0-beta.83",
  "description": "Agent harnesses, sessions and sandboxes for Alchemy: drive Claude Code, Codex and OpenCode in a sandbox.",
  "keywords": [
    "agents",
    "ai",
    "alchemy",
    "effect",
    "harness",
    "sandbox"
  ],
  "homepage": "https://alchemy.run",
  "bugs": {
    "url": "https://github.com/alchemy-run/alchemy/issues"
  },
  "license": "Apache-2.0",
  "author": "Sam Goodwin <sam@alchemy.run>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alchemy-run/alchemy.git",
    "directory": "packages/ai"
  },
  "files": [
    "lib",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./OpenCode": "./src/OpenCode/index.ts",
    "./*": "./src/*.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "bun": "./src/index.ts",
        "worker": "./src/index.ts",
        "default": "./lib/index.js"
      },
      "./OpenCode": {
        "types": "./lib/OpenCode/index.d.ts",
        "bun": "./src/OpenCode/index.ts",
        "worker": "./src/OpenCode/index.ts",
        "default": "./lib/OpenCode/index.js"
      },
      "./*": {
        "types": "./lib/*.d.ts",
        "bun": "./src/*.ts",
        "worker": "./src/*.ts",
        "default": "./lib/*.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "pnpm -r --filter \"{.}...\" run build:package",
    "build:package": "node scripts/build.ts"
  },
  "dependencies": {
    "@distilled.cloud/acp": "workspace:*",
    "@distilled.cloud/codex": "workspace:*",
    "@distilled.cloud/core": "workspace:*"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.284",
    "@types/bun": "catalog:",
    "alchemy": "workspace:*",
    "effect": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.284",
    "alchemy": "workspace:*",
    "effect": "catalog:"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    }
  }
}
